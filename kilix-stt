# -- formatting ------------------------------------------------------------


def human_bytes(count: int) -> str:
    """Return a byte count as the size a download dialog would show."""
    size = float(count)
    for unit in ("B", "KiB", "MiB"):
        if size < 1024.0:
            if unit == "B":
                return f"{size:.0f} B"
            return f"{size:.1f} {unit}"
        size /= 1024.0
    return f"{size:.1f} GiB"


def tilde(path: str) -> str:
    """Return ``path`` with the home directory written as ``~``."""
    home = os.path.expanduser("~")
    if home and path == home:
        return "~"
    if home and path.startswith(home + os.sep):
        return "~" + path[len(home):]
    return path


def dbfs(level: float) -> float:
    """Return a normalised RMS as dB below full scale."""
    if level <= 0.0:
        return METER_FLOOR_DB
    return max(METER_FLOOR_DB, 20.0 * math.log10(level))


def shown_value(key: str, value: str) -> str:
    """Return a stored value as the screen says it, not as it is kept."""
    if key == settings.KEY_STT_PUNCTUATION:
        return "on" if settings.truthy(value) else "off"
    if key == settings.KEY_STT_MAX_SECONDS:
        return f"{value} s"
    if key == settings.KEY_STT_SILENCE_MS:
        return f"{value} ms"
    return value


def db_text(level: float) -> str:
    """Return a level as a fixed-width dB reading."""
    value = dbfs(level)
    if value <= METER_FLOOR_DB:
        return f"<{METER_FLOOR_DB:.0f} dB"
    return f"{value:6.1f} dB"


def frame_peak(frame: bytes) -> float:
    """Return the largest absolute sample in an s16le frame, normalised.

    RMS says how loud a frame is on average; the peak is what says the input is
    clipping, which is the failure that leaves recognition producing confident
    nonsense rather than nothing at all.
    """
    usable = len(frame) - (len(frame) % 2)
    if usable <= 0:
        return 0.0
    samples = array.array("h")
    samples.frombytes(frame[:usable])
    if sys.byteorder == "big":
        samples.byteswap()
    return max(abs(min(samples)), abs(max(samples))) / 32768.0


# -- diagnostics -----------------------------------------------------------


def _run_tool(argv: list[str]) -> str | None:
    """Run a short query command and return its stdout, or None if it failed.

    Only used to *ask* the sound server what exists; nothing here opens a
    device, and a machine with no sound server simply gets None.
    """
    try:
        finished = subprocess.run(
            argv, stdin=subprocess.DEVNULL, capture_output=True, text=True,
            timeout=PACTL_TIMEOUT_S, check=False,
            # C locale: the field names below are parsed, so they must not be
            # translated out from under us on a non-English desktop.
            env={**os.environ, "LC_ALL": "C"})
    except (OSError, subprocess.SubprocessError):
        return None
    return finished.stdout if finished.returncode == 0 else None


def pulse_state() -> PulseState:
    """Return the recording sources the sound server knows about."""
    listing = _run_tool(["pactl", "list", "sources", "short"])
    if listing is None:
        return PulseState((), "", (
            "cannot list sources: pactl is not installed or no sound server "
            "is running. Install pulseaudio-utils and check `pactl info`; "
            "without it only 'default' can be chosen, and arecord ignores the "
            "device setting altogether."))
    sources: list[Source] = []
    unusable = 0
    for line in listing.splitlines():
        fields = line.split("\t")
        if len(fields) < 2:
            continue
        name = fields[1].strip()
        if not _STORABLE_DEVICE.match(name):
            unusable += 1
            continue
        state = fields[4].strip().upper() if len(fields) >= 5 else ""
        sources.append(Source(name, name.endswith(".monitor"), state))
    default = ""
    info = _run_tool(["pactl", "info"])
    for line in (info or "").splitlines():
        label, sep, value = line.partition(":")
        if sep and label.strip() == "Default Source":
            default = value.strip()
    note = ""
    if not sources:
        note = ("the sound server reported no recording sources. Plug a "
                "microphone in, or check `pactl list sources short`.")
    elif unusable:
        note = (f"{unusable} source name(s) hold characters the shared "
                "settings file cannot store, so they are not offered here.")
    # Real inputs first: a machine's first source is often the monitor of its
    # speakers, and offering that ahead of the microphone is how somebody ends
    # up dictating what the machine is playing.
    ordered = sorted(sources, key=lambda source: source.monitor)
    return PulseState(tuple(ordered), default, note)


def daemon_status(timeout: float = DAEMON_TIMEOUT_S) -> dict | None:
    """Return the running daemon's status, or None when none answers.

    Worth asking before opening the microphone: the daemon owns the device for
    the session, and a test capture started underneath a live dictation turn
    would put two recorders on one microphone.
    """
    endpoint = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
    try:
        endpoint.settimeout(timeout)
        endpoint.connect(paths.control_socket())
        endpoint.send(protocol.encode({"op": protocol.OP_STATUS,
                                       "id": "kilix-stt",
                                       "v": protocol.PROTOCOL_VERSION}))
        reply = protocol.decode(endpoint.recv(MAX_STATUS_BYTES))
    except (OSError, protocol.ProtocolError):
        return None
    finally:
        endpoint.close()
    status = reply.get("status")
    return status if reply.get("ok") and isinstance(status, dict) else None


def model_dir(catalog_id: str) -> str:
    """Return where a catalog model lives, honouring the path override."""
    override = os.environ.get(stt_lib.ENV_MODEL)
    if override:
        return os.path.abspath(os.path.expanduser(override))
    return paths.model_dir(catalog_id)


def model_payload_present(spec: ModelSpec, directory: str | None = None) -> bool:
    """Return whether the files this model's engine needs are non-empty."""
    target = directory or paths.model_dir(spec.catalog_id)
    try:
        if not os.path.isdir(target):
            return False
        return all(
            os.path.isfile(os.path.join(target, relative))
            and os.path.getsize(os.path.join(target, relative)) > 0
            for relative in MODEL_REQUIRED_FILES[spec.engine]
        )
    except OSError:
        # Installation publishes paths atomically, but a concurrent repair or
        # manual removal can still race these two metadata probes.
        return False


def library_path() -> str:
    """Return the libvosk.so this machine would load."""
    candidate = os.environ.get(stt_lib.ENV_LIBRARY) or paths.libvosk_path()
    candidate = os.path.abspath(os.path.expanduser(candidate))
    if os.path.isdir(candidate):
        return os.path.join(candidate, stt_lib.LIBRARY_BASENAME)
    return candidate


class ModelInstallError(RuntimeError):
    """A requested model cannot be handed to Kilix's verified installer."""


def kilix_launcher() -> str:
    """Return the Kilix launcher that owns the pinned download closure."""
    candidates = []
    if home := os.environ.get("KILIX_HOME"):
        candidates.append(os.path.join(home, "kilix"))
    if installed := shutil.which("kilix"):
        candidates.append(installed)
    for candidate in candidates:
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    raise ModelInstallError(
        "the Kilix launcher could not be found. Run this through `kilix stt`, "
        "or set KILIX_HOME to the pinned Kilix checkout; kilix-stt will not "
        "invent an unverified download path.")


def model_install_argv(spec: ModelSpec) -> list[str]:
    """Return the one verified installer command for a catalog entry."""
    kilix = kilix_launcher()
    if spec.engine == stt_lib.ENGINE_VIBEVOICE:
        # Bonsai owns the file-level hashes and writes the exact directory the
        # voice catalog resolves, so there is one copy of these large weights.
        return [kilix, "bonsai", "pull", spec.catalog_id]
    return [kilix, "voice", "install", "--model", spec.catalog_id]


def install_command(spec: ModelSpec) -> str:
    """Return the stable user-facing lazy-install command."""
    return f"kilix stt --install {spec.catalog_id}"


def _check_licence(catalog_id: str) -> None:
    """Answer whether a receipt covers one model's weights, and fetch nothing.

    A fetcher that does not go through this tree -- Kilix's own
    scripts/install-kilix-voice.sh, which pleb reaches as `kilix voice install`
    -- cannot import this private package, but it can run one command and stop
    on its status. That is what this is: exit 0 when a receipt covers the
    model, exit 3 (LICENCE_REFUSED_EXIT) with the same refusal on stderr when
    none does. It starts no installer and writes nothing under the model store
    in either case, so it is safe to call before every fetch.
    """
    licensing.require_covering_receipt(catalog_id)
    print(f"{catalog_id}: a licence receipt in "
          f"{tilde(licensing.receipt_store_root())} covers these weights.")


def install_model(spec: ModelSpec, screen=None) -> int:
    """Run one explicit install, optionally lending it the curses terminal.

    A covering licence receipt is the precondition (OS-V-VERIFY F2, OD-S,
    OD-BB). It is checked before the launcher is even located, so a refusal
    starts no process, fetches nothing, and writes nothing under the model
    store. Raises licensing.LicenseRefused when no receipt covers the model.
    """
    licensing.require_covering_receipt(spec.catalog_id)
    argv = model_install_argv(spec)
    if screen is not None:
        curses.def_prog_mode()
        curses.endwin()
        print(f"\nInstalling {spec.catalog_id} ({human_bytes(spec.size)})…\n")
    try:
        status = subprocess.call(argv)
    except OSError as error:
        raise ModelInstallError(
            f"could not run the model installer: {error}") from error
    finally:
        if screen is not None:
            print("\nPress Enter to return to Kilix Voice… ", end="", flush=True)
            try:
                input()
            except (EOFError, KeyboardInterrupt):
                pass
            screen.refresh()
            curses.doupdate()
    return status


def capture_cfg(values: dict[str, str]) -> dict:
    """Return the audio config a test capture runs with.

    Built from the values on screen rather than from the file, so a device can
    be picked and tried before the change is saved.
    """
    return {
        "audio": {
            "rate": audio.DEFAULT_RATE,
            "frame_ms": audio.DEFAULT_FRAME_MS,
            "device_in": values[settings.KEY_DEVICE_IN],
        },
        "vad": {"silence_ms": int(values[settings.KEY_STT_SILENCE_MS])},
    }


def diagnose(values: dict[str, str]) -> Diagnostics:
    """Report what dictation has and what it is missing, launching nothing."""
    try:
        capture_ok, capture = True, " ".join(
            audio.build_capture_cmd(capture_cfg(values)))
    except audio.AudioError as error:
        capture_ok, capture = False, str(error)

    library = library_path()
    library_ok = os.path.isfile(library)
    model_id = values[settings.KEY_STT_MODEL]
    try:
        model = model_dir(model_id)
        spec = MODEL_BY_ID.get(model_id)
        model_ok = bool(spec and model_payload_present(spec, model))
    except paths.PathError as error:
        model, model_ok = str(error), False

    engine = values[settings.KEY_STT_ENGINE]
    note = ""
    if engine == stt_lib.ENGINE_OFF:
        note = (f"dictation is off ({settings.KEY_STT_ENGINE}=off): the "
                "microphone is never opened for it. Read-aloud is unaffected.")
    elif engine == stt_lib.ENGINE_VIBEVOICE:
        note = (f"{settings.KEY_STT_ENGINE}={stt_lib.ENGINE_VIBEVOICE} is not "
                "implemented in this release; it arrives in a later phase. "
                f"Set it to {stt_lib.ENGINE_VOSK} for local recognition now.")
    elif engine == stt_lib.ENGINE_VOSK:
        spec = MODEL_BY_ID.get(model_id)
        if spec is not None and spec.engine != stt_lib.ENGINE_VOSK:
            note = (f"{model_id} is a {spec.engine} model and vosk cannot "
                    "load it. Choose an English vosk model in the Models tab.")
    return Diagnostics(capture_ok, capture, library_ok, library, model_ok,
                       model, note)


# -- the microphone test ---------------------------------------------------


class MicTest:
    """A microphone check driven by the capture and VAD a real turn uses.

    It answers "why can't it hear me" with the detector's own numbers: the
    level of each frame, the noise floor the detector has learned, the gate a
    frame has to cross, and whether that gate ever opened.  Nothing is
    recognised and nothing is stored — the frames are measured and dropped —
    and the recorder is bounded by the same ceiling as a dictation turn so a
    forgotten test cannot leave the microphone open.
    """

    def __init__(self, cfg: dict, limit_s: float) -> None:
        self._cfg = cfg
        self._limit = max(1.0, float(limit_s))
        self._vad = Vad(cfg)
        self._capture: audio.MicCapture | None = None
        self._started = 0.0
        self._stopped = 0.0
        self._last_frame = 0.0
        self._peak_at = 0.0
        self._frames = 0
        self._dropped = 0
        self._silent = 0
        self._clipped = 0
        self._turns = 0
        self._level = 0.0
        self._peak = 0.0
        self._loudest = 0.0
        self._state = events.VAD_SILENCE
        self._error = ""
        self._reason = ""

    @property
    def running(self) -> bool:
        return self._capture is not None

    @property
    def level(self) -> float:
        return self._level

    @property
    def peak(self) -> float:
        return self._peak

    @property
    def floor(self) -> float:
        return self._vad.noise_floor

    @property
    def threshold(self) -> float:
        return self._vad.threshold

    @property
    def state(self) -> str:
        return self._state

    @property
    def speaking(self) -> bool:
        return self._state in (events.VAD_SPEECH_START, events.VAD_SPEECH)

    @property
    def frames(self) -> int:
        return self._frames

    @property
    def turns(self) -> int:
        """How often the detector opened: the number that proves it works."""
        return self._turns

    @property
    def clipped(self) -> int:
        return self._clipped

    @property
    def dropped(self) -> int:
        """Frames the meter never saw because a redraw fell behind."""
        capture = self._capture
        return capture.overruns if capture is not None else self._dropped

    @property
    def elapsed(self) -> float:
        if not self._started:
            return 0.0
        end = time.monotonic() if self.running else self._stopped
        return max(0.0, end - self._started)

    @property
    def limit(self) -> float:
        return self._limit

    def start(self) -> None:
        """Open the microphone. Raises AudioError saying what to install."""
        if self._capture is not None:
            return
        capture = audio.MicCapture(self._cfg)
        capture.start()
        now = time.monotonic()
        self._capture = capture
        self._started = self._last_frame = self._peak_at = now
        self._error = self._reason = ""

    def stop(self, reason: str = "", *, fault: bool = False) -> None:
        """Close the microphone, keeping the readings on screen.

        A fault is why the capture died; a reason is why it was ended. They
        are kept apart because only the first outranks what the capture
        managed to measure before it stopped.
        """
        capture, self._capture = self._capture, None
        if capture is not None:
            self._stopped = time.monotonic()
            self._dropped = capture.overruns
            capture.stop()
            if capture.error and not self._error:
                self._error = capture.error
        if reason:
            if fault and not self._error:
                self._error = reason
            elif not fault and not self._reason:
                self._reason = reason
        self._level = 0.0

    def poll(self) -> None:
        """Consume the frames that arrived since the last redraw."""
        capture = self._capture
        if capture is None:
            return
        for _ in range(POLL_FRAMES):
            # timeout=0 returns whatever is queued and never blocks, which is
            # what keeps the meter's redraw independent of the frame clock.
            frame = capture.read(timeout=0)
            if frame is None:
                break
            self._consume(frame)
        if capture.error:
            self.stop()
            return
        now = time.monotonic()
        if now - self._started >= self._limit:
            self.stop(f"The test stopped at the {self._limit:.0f} s ceiling "
                      f"({settings.KEY_STT_MAX_SECONDS}), as a dictation turn "
                      "would.")
        elif self._frames and now - self._last_frame > STALL_S:
            self.stop("the recorder stopped sending audio. The device was "
                      "unplugged, or another program took it.", fault=True)
        else:
            self._decay(now)

    def diagnosis(self) -> str:
        """Return why the capture ended, and what it proved before it did."""
        if self.running:
            return self._verdict()
        # A capture that ended still measured something on the way, and that
        # finding is often the answer even when the ending was unremarkable.
        ending = self._error or self._reason
        return " ".join(part for part in (ending, self._verdict()) if part)

    def _verdict(self) -> str:
        """Return the finding the readings support, or "" for none yet."""
        if not self._frames:
            if self.running and self.elapsed < 1.0:
                return ""
            return ("no audio arrived. The recorder ran but the source "
                    "produced nothing — check that no other program holds "
                    "the device, or choose another source.")
        if self._frames >= SILENT_FRAMES and self._silent == self._frames:
            return ("the source is sending digital silence: it is muted, or "
                    "it is not a microphone. Unmute it with `pactl "
                    "set-source-mute <source> 0`, or choose another device.")
        if self._clipped:
            return (f"{self._clipped} frames are clipping. The input gain is "
                    "too high, which garbles recognition — lower it with "
                    "`pactl set-source-volume <source> 90%`.")
        if self._turns:
            return (f"the detector opened {self._turns} time(s): this device "
                    "and these thresholds can hear you.")
        if self._loudest <= self._vad.threshold and (
                not self.running or self.elapsed > QUIET_S):
            return ("nothing has crossed the detector's gate. Speak up, move "
                    "closer, or raise the input volume — the loudest frame "
                    f"was {db_text(self._loudest).strip()} and the gate is at "
                    f"{db_text(self._vad.threshold).strip()}.")
        return ""

    def _consume(self, frame: bytes) -> None:
        self._frames += 1
        self._last_frame = time.monotonic()
        self._state = self._vad.feed(frame)
        self._level = self._vad.level
        peak = frame_peak(frame)
        self._peak = max(self._peak, peak)
        self._loudest = max(self._loudest, self._level)
        if peak >= CLIP_LEVEL:
            self._clipped += 1
        if peak < SILENT_LEVEL:
            self._silent += 1
        if self._state == events.VAD_SPEECH_START:
            self._turns += 1

    def _decay(self, now: float) -> None:
        """Let the peak fall back, so it tracks the room and not history."""
        span, self._peak_at = now - self._peak_at, now
        if span > 0:
            self._peak *= 0.5 ** (span / PEAK_HALFLIFE_S)
        self._peak = max(self._peak, self._level)


# -- command line ----------------------------------------------------------


def _normalised(key: str, raw: str) -> str:
    """Return a CLI value in the vocabulary the settings file stores."""
    text = raw.strip()
    if key == settings.KEY_STT_MAX_SECONDS:
        return text[:-1].strip() if text.lower().endswith("s") else text
    if key == settings.KEY_STT_SILENCE_MS:
        lowered = text.lower()
        if lowered.endswith("ms"):
            return lowered[:-2].strip()
        if lowered.endswith("s"):
            try:
                return str(int(round(float(lowered[:-1]) * 1000)))
            except ValueError:
                return text
    return text


def _parse_assignment(value: str) -> tuple[str, str]:
    """Parse one --set KEY=VALUE into a shared-settings assignment."""
    name, separator, raw = value.partition("=")
    if not separator:
        raise argparse.ArgumentTypeError(
            "expected KEY=VALUE, for example submit=confirm. Keys: "
            + ", ".join(sorted({control.key for control in CONTROLS})))
    key = CONTROL_ALIASES.get(name.strip().lower())
    if key is None:
        raise argparse.ArgumentTypeError(
            f"unknown setting {name.strip()!r}. Use one of: "
            + ", ".join(sorted(
                alias for alias in CONTROL_ALIASES if "_" not in alias)))
    text = _normalised(key, raw)
    if key == settings.KEY_STT_SUBMIT and text.lower() == "always":
        raise argparse.ArgumentTypeError(
            "there is no 'always' submit policy: dictation never presses "
            "Enter for you. Use never (leave the text on the command line) or "
            "confirm (ask first).")
    choices = settings.SPEC[key][1]
    if choices is not None and text.lower() not in choices:
        raise argparse.ArgumentTypeError(
            f"{key} must be one of: {', '.join(choices)} — got {text!r}.")
    return key, text


def _parse_section(value: str) -> int:
    section = SECTION_ALIASES.get(value.strip().lower())
    if section is None:
        raise argparse.ArgumentTypeError(
            "unknown tab; choose one of: "
            + ", ".join(name.lower() for name in SECTIONS))
    return section


def _print_report() -> None:
    """Print the effective dictation settings and what is missing."""
    values = {control.key: settings.value(control.key)
              for control in CONTROLS}
    report = diagnose(values)
    print(f"settings_file={paths.settings_file()}")
    for control in CONTROLS:
        print(f"{control.key}={values[control.key]}")
    print(f"capture={report.capture}")
    print(f"library={report.library}"
          f"{'' if report.library_ok else ' (missing)'}")
    print(f"model={report.model}{'' if report.model_ok else ' (missing)'}")
    status = daemon_status()
    print("daemon=" + (
        f"pid {status.get('pid')} listening={status.get('listening')}"
        if status else "not running"))
    print("dictation=" + ("ready" if report.ready else "degraded"))
    if report.ready:
        return
    # An engine that will not run makes the rest moot: reporting a missing
    # vosk library to somebody who switched dictation off is noise.
    reasons = [text for text, present in (
        (report.capture, report.capture_ok),
        (f"the vosk library is not at {report.library}", report.library_ok),
        (f"the model is not at {report.model}", report.model_ok),
    ) if not present]
    for reason in [report.engine_note] if report.engine_note else reasons:
        print(f"reason={reason}")


def _print_models() -> None:
    """Print the model catalog, one line per model."""
    active = settings.stt_model()
    for spec in MODELS:
        target = paths.model_dir(spec.catalog_id)
        installed = model_payload_present(spec, target)
        supported = spec.runtime_supported
        print(f"model={spec.catalog_id} engine={spec.engine} "
              f"size={spec.size} human={human_bytes(spec.size)} "
              f"installed={'yes' if installed else 'no'} "
              f"runtime_supported={'yes' if supported else 'no'} "
              f"selected={'yes' if spec.catalog_id == active else 'no'} "
              f"path={target}")
        if not installed:
            print(f"install={install_command(spec)}")


def _model_catalog_document() -> dict:
    """Return the versioned, download-free model-control document.

    This is the process boundary for desktop and shell consumers. It contains
    only local state and immutable catalog metadata; installation remains an
    explicit command supplied for each record.
    """
    active = settings.stt_model()
    records = []
    for spec in MODELS:
        target = paths.model_dir(spec.catalog_id)
        records.append({
            "id": spec.catalog_id,
            "engine": spec.engine,
            "download_bytes": spec.size,
            "download_size": human_bytes(spec.size),
            "installed": model_payload_present(spec, target),
            "runtime_supported": spec.runtime_supported,
            "selected": spec.catalog_id == active,
            "path": target,
            "install_and_default_argv": [
                "kilix", "stt", "--install", spec.catalog_id,
                "--default", spec.catalog_id,
            ],
            "summary": spec.summary,
            # C06: the published record now carries the device class. Adding
            # the field to an internal tuple did not put it on the wire, which
            # is what a consumer sizing hardware actually reads.
            "device_class": spec.device_class,
        })
        if spec.resource_profile is not None:
            # C12: only when MEASURED. An absent profile is honest about not
            # having been measured; an empty or invented one would certify the
            # opposite.
            records[-1]["resource_profile"] = spec.resource_profile
    return {
        "schema": model_catalog.CATALOG_SCHEMA,
        "default_model": active,
        "models": records,
    }


def _print_models_json() -> None:
    """Print the stable speech-model control document as one JSON value."""
    print(json.dumps(_model_catalog_document(), sort_keys=True))


# -- the screen ------------------------------------------------------------


class Layout(NamedTuple):
    """Which row each part of the screen gets, for one terminal size."""

    path_row: int
    tabs_row: int
    summary_row: int
    body_top: int
    body_rows: int
    detail_top: int
    detail_rows: int
    status_row: int
    help_row: int


def layout_for(height: int) -> Layout:
    """Return the body budget below the canonical four-row Kilix shell.

    Everything is derived from the height rather than assumed, because a Kilix
    pane is often eight rows tall and a settings screen that raises there is
    worse than one that shows less.
    """
    help_row = height - 1 if height > 0 else -1
    status_row = 3 if height >= 4 else -1
    if height >= 22:
        detail_rows = 4
    elif height >= 18:
        detail_rows = 3
    elif height >= 15:
        detail_rows = 2
    elif height >= 12:
        detail_rows = 1
    else:
        detail_rows = 0
    body_top = 4
    body_bottom = max(body_top, height - 1)
    detail_rows = min(detail_rows, max(0, body_bottom - body_top))
    detail_top = body_bottom - detail_rows
    return Layout(-1, 1, 3, body_top,
                  max(0, detail_top - body_top), detail_top, detail_rows,
                  status_row, help_row)


def glyphs_for_terminal() -> Glyphs:
    """Return drawing characters this terminal's encoding can carry.

    The C library's codeset decides, not Python's preferred encoding: under
    ``LC_ALL=C`` the interpreter still reports UTF-8 for its own streams, while
    ncurses — which encodes everything drawn here — is in single-byte mode and
    would turn a meter made of block characters into mojibake.  Call this after
    ``setlocale``, or it reports the locale the process started with.
    """
    try:
        codeset = locale.nl_langinfo(locale.CODESET)
    except (AttributeError, ValueError):
        codeset = locale.getpreferredencoding(False)
    return UNICODE_GLYPHS if "utf" in (codeset or "").lower() else ASCII_GLYPHS


class Ui:
    """Three tabs over one set of pending changes to the shared settings."""

    def __init__(self, screen, section: int, glyphs: Glyphs) -> None:
        self._screen = screen
        self._glyphs = glyphs
        self._section = section
        self._values = {control.key: self._initial(control.key)
                        for control in CONTROLS}
        self._original = dict(self._values)
        self._selected = [0] * len(SECTIONS)
        self._message = ""
        self._discard_armed = False
        self._pulse = pulse_state()
        self._daemon = daemon_status()
        self._diagnostics = diagnose(self._values)
        self._mic: MicTest | None = None

    # -- state --------------------------------------------------------------

    @staticmethod
    def _initial(key: str) -> str:
        """Return the stored value in the vocabulary the controls cycle."""
        raw = settings.value(key)
        if key in settings.BOOL_KEYS:
            return "1" if settings.truthy(raw) else "0"
        return raw

    @property
    def _live(self) -> bool:
        return self._mic is not None and self._mic.running

    @property
    def _dirty(self) -> int:
        return sum(1 for key, value in self._values.items()
                   if self._original[key] != value)

    def _items(self) -> int:
        if self._section == SECTION_DICTATION:
            return len(CONTROLS)
        if self._section == SECTION_MODELS:
            return len(MODELS)
        return 0

    def _choices(self, control: Control) -> tuple[str, ...]:
        """Return the vocabulary one control cycles through."""
        if control.key == settings.KEY_DEVICE_IN:
            current = self._values[control.key]
            names = ["default"]
            names += [source.name for source in self._pulse.sources
                      if source.name != "default"]
            if current not in names:
                # A device chosen on another machine, or before its source
                # disappeared, stays reachable rather than being cycled away
                # from and then impossible to get back to.
                names.insert(1, current)
            return tuple(names)
        return control.choices or settings.SPEC[control.key][1] or ()

    def _fit(self, text: str, width: int, *, tail: bool = False) -> str:
        """Trim ``text`` to ``width``, from the front when ``tail`` is set.

        Device names are trimmed from the front: they share long prefixes and
        differ in the last field, which is the part worth showing.
        """
        if width <= 0 or len(text) <= width:
            return text
        mark = self._glyphs.ellipsis
        keep = max(1, width - len(mark))
        return mark + text[-keep:] if tail else text[:keep] + mark

    # -- drawing ------------------------------------------------------------

    def _put(self, row: int, col: int, text: str,
             attr: int = curses.A_NORMAL) -> None:
        """Draw one line, clipped to the window.

        A terminal too small for what is being drawn is not an error here: the
        line is cut, or dropped, and the screen still comes up.
        """
        height, width = self._screen.getmaxyx()
        if row < 0 or row >= height or col < 0 or col >= width - 1:
            return
        try:
            self._screen.addnstr(row, col, text, width - col - 1, attr)
        except (curses.error, UnicodeEncodeError):
            pass

    def _draw(self) -> None:
        self._screen.erase()
        height, width = self._screen.getmaxyx()
        rows = layout_for(height)
        dirty = self._dirty
        summary = self._message or self._summary()
        if dirty:
            summary += (
                f" {self._glyphs.dot} {dirty} unsaved "
                f"change{'s' if dirty != 1 else ''}"
            )
        tui_shell.draw(
            self._screen,
            title="Kilix Voice · Dictation",
            sections=SECTIONS,
            active=self._section,
            summary=summary,
            footer=self._footer_text(),
            summary_role="accent" if self._message or dirty else "muted",
        )
        if self._section == SECTION_DICTATION:
            self._draw_controls(rows, width)
        elif self._section == SECTION_MICROPHONE:
            self._draw_microphone(rows, width)
        else:
            self._draw_models(rows, width)
        self._draw_detail(rows)
        self._screen.refresh()

    def _summary(self) -> str:
        report = self._diagnostics
        dot = self._glyphs.dot
        model = self._values[settings.KEY_STT_MODEL]
        recorder = (report.capture.split()[0] if report.capture_ok
                    else "missing")
        parts = [
            "ready" if report.ready else "degraded",
            self._values[settings.KEY_STT_ENGINE],
            f"{model} ({'installed' if report.model_ok else 'not installed'})",
            f"library {'ok' if report.library_ok else 'missing'}",
            # The recorder is named rather than blessed: whether it can open
            # the device is what the Microphone tab is for.
            f"recorder {recorder}",
        ]
        return "Dictation: " + f" {dot} ".join(parts)

    def _draw_rows(self, rows: Layout, lines: list[tuple[str, int]],
                   selected: int = -1) -> None:
        """Draw a scrolled list inside the body area."""
        scroll = min(max(0, selected - rows.body_rows + 1),
                     max(0, len(lines) - rows.body_rows))
        for offset, (text, attr) in enumerate(
                lines[scroll:scroll + rows.body_rows]):
            self._put(rows.body_top + offset, 1, text, attr)

    def _draw_controls(self, rows: Layout, width: int) -> None:
        selected = self._selected[SECTION_DICTATION]
        lines = []
        for index, control in enumerate(CONTROLS):
            shown = self._fit(
                shown_value(control.key, self._values[control.key]), 18,
                tail=control.key == settings.KEY_DEVICE_IN)
            marker = "▶" if index == selected else " "
            line = f"{marker} [{shown:^18}] {control.label}"
            attr = (tui_shell.attr("selected")
                    if index == selected else curses.A_NORMAL)
            lines.append((line.ljust(max(0, width - 2)), attr))
        self._draw_rows(rows, lines, selected)

    def _draw_models(self, rows: Layout, width: int) -> None:
        selected = self._selected[SECTION_MODELS]
        active = self._values[settings.KEY_STT_MODEL]
        lines = []
        for index, spec in enumerate(MODELS):
            installed = model_payload_present(spec)
            marker = "▶" if index == selected else " "
            line = (f"{marker} "
                    f"[{'x' if spec.catalog_id == active else ' '}] "
                    f"{spec.catalog_id:<21} {spec.engine:<10} "
                    f"{human_bytes(spec.size):>9}  "
                    f"{'installed' if installed else 'not installed'}")
            attr = (tui_shell.attr("selected")
                    if index == selected else curses.A_NORMAL)
            lines.append((line.ljust(max(0, width - 2)), attr))
        self._draw_rows(rows, lines, selected)

    def _draw_microphone(self, rows: Layout, width: int) -> None:
        report = self._diagnostics
        mic = self._mic
        speaking = tui_shell.attr(
            "accent" if mic and mic.speaking else "muted")
        device = self._values[settings.KEY_DEVICE_IN]
        header = [(f"Source   {device}", curses.A_NORMAL)]
        note = self._device_note(device)
        if note:
            header.append((f"         {note}", tui_shell.attr("muted")))
        header.append((f"Capture  {report.capture}",
                       curses.A_NORMAL if report.capture_ok
                       else tui_shell.attr("alert")))
        header.append(
            (f"Owner    {self._daemon_line()}", tui_shell.attr("muted")))

        bar_width = max(8, min(48, width - 28))
        level = mic.level if mic else 0.0
        gate = mic.threshold if mic else 0.0
        state = "idle" if mic is None else _STATE_LABELS.get(mic.state,
                                                             mic.state)
        dot = self._glyphs.dot
        meter = [
            (f"[{self._bar(bar_width, level, gate)}] {db_text(level)}",
             tui_shell.attr("accent")
             if mic and mic.speaking else curses.A_NORMAL),
            (f"state {state:<8} gate {db_text(gate)}   "
             f"floor {db_text(mic.floor if mic else 0.0)}   "
             f"peak {db_text(mic.peak if mic else 0.0)}", speaking),
            ((f"frames {mic.frames} {dot} dropped {mic.dropped} {dot} "
              f"clipped {mic.clipped} {dot} opened {mic.turns} {dot} "
              f"{mic.elapsed:.1f} s of {mic.limit:.0f} s") if mic else
             "no capture yet: Space opens the microphone for a test. Nothing "
             "is recognised or recorded.", tui_shell.attr("muted")),
        ]
        # The meter is the reason for this tab, so a short pane loses the
        # context lines above it rather than the readings themselves.
        while header and len(header) + len(meter) + 1 > rows.body_rows:
            header.pop()
        lines = (header + [("", curses.A_NORMAL)] + meter) if header else meter
        self._draw_rows(rows, lines)

    def _bar(self, width: int, level: float, gate: float) -> str:
        """Return the level meter, with the detector's gate marked on it."""
        def cell(value: float) -> int:
            span = 0.0 - METER_FLOOR_DB
            return int(round(width * max(0.0, dbfs(value) - METER_FLOOR_DB)
                             / span))

        filled = min(width, cell(level))
        cells = [self._glyphs.full] * filled
        cells += [self._glyphs.empty] * (width - filled)
        marker = cell(gate)
        if 0 <= marker < width:
            cells[marker] = self._glyphs.gate
        return "".join(cells)

    def _source_state(self, name: str) -> str:
        """Return the server's state word for ``name``, or ""."""
        for source in self._pulse.sources:
            if source.name == name:
                return source.state
        return ""

    def _device_note(self, device: str) -> str:
        """Return the warning a source deserves, or ""."""
        if self._pulse.note:
            return self._pulse.note
        name = self._pulse.default if device == "default" else device
        if name.endswith(".monitor"):
            return (f"{name} is a monitor: it records what the speakers are "
                    "playing, not what you say. Choose a real input.")
        if self._source_state(name) == "SUSPENDED":
            # The idle-input steady state, not a fault — but it is the truth
            # behind a meter that opens on this source and stays at silence,
            # so it belongs on screen instead of an unexplained flat bar.
            return (f"{name} is suspended (asleep because nothing records "
                    "from it). The test wakes it; a meter that stays at "
                    "silence means it did not wake — press r to rescan.")
        if device == "default" and name:
            return f"the system default is {name}"
        return ""

    def _daemon_line(self) -> str:
        status = self._daemon
        if status is None:
            return ("kilix-voiced is not running; this test opens the "
                    "microphone directly.")
        return (f"kilix-voiced pid {status.get('pid')} "
                f"{'is dictating' if status.get('listening') else 'is idle'}")

    def _detail_lines(self) -> list[str]:
        """Return the explanation for whatever is selected."""
        if self._section == SECTION_DICTATION:
            control = CONTROLS[self._selected[SECTION_DICTATION]]
            lines = [control.detail]
            if control.key == settings.KEY_DEVICE_IN:
                value = self._values[control.key]
                lines.append(self._device_note(value) or f"current: {value}")
            elif control.key == settings.KEY_STT_MODEL:
                spec = MODEL_BY_ID.get(self._values[control.key])
                lines.append(self._model_line(spec) if spec else
                             "this model is not in the catalog below.")
            elif self._diagnostics.engine_note:
                lines.append(self._diagnostics.engine_note)
            return lines
        if self._section == SECTION_MODELS:
            # What to do about this model first: on a short screen the prose
            # is what drops off, not the command that installs it.
            spec = MODELS[self._selected[SECTION_MODELS]]
            return [self._model_line(spec), self._install_line(spec),
                    f"{spec.catalog_id}: {spec.summary}"]
        mic = self._mic
        return [(mic.diagnosis() if mic else "") or
                ("listening: speak normally" if self._live else
                 "Space opens the microphone for a test capture. It is only "
                 "measured — nothing is recognised, stored, or sent."),
                self._diagnostics.engine_note or
                ("" if self._diagnostics.capture_ok
                 else self._diagnostics.capture)]

    def _model_line(self, spec: ModelSpec) -> str:
        target = paths.model_dir(spec.catalog_id)
        if model_payload_present(spec, target):
            return f"installed at {tilde(target)}"
        override = os.environ.get(stt_lib.ENV_MODEL)
        if override:
            return (f"{stt_lib.ENV_MODEL} overrides the catalog: "
                    f"{tilde(override)} is used whatever is selected here")
        return f"not installed ({human_bytes(spec.size)}) — belongs in " \
               f"{tilde(target)}"

    def _install_line(self, spec: ModelSpec) -> str:
        if spec.engine == stt_lib.ENGINE_VIBEVOICE:
            if model_payload_present(spec):
                return ("weights installed; this voice runtime cannot run "
                        "VibeVoice yet (Kilix Bonsai can transcribe with it).")
            return (f"i installs the shared Bonsai weights; this voice runtime "
                    "cannot run them yet.")
        if model_payload_present(spec):
            return f"or point {stt_lib.ENV_MODEL} at another copy."
        return f"i installs it now · CLI: {install_command(spec)}"

    def _draw_detail(self, rows: Layout) -> None:
        """Explain what is selected, wrapped rather than cut off.

        These lines carry the failure messages and the install command, which
        are the two things worth reading in full, so they are folded into the
        rows available instead of running off the right edge.
        """
        if rows.detail_rows <= 0:
            return
        width = max(20, self._screen.getmaxyx()[1] - 6)
        folded: list[str] = []
        for line in self._detail_lines():
            folded.extend(textwrap.wrap(line, width) if line else [""])
            if len(folded) >= rows.detail_rows:
                break
        for offset, line in enumerate(folded[:rows.detail_rows]):
            self._put(
                rows.detail_top + offset,
                2,
                line,
                tui_shell.attr("muted"),
            )

    def _footer_text(self) -> str:
        """Return the one quiet footer used by the shared shell."""
        glyphs = self._glyphs
        if self._section == SECTION_MICROPHONE:
            action = "stop" if self._live else "start"
            help_text = (f"{glyphs.left}/{glyphs.right} tab {glyphs.dot} "
                         f"Space {action} the microphone test {glyphs.dot} "
                         f"r rescan {glyphs.dot} q quit")
        elif self._section == SECTION_MODELS:
            help_text = (f"{glyphs.left}/{glyphs.right} tab {glyphs.dot} "
                         f"{glyphs.up}/{glyphs.down} move {glyphs.dot} Enter "
                         f"make default {glyphs.dot} i install {glyphs.dot} "
                         f"s save {glyphs.dot} "
                         "q quit")
        else:
            help_text = (f"{glyphs.left}/{glyphs.right} tab {glyphs.dot} "
                         f"{glyphs.up}/{glyphs.down} move {glyphs.dot} Space "
                         f"change {glyphs.dot} Backspace back {glyphs.dot} "
                         f"s save {glyphs.dot} r rescan {glyphs.dot} q quit")
        return help_text

    # -- actions ------------------------------------------------------------

    def _set_value(self, key: str, value: str) -> None:
        """Change one pending value and re-read what it affects."""
        if self._values[key] == value:
            return
        self._values[key] = value
        self._diagnostics = diagnose(self._values)
        if self._live:
            self._mic.stop("The settings changed; press Space to test them.")

    def _cycle(self, step: int) -> None:
        control = CONTROLS[self._selected[SECTION_DICTATION]]
        choices = self._choices(control)
        if not choices:
            self._message = (
                f"{control.key} has nothing to choose from here. Set it with "
                f"kilix-stt --set {control.key.lower()}=VALUE.")
            return
        current = self._values[control.key]
        index = choices.index(current) if current in choices else -step
        self._set_value(control.key, choices[(index + step) % len(choices)])

    def _use_model(self) -> None:
        spec = MODELS[self._selected[SECTION_MODELS]]
        self._set_value(settings.KEY_STT_MODEL, spec.catalog_id)
        self._set_value(settings.KEY_STT_ENGINE, spec.engine)
        if not model_payload_present(spec):
            self._message = (f"{spec.catalog_id} is the pending default but is "
                             "not installed — press i to install it, then s to "
                             "save.")
        elif spec.engine == stt_lib.ENGINE_VIBEVOICE:
            self._message = (f"{spec.catalog_id} is the pending default. Its "
                             "weights are installed, but this voice runtime "
                             "cannot run VibeVoice yet; s still saves the choice.")
        else:
            self._message = (f"{spec.catalog_id} and {spec.engine} are the "
                             "pending defaults; press s to save.")

    def _install_model(self) -> None:
        spec = MODELS[self._selected[SECTION_MODELS]]
        try:
            status = install_model(spec, self._screen)
        except (licensing.LicenseRefused, ModelInstallError) as error:
            self._message = str(error)
            return
        self._rescan()
        if status == 0 and model_payload_present(spec):
            self._message = (f"Installed or verified {spec.catalog_id}. Enter "
                             "makes it the default; s saves.")
        elif status == 0:
            self._message = (f"The installer completed, but {spec.catalog_id} "
                             "is not visible at {tilde(paths.model_dir(spec.catalog_id))}.")
        else:
            self._message = f"The {spec.catalog_id} installer exited {status}."

    def _save(self) -> None:
        changes = {key: value for key, value in self._values.items()
                   if self._original[key] != value}
        if not changes:
            self._message = "No changes to save."
            return
        try:
            target = settings.update(changes)
        except settings.SettingsError as error:
            self._message = f"Could not save: {error}"
            return
        self._original = dict(self._values)
        self._diagnostics = diagnose(self._values)
        self._message = (f"Saved to {tilde(target)}. The daemon re-reads the "
                         "settings before the next turn.")

    def _rescan(self) -> None:
        self._pulse = pulse_state()
        self._daemon = daemon_status()
        self._diagnostics = diagnose(self._values)
        count = len(self._pulse.sources)
        self._message = (f"Rescanned: {count} source(s) offered."
                         if count else self._pulse.note or "Rescanned.")

    def _toggle_capture(self) -> None:
        if self._live:
            self._mic.stop("The test was stopped.")
            self._message = "Microphone closed."
            return
        # Asked again here rather than trusted from startup: the daemon may
        # have taken the microphone for a dictation turn in the meantime, and
        # this is the moment that decision matters. The source scan too — the
        # note over the meter must describe the source the test is opening,
        # not the one seen when the screen was drawn first.
        self._pulse = pulse_state()
        self._daemon = daemon_status()
        if self._daemon is not None and self._daemon.get("listening"):
            self._message = ("kilix-voiced is dictating right now. Stop that "
                             "turn first; one owner at a time holds the "
                             "microphone.")
            return
        mic = MicTest(capture_cfg(self._values),
                      float(self._values[settings.KEY_STT_MAX_SECONDS]))
        try:
            mic.start()
        except audio.AudioError as error:
            self._message = str(error)
            return
        self._mic = mic
        self._message = ""

    def _stop_capture(self) -> None:
        if self._mic is not None:
            self._mic.stop()

    # -- main loop ----------------------------------------------------------

    def run(self) -> int:
        try:
            while True:
                if self._mic is not None:
                    self._mic.poll()
                self._draw()
                self._screen.timeout(TICK_MS if self._live else -1)
                key = self._screen.getch()
                if key == -1:      # the meter's clock, not a keystroke
                    continue
                outcome = self._handle(key)
                if outcome is not None:
                    return outcome
        finally:
            self._stop_capture()

    def _handle(self, key: int) -> int | None:
        """Act on one keystroke; return an exit code to leave the screen."""
        self._message = ""
        if key not in (ord("q"), ord("Q"), 27):
            self._discard_armed = False
        items = self._items()
        selected = self._selected[self._section]

        if key in (curses.KEY_UP, ord("k"), ord("K")) and items:
            self._selected[self._section] = (selected - 1) % items
        elif key in (curses.KEY_DOWN, ord("j"), ord("J")) and items:
            self._selected[self._section] = (selected + 1) % items
        elif key == curses.KEY_HOME and items:
            self._selected[self._section] = 0
        elif key == curses.KEY_END and items:
            self._selected[self._section] = items - 1
        elif key in (curses.KEY_LEFT, ord("h"), ord("H"),
                     getattr(curses, "KEY_BTAB", -1)):
            self._go_to((self._section - 1) % len(SECTIONS))
        elif key in (curses.KEY_RIGHT, ord("l"), ord("L"), ord("\t")):
            self._go_to((self._section + 1) % len(SECTIONS))
        elif ord("1") <= key <= ord(str(len(SECTIONS))):
            self._go_to(key - ord("1"))
        elif key in (ord(" "), curses.KEY_ENTER, 10, 13):
            if self._section == SECTION_MICROPHONE:
                self._toggle_capture()
            elif self._section == SECTION_MODELS:
                self._use_model()
            else:
                self._cycle(1)
        elif key in (curses.KEY_BACKSPACE, 127, 8):
            if self._section == SECTION_DICTATION:
                self._cycle(-1)
        elif key in (ord("s"), ord("S")):
            self._save()
        elif key in (ord("i"), ord("I")):
            if self._section == SECTION_MODELS:
                self._install_model()
        elif key in (ord("r"), ord("R")):
            self._rescan()
        elif key in (ord("q"), ord("Q"), 27):
            if self._dirty and not self._discard_armed:
                self._message = "Unsaved changes: s saves; q again discards."
                self._discard_armed = True
                return None
            return 0
        return None

    def _go_to(self, section: int) -> None:
        """Switch tabs, closing the microphone on the way out of the meter."""
        if section != self._section and self._live:
            self._mic.stop("The test closed when you left the Microphone tab.")
        self._section = section


def _run_tui(screen, section: int, glyphs: Glyphs) -> int:
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    screen.keypad(True)
    return Ui(screen, section, glyphs).run()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="kilix-stt",
        description="Configure Kilix dictation and test the microphone.")
    parser.add_argument("--print", action="store_true", dest="show",
                        help="print the effective dictation settings and what "
                             "is missing")
    parser.add_argument("--models", action="store_true",
                        help="print the speech-model catalog")
    parser.add_argument("--grant-consent", action="store_true",
                        help="record consent to capture with the selected "
                             "model")
    parser.add_argument("--revoke-consent", action="store_true",
                        help="withdraw dictation capture consent")
    parser.add_argument("--config", metavar="PATH", default=None,
                        help="with --grant-consent, the JSON overrides the "
                             "daemon runs with, so consent covers the model it "
                             f"will open (default: ${daemon_config.ENV_CONFIG})")
    parser.add_argument("--json", action="store_true",
                        help="with --models, emit the versioned machine-readable "
                             "catalog contract")
    parser.add_argument("--install", choices=tuple(MODEL_BY_ID),
                        metavar="MODEL",
                        help="install one model through Kilix's verified lazy "
                             "installer")
    parser.add_argument("--check-licence", choices=tuple(MODEL_BY_ID),
                        dest="check_licence", metavar="MODEL",
                        help="exit 0 if a licence receipt covers one model's "
                             "weights, 3 if none does; fetches nothing either "
                             "way, so a fetcher outside this tree can gate "
                             "itself on it")
    parser.add_argument("--default", choices=tuple(MODEL_BY_ID),
                        dest="default_model", metavar="MODEL",
                        help="make one model and its matching engine the default")
    parser.add_argument("--set", action="append", default=[], dest="changes",
                        type=_parse_assignment, metavar="KEY=VALUE",
                        help="set one setting, for example submit=confirm "
                             "(repeatable)")
    parser.add_argument("--section", type=_parse_section,
                        metavar="|".join(name.lower() for name in SECTIONS),
                        help="open the interactive screen on this tab")
    parser.add_argument("--version", action="version",
                        version=f"kilix-stt {__version__}")
    args = parser.parse_args(argv)

    if args.json and not args.models:
        parser.error("--json requires --models")

    changes = dict(args.changes)
    try:
        if args.check_licence:
            _check_licence(args.check_licence)
            return 0
        if args.install:
            status = install_model(MODEL_BY_ID[args.install])
            if status != 0:
                return status
        if args.default_model:
            spec = MODEL_BY_ID[args.default_model]
            changes.update({
                settings.KEY_STT_MODEL: spec.catalog_id,
                settings.KEY_STT_ENGINE: spec.engine,
            })
        if changes:
            settings.update(changes)
        if args.show:
            _print_report()
        if args.grant_consent or args.revoke_consent:
            _consent_command(args)
            return 0
        if args.models:
            _print_models_json() if args.json else _print_models()
    except licensing.LicenseRefused as error:
        # Its own status: an unattended caller has to be able to tell "a human
        # must accept a licence" from "the installer broke", which is exit 1.
        parser.exit(licensing.LICENCE_REFUSED_EXIT, f"kilix-stt: {error}\n")
    except (ModelInstallError, settings.SettingsError, paths.PathError,
            daemon_config.ConfigError, stt_lib.SttError, OSError) as error:
        parser.exit(1, f"kilix-stt: {error}\n")
    if (changes or args.install or args.show or args.models
            or args.grant_consent or args.revoke_consent or args.check_licence):
        return 0

    if not sys.stdin.isatty() or not sys.stdout.isatty():
        parser.error("the interactive screen needs a terminal; use --print, "
                     "--models, --install MODEL, --default MODEL, or --set "
                     "KEY=VALUE")
    try:
        # curses encodes what it draws with the locale's encoding, so the
        # locale has to be adopted from the environment before initscr.
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    try:
        return curses.wrapper(_run_tui, args.section or 0,
                              glyphs_for_terminal())
    except curses.error as error:
        print(f"kilix-stt: this terminal will not run the settings screen "
              f"({error}). Use --print, --models, --install MODEL, --default "
              "MODEL, or --set KEY=VALUE instead.",
              file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        # The screen is already restored by the wrapper, and run()'s finally
        # has closed the microphone; nothing is left to say.
        return 0


def _consent_command(args) -> None:
    """Record or withdraw dictation capture consent for this configuration.

    R6 finding 7: this hashed the catalogue model directory while the daemon's
    gate hashes the directory the recogniser opens, which honours
    KILIX_VOICE_MODEL_PATH and stt.model_path from the daemon's --config file.
    Under either override the grant could never satisfy the gate, and the
    gate's refusal told the user to run this very command. The configuration
    is now resolved exactly as the daemon resolves it, and the identity comes
    from the same function the gate calls.
    """
    if args.revoke_consent:
        # Withdrawing consent needs no model, and must work even when the
        # configuration it would resolve is broken.
        removed = model_consent.revoke("dictation")
        print("dictation consent withdrawn." if removed
              else "no dictation consent was recorded.")
        return
    path = (getattr(args, "config", None)
            or os.environ.get(daemon_config.ENV_CONFIG))
    overrides = daemon_config.load_overrides(path) if path else {}
    resolved = stt_lib.resolve_stt(daemon_config.effective_config(overrides))
    identity = stt_lib.consent_identity(resolved)
    model_consent.grant("dictation", identity.digest,
                        model_id=identity.model_id,
                        model_revision=identity.payload_digest)
    print(f"dictation consent recorded for model {identity.model_id!r} "
          f"(engine {identity.engine!r}, directory {identity.model_dir!r}).")
    print("Changing the model, or the installed payload beneath it, asks again.")


if __name__ == "__main__":
    sys.exit(main())
