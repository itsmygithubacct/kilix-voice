METER_FLOOR_DB = -60.0       # bottom of the level meter's scale
CLIP_LEVEL = 0.995           # a sample this close to full scale is clipped
PEAK_HALFLIFE_S = 1.2        # how fast the peak reading falls back
SILENT_LEVEL = 0.0005        # below this a frame is digital silence
STALL_S = 2.0                # frames stopped arriving from a live recorder
QUIET_S = 3.0                # how long to wait before calling a room too quiet
SILENT_FRAMES = 100          # ~2 s at 20 ms before "muted" is a fair verdict

PACTL_TIMEOUT_S = 2.0
DAEMON_TIMEOUT_S = 1.5
MAX_STATUS_BYTES = 1 << 16

TICK_MS = 60                 # redraw cadence while the meter is live
POLL_FRAMES = 128            # frames drained per redraw: ~2.5 s of audio

# Device tokens are argv for parec and are stored in a shared file, so a source
# whose name the settings vocabulary cannot hold is left out of the picker
