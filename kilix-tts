class Field(NamedTuple):
    """One editable setting: which shared key it is, and how it is changed."""

    key: str
    label: str
    kind: str
    limit: int = 0          # TOKEN fields: the longest value worth typing


class Action(NamedTuple):
    """One thing the Test section can do. Actions edit nothing."""

    key: str
    label: str


class Section(NamedTuple):
    """One tab: its items, and the one-line summary drawn above them."""

    name: str
    items: tuple[Field | Action, ...]
    summary: Callable[[dict], str]


def _read_aloud_summary(values: dict) -> str:
    button = "button on" if values[settings.KEY_SPEAK] else "button off"
    voice = (tts_lib.PIPER_VOICE
             if values[settings.KEY_TTS_ENGINE] == models.TTS_ENGINE_PIPER
             else values[settings.KEY_TTS_VOICE])
    return (f"Read-aloud: {button} · {values[settings.KEY_TTS_ENGINE]} · "
            f"{voice} · "
            f"{values[settings.KEY_TTS_RATE]} wpm")


def _reading_summary(values: dict) -> str:
    budget = values[settings.KEY_TTS_MAX_CHARS]
    limit = ("no character limit" if budget == "unlimited"
             else f"at most {budget} characters")
    return f"Reading: {values[settings.KEY_TTS_EXTENT]} · {limit}"


def _output_summary(values: dict) -> str:
    device = values[settings.KEY_DEVICE_OUT]
    return "Output: " + ("the system default sink"
                         if device == "default" else device)


def _test_summary(_values: dict) -> str:
    return "Test: Enter runs the selected action, through kilix-voiced"


