_ALIASES: dict[str, tuple[str, ...]] = {
    settings.KEY_SPEAK: ("speak", "chrome_speak", "button", "speak_button"),
    settings.KEY_TTS_ENGINE: ("engine", "tts_engine", "tts"),
    settings.KEY_TTS_VOICE: ("voice", "tts_voice"),
    settings.KEY_TTS_RATE: ("rate", "tts_rate", "wpm", "speed"),
    settings.KEY_TTS_EXTENT: ("extent", "tts_extent", "read", "read_extent"),
    settings.KEY_TTS_MAX_CHARS: ("max_chars", "tts_max_chars", "chars",
                                 "budget"),
    settings.KEY_DEVICE_OUT: ("device_out", "output", "out", "sink", "device"),
}

# Friendlier spellings for the fixed vocabularies, so a caller who writes what
# the setting means gets what it is called rather than an error.
_SPELLINGS: dict[str, dict[str, str]] = {
    settings.KEY_TTS_ENGINE: {"espeak-ng": "espeak", "ng": "espeak",
                              "mb": "mbrola", "neural": "piper",
                              "kristin": "piper", "none": "off",
                              "silent": "off"},
    settings.KEY_TTS_EXTENT: {"visible": "screen", "pane": "screen",
                              "history": "scrollback", "buffer": "scrollback",
                              "sel": "selection"},
    settings.KEY_TTS_MAX_CHARS: {"none": "unlimited", "off": "unlimited",
                                 "all": "unlimited", "everything": "unlimited"},
}

CONTROL_NAMES = {alias: key for key, aliases in _ALIASES.items()
                 for alias in (key.lower(), *aliases)}


def _name_list() -> str:
    return ", ".join(sorted(name for name in CONTROL_NAMES
                            if not name.startswith("kilix_")))


def _canonical(key: str, text: str) -> str:
    """Return the vocabulary spelling of a value written by hand."""
    if key == settings.KEY_TTS_RATE:
        text = text.removesuffix("wpm").strip()
    elif key == settings.KEY_TTS_MAX_CHARS:
        text = text.removesuffix("characters").removesuffix("chars").strip()
        if text.endswith("k") and text[:-1].isdigit():
            text = str(int(text[:-1]) * 1000)
    return _SPELLINGS.get(key, {}).get(text, text)


def _parse_value(key: str, raw: str) -> object:
    text = raw.strip()
    if key in settings.BOOL_KEYS:
        if text.lower() in _ON_WORDS:
            return True
        if text.lower() in _OFF_WORDS:
            return False
        raise argparse.ArgumentTypeError(
            f"{_short_name(key)} must be on or off (also accepted: "
            f"{', '.join(_ON_WORDS + _OFF_WORDS)}) — got {text!r}")
    choices = settings.SPEC[key][1]
    if choices is None:
        # A name, not a vocabulary: settings.update() holds it to the alphabet
        # the shared file accepts and says which one it broke.
        if not text:
            raise argparse.ArgumentTypeError(
                f"{_short_name(key)} needs a value; use 'default' for the "
                "system default")
        return text
    value = _canonical(key, text.lower())
    if value not in choices:
        raise argparse.ArgumentTypeError(
            f"{_short_name(key)} must be one of: {', '.join(choices)} — got "
            f"{text!r}")
    return value


def _parse_assignment(value: str) -> tuple[str, object]:
    try:
        name, raw = value.split("=", 1)
    except ValueError as error:
        raise argparse.ArgumentTypeError(
            f"expected NAME=VALUE, for example wpm=200; names: {_name_list()}"
        ) from error
    key = CONTROL_NAMES.get(name.strip().lower().replace("-", "_"))
    if key is None:
        raise argparse.ArgumentTypeError(
            f"unknown setting {name.strip()!r}; choose one of: {_name_list()}")
    return key, _parse_value(key, raw)


def _section_aliases() -> dict[str, int]:
    """Map section names to indices, derived from the sections themselves."""
    extra = {"Read-aloud": ("speech", "voice", "engine"),
             "Reading": ("extent", "text"),
             "Output": ("device", "sink", "audio"),
             "Test": ("tests", "try")}
    aliases: dict[str, int] = {}
    for index, section in enumerate(SECTIONS):
        canonical = section.name.lower()
        aliases[canonical] = index
        aliases[canonical.replace("-", "")] = index
        for alias in extra.get(section.name, ()):
            aliases[alias] = index
    return aliases


SECTION_ALIASES = _section_aliases()


def _parse_section(value: str) -> int:
    index = SECTION_ALIASES.get(value.strip().lower())
    if index is None:
        raise argparse.ArgumentTypeError(
            "unknown section; choose one of: "
            + ", ".join(section.name.lower() for section in SECTIONS))
    return index


