# --------------------------------------------------------------------------
# Talking to kilix-voiced
# --------------------------------------------------------------------------


def control(request: dict, timeout: float = CONTROL_TIMEOUT_S) -> dict:
    """Send one request to the daemon and return its reply.

    One request, one reply, one connection: the daemon answers and hangs up, so
    a screen somebody is reading never holds the control socket open against
    the pane that actually wants to speak.
    """
    try:
        packet = protocol.encode(request)
    except protocol.MessageTooLarge as error:
        # protocol.encode now enforces the limit it declares, so the refusal
        # arrives as a typed exception rather than a length check after the
        # fact. Keep this tool's own wording; match on the TYPE, never the text.
        raise VoiceToolError(
            f"the encoded voice request exceeds the local control-packet "
            f"limit of {protocol.MAX_REQUEST_BYTES} bytes ({error}). Send "
            "shorter text or split it into several speak requests.") from error
    except protocol.ProtocolError as error:
        raise VoiceToolError(str(error)) from error

    path = paths.control_socket()
    endpoint = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
    try:
        endpoint.settimeout(timeout)
        try:
            endpoint.connect(path)
        except FileNotFoundError as error:
            raise VoiceToolError(
                f"kilix-voiced is not running: there is no control socket at "
                f"{path}. Start it with `kilix-voiced &`, or press Kilix's "
                "speaking-head button, which starts it on demand.") from error
        except ConnectionRefusedError as error:
            raise VoiceToolError(
                f"the control socket {path} is stale — nothing is listening on "
                "it. Start kilix-voiced again; it clears a stale socket at "
                "startup.") from error
        except PermissionError as error:
            raise VoiceToolError(
                f"you are not allowed to reach {path}: {error}. A voice session "
                "belongs to one user; run kilix-voiced as yourself, or point "
                "KILIX_SESSION_HOME at a directory you own.") from error
        except OSError as error:
            raise VoiceToolError(
                f"cannot reach kilix-voiced on {path}: {error}. Check that the "
                "session directory exists and that the daemon serving it is "
                "this version, or point KILIX_SESSION_HOME at a shorter path "
                "you own — a unix socket path is limited to about 100 "
                "characters.") from error
        attempted_send = False
        try:
            attempted_send = True
            endpoint.send(packet)
            raw = endpoint.recv(MAX_REPLY_BYTES)
        except TimeoutError as error:
            raise VoiceToolError(
                f"kilix-voiced did not answer within {timeout:.0f} seconds. It "
                "may be stuck on an audio device: check `pactl info`, or stop "
                "the daemon and start it again.",
                request_may_be_active=attempted_send) from error
        except OSError as error:
            raise VoiceToolError(
                f"kilix-voiced closed the connection: {error}. Its stderr says "
                "why it refused the request.",
                request_may_be_active=attempted_send) from error
    finally:
        endpoint.close()
    if not raw:
        raise VoiceToolError(
            "kilix-voiced accepted the connection and closed it without "
            "replying. It only serves the user it runs as — check its stderr, "
            "and that it is your own daemon.", request_may_be_active=True)
    try:
        reply = protocol.decode(raw)
    except protocol.ProtocolError as error:
        raise VoiceToolError(
            f"kilix-voiced sent a reply this version cannot read ({error}). "
            "Check that kilix-tts and kilix-voiced come from the same "
            "installation.", request_may_be_active=True) from error
    if not reply.get("ok"):
        raise VoiceToolError(str(reply.get("error") or (
            "kilix-voiced refused the request without saying why. Its stderr "
            "has the details.")))
    return reply


class Status(NamedTuple):
    """What can actually happen right now, and why not when it cannot."""

    daemon_ok: bool
    daemon_detail: str
    engine_ok: bool
    engine_detail: str
    output_ok: bool
    output_detail: str


def _one_line(text: object) -> str:
    """Flatten a message so it occupies exactly one row, or one printed line."""
    return " ".join(str(text).split())


def _playback_cfg() -> dict:
    """Return the audio config the sink probe should be judged against."""
    return {"audio": {"device_out": settings.device_out()}}


def _local_engine() -> tuple[bool, str]:
    """Report synthesis from this machine, launching nothing.

    Used when the daemon cannot be reached; when it can, its own answer is
    preferred because it is the process that would run the engine.
    """
    engine = settings.tts_engine()
    if engine == "off":
        return False, (f"read-aloud is switched off. Set the engine to espeak "
                       f"here, or {settings.KEY_TTS_ENGINE}=espeak in "
                       f"{paths.settings_file()}, to enable it.")
    if engine == models.TTS_ENGINE_PIPER:
        return tts_lib.piper_status()
    voice = settings.tts_voice()
    try:
        command = tts_lib.build_synth_cmd(None, voice=voice,
                                          rate=settings.tts_rate())
    except tts_lib.TtsError as error:
        return False, _one_line(error)
    detail = f"{engine} · {voice} · {command[0]}"
    if engine == "mbrola":
        detail += f" ({tts_lib.mbrola_selection_detail(voice)})"
    return True, detail


def _local_output() -> tuple[bool, str]:
    """Report playback from this machine, launching nothing."""
    try:
        command = audio.build_play_cmd(_playback_cfg(),
                                       tts_lib.ESPEAK_SAMPLE_RATE)
    except audio.AudioError as error:
        return False, _one_line(error)
    return True, " ".join(command)


def _reported(payload: dict, name: str) -> tuple[bool, str]:
    """Return one sub-report from the daemon's status payload."""
    part = payload.get(name)
    if not isinstance(part, dict):
        return False, (f"kilix-voiced sent no {name} status. Check that it and "
                       "kilix-tts come from the same installation.")
    return bool(part.get("available")), _one_line(part.get("detail") or "")


def _local_status(daemon_ok: bool, daemon_detail: str) -> Status:
    """Report from this machine, for when the daemon cannot report for itself."""
    engine_ok, engine_detail = _local_engine()
    output_ok, output_detail = _local_output()
    return Status(daemon_ok, daemon_detail, engine_ok, engine_detail,
                  output_ok, output_detail)


def probe(timeout: float = PROBE_TIMEOUT_S) -> Status:
    """Ask the daemon what it can do; fall back to inspecting this machine."""
    try:
        reply = control({"op": protocol.OP_STATUS, "id": "kilix-tts",
                         "v": protocol.PROTOCOL_VERSION}, timeout)
    except VoiceToolError as error:
        return _local_status(False, _one_line(error))
    payload = reply.get("status")
    if not isinstance(payload, dict):
        return _local_status(True, (
            "running, but it sent no status payload. Check that kilix-tts and "
            "kilix-voiced come from the same installation."))
    detail = (f"running · pid {payload.get('pid')} · up "
              f"{payload.get('uptime')}s · idle {payload.get('idle')}s")
    if payload.get("speaking"):
        detail += " · speaking"
    if payload.get("listening"):
        detail += " · listening"
    engine_ok, engine_detail = _reported(payload, "tts")
    tts_part = payload.get("tts")
    if engine_ok and isinstance(tts_part, dict):
        # The engine's own name and voice, so the line reads the same whether
        # it came from the daemon or from the fallback probe above.
        engine_detail = _one_line(
            f"{tts_part.get('engine')} · {tts_part.get('voice')} · "
            f"{engine_detail}")
    output_ok, output_detail = _reported(payload, "playback")
    return Status(True, detail, engine_ok, engine_detail, output_ok,
                  output_detail)


def test_phrase() -> str:
    """Return a phrase that says back the settings it is being read with."""
    return (f"Kilix read-aloud test. This is the {settings.tts_voice()} voice "
            f"at {settings.tts_rate()} words per minute.")


def _speech_request(text: str, *, model: str | None = None,
                    voice: str | None = None,
                    rate: int | None = None) -> dict:
    """Validate one bounded arbitrary-text request for playback or export."""
    if not isinstance(text, str) or not text.strip():
        raise VoiceToolError("nothing to read aloud: speech text is empty")
    # `v` declares the wire contract this tool was written against, so a
    # daemon of a different major refuses it instead of guessing.
    request: dict = {"op": protocol.OP_SPEAK, "text": text,
                     "id": "kilix-tts", "v": protocol.PROTOCOL_VERSION}
    requested = {"model": model, "voice": voice, "rate": rate}
    request.update({key: value for key, value in requested.items()
                    if value is not None})
    try:
        request = protocol.validate_request(request, paths.session_dir())
        packet = protocol.encode(request)
    except protocol.ProtocolError as error:
        raise VoiceToolError(str(error)) from error
    if len(packet) > protocol.MAX_REQUEST_BYTES:
        raise VoiceToolError(
            f"the encoded voice request is {len(packet)} bytes; the local "
            f"control/file request limit is {protocol.MAX_REQUEST_BYTES}. "
            "Use shorter text or split it into several speech requests or "
            "files.")
    return request


def speak_text(text: str, *, model: str | None = None,
               voice: str | None = None,
               rate: int | None = None) -> str:
    """Ask the daemon to speak caller-supplied text with safe overrides."""
    request = _speech_request(text, model=model, voice=voice, rate=rate)
    requested = {key: request.get(key) for key in ("model", "voice", "rate")}
    try:
        reply = control(request)
    except VoiceToolError as error:
        if not error.request_may_be_active:
            raise
        stopped = _compensate_speech()
        outcome = ("a stop request was confirmed"
                   if stopped else "a stop request could not be confirmed")
        raise VoiceToolError(f"{error} Because acceptance was uncertain, "
                             f"{outcome}.") from error

    # An older daemon would discard fields it does not know and speak with the
    # configured default.  That is acceptable for a request with no override,
    # but never for an explicit model/voice choice. Silence the possibly active
    # turn before reporting the incompatible installation.
    mismatched = [key for key, value in requested.items()
                  if value is not None and reply.get(key) != value]
    if mismatched:
        stopped = _compensate_speech()
        outcome = ("the unconfirmed turn was stopped"
                   if stopped else "the unconfirmed turn may still be active")
        raise VoiceToolError(
            "kilix-voiced did not confirm the requested "
            f"{', '.join(mismatched)}. Install matching kilix-tts and "
            f"kilix-voiced versions; {outcome}.")

    chunks = reply.get("chunks") or 0
    if not chunks:
        return ("kilix-voiced had nothing to say: the phrase conditioned down "
                "to nothing.")
    selected_model = reply.get("model") or settings.tts_engine()
    selected_voice = reply.get("voice") or settings.tts_voice()
    selected_rate = reply.get("rate") or settings.tts_rate()
    return (f"Speaking {chunks} clip{'' if chunks == 1 else 's'} with "
            f"{selected_model}/{selected_voice} at {selected_rate} wpm — "
            "\"Stop speaking now\" cuts it short.")


def speak_test() -> str:
    """Ask the daemon to read the test phrase; return what happened."""
    return speak_text(test_phrase())


def _export_format(output: str) -> str:
    """Return the requested container name, inferred from its safe suffix."""
    suffix = os.path.splitext(output)[1].lower()
    if suffix not in _EXPORT_SUFFIXES:
        raise VoiceToolError(
            f"cannot infer an audio format from {output!r}: use a .wav or "
            ".mp3 filename.")
    return suffix[1:]


def _encode_mp3(wav: bytes) -> tuple[bytes, str]:
    """Encode an in-memory WAV with an installed, local MP3 command."""
    ffmpeg = util.which("ffmpeg")
    lame = util.which("lame")
    if ffmpeg:
        encoder = "ffmpeg"
        command = [
            ffmpeg, "-nostdin", "-hide_banner", "-loglevel", "error",
            "-f", "wav", "-i", "pipe:0", "-vn", "-map_metadata", "-1",
            "-codec:a", "libmp3lame", "-b:a", "64k", "-f", "mp3", "pipe:1",
        ]
    elif lame:
        encoder = "lame"
        command = [lame, "--silent", "-", "-"]
    else:
        raise VoiceToolError(
            "MP3 export needs a local encoder. Install ffmpeg "
            "(Debian/Ubuntu: sudo apt install ffmpeg) or lame, or save to "
            "a .wav file instead.")
    try:
        completed = subprocess.run(
            command, input=wav, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, timeout=MP3_ENCODING_TIMEOUT_S,
            check=False)
    except subprocess.TimeoutExpired as error:
        raise VoiceToolError(
            f"{encoder} did not finish the MP3 within "
            f"{MP3_ENCODING_TIMEOUT_S:.0f} seconds. Save WAV instead or "
            "check the encoder installation.") from error
    except OSError as error:
        raise VoiceToolError(
            f"cannot run the {encoder} MP3 encoder: {error}. Reinstall it or "
            "save WAV instead.") from error
    if completed.returncode != 0 or not completed.stdout:
        detail = completed.stderr.decode("utf-8", "replace").strip()
        note = f" ({detail.splitlines()[0][:200]})" if detail else ""
        raise VoiceToolError(
            f"{encoder} could not encode the MP3 (exit "
            f"{completed.returncode}){note}. Save WAV instead or check the "
            "encoder installation.")
    return completed.stdout, encoder


def _write_new_output(output: str, payload: bytes) -> str:
    """Write one private output file, refusing replacement and partial data."""
    target = os.path.abspath(output)
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    try:
        descriptor = os.open(target, flags, 0o600)
    except FileExistsError as error:
        raise VoiceToolError(
            f"refusing to overwrite existing output {target!r}. Choose a new "
            "filename or remove the old file explicitly.") from error
    except OSError as error:
        raise VoiceToolError(
            f"cannot create output {target!r}: {error}. Check that its parent "
            "directory exists and is writable.") from error
    try:
        stream = os.fdopen(descriptor, "wb")
    except BaseException:
        os.close(descriptor)
        try:
            os.unlink(target)
        except OSError:
            pass
        raise
    try:
        with stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
    except OSError as error:
        try:
            os.unlink(target)
        except OSError:
            pass
        raise VoiceToolError(
            f"could not finish output {target!r}: {error}. No partial audio "
            "file was kept; check free space and directory permissions.") \
            from error
    except BaseException:
        try:
            os.unlink(target)
        except OSError:
            pass
        raise
    return target


def save_text(text: str, output: str, *, model: str | None = None,
              voice: str | None = None,
              rate: int | None = None) -> str:
    """Render caller-supplied text to a new WAV or MP3 without playback."""
    container = _export_format(output)
    request = _speech_request(text, model=model, voice=voice, rate=rate)
    try:
        rendered = tts_lib.render_text(
            request["text"], model=request.get("model"),
            voice=request.get("voice"), rate=request.get("rate"),
            max_chars=settings.tts_max_chars())
    except (tts_lib.TtsError, settings.SettingsError, ValueError) as error:
        raise VoiceToolError(str(error)) from error
    if not rendered.chunks:
        raise VoiceToolError(
            "the supplied text conditioned down to silence; provide words "
            "rather than only terminal controls or decoration.")
    if not rendered.pcm:
        raise VoiceToolError(
            f"the selected {rendered.model!r} model produced no audio. Choose "
            "--model espeak or another available model shown by --models.")
    wav = util.write_wav(rendered.pcm, rendered.sample_rate)
    encoder = ""
    if container == "mp3":
        payload, encoder = _encode_mp3(wav)
    else:
        payload = wav
    target = _write_new_output(output, payload)
    duration = len(rendered.pcm) / (2 * rendered.sample_rate)
    encoded_by = f" via {encoder}" if encoder else ""
    return (
        f"Saved {rendered.chunks} clip"
        f"{'' if rendered.chunks == 1 else 's'} with "
        f"{rendered.model}/{rendered.voice} at {rendered.rate} wpm as "
        f"{container.upper()}{encoded_by} ({duration:.1f}s) to {target}")


def _compensate_speech() -> bool:
    """Best-effort stop after a speak whose exact acceptance is unknown."""
    try:
        control({"op": protocol.OP_STOP_SPEECH, "id": "kilix-tts",
                     "v": protocol.PROTOCOL_VERSION})
    except VoiceToolError:
        return False
    return True


def stop_speech() -> str:
    """Ask the daemon to silence the speakers; return what happened."""
    reply = control({"op": protocol.OP_STOP_SPEECH, "id": "kilix-tts",
                     "v": protocol.PROTOCOL_VERSION})
    return "Stopped." if reply.get("stopped") else "Nothing was speaking."


# --------------------------------------------------------------------------
# Pickers for the free-form fields
# --------------------------------------------------------------------------


def _is_token(text: str) -> bool:
    return bool(text) and len(text) <= 128 and set(text) <= _TOKEN_CHARS


def _tool_output(command: list[str]) -> str | None:
    """Return a helper's stdout, or None when it is missing or unhappy.

    Discovery only fills in a picker, so anything that goes wrong leaves the
    built-in list in place instead of becoming an error somebody has to clear.
    """
    try:
        result = subprocess.run(command, stdin=subprocess.DEVNULL,
                                capture_output=True,
                                timeout=DISCOVERY_TIMEOUT_S, check=False)
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    return result.stdout.decode("utf-8", "replace")


def discover_voices() -> tuple[str, ...]:
    """Return the voices the installed engine offers, or the built-in list.

    ``espeak-ng --voices`` prints a table whose second column is the name to
    pass to ``-v``; it opens no audio device, which is why a settings screen may
    run it.
    """
    binary = tts_lib.espeak_binary()
    text = _tool_output([binary, "--voices"]) if binary else None
    found = {parts[1] for parts in
             (line.split() for line in (text or "").splitlines()[1:])
             if len(parts) >= 2 and _is_token(parts[1])}
    return tuple(sorted(found)) or FALLBACK_VOICES


def discover_sinks() -> tuple[str, ...]:
    """Return "default" plus the sinks `pactl list sinks short` reports."""
    binary = util.which("pactl")
    text = _tool_output([binary, "list", "sinks", "short"]) if binary else None
    found = []
    for line in (text or "").splitlines():
        parts = line.split("\t")
        if len(parts) >= 2 and _is_token(parts[1]):
            found.append(parts[1])
    return (audio.DEFAULT_DEVICE,) + tuple(dict.fromkeys(found))


def _choices(field: Field, discovered: dict[str, tuple[str, ...]],
             current: str) -> tuple[str, ...]:
    """Return what cycling this field offers, current value included.

    A value the file already holds always stays reachable: a voice this engine
    does not list, or a sink that is unplugged today, must not disappear from
    the screen the moment somebody presses Space past it.
    """
    if field.kind == CHOICE:
        return settings.SPEC[field.key][1] or (current,)
    offered = discovered.get(field.key, ())
    return offered if current in offered else (current,) + offered


def _cycled(choices: tuple[str, ...], current: str, step: int) -> str:
    """Return the next (or previous) value in ``choices``."""
    if not choices:
        return current
    try:
        index = choices.index(current)
    except ValueError:
        return choices[0] if step > 0 else choices[-1]
    return choices[(index + step) % len(choices)]


def _default_value(field: Field) -> object:
    default = settings.SPEC[field.key][0]
    return settings.truthy(default) if field.kind == TOGGLE else default


def _short_name(key: str) -> str:
    """Return the friendly name --set accepts for a settings key."""
    return key.removeprefix("KILIX_VOICE_").removeprefix("KILIX_").lower()


# --------------------------------------------------------------------------
# Drawing
# --------------------------------------------------------------------------


def _put(stdscr, row: int, column: int, text: str,
         attr: int = curses.A_NORMAL) -> None:
    """Draw one line, clipped to the window.

    A terminal too small for a line simply loses it: this screen reports what a
    machine can do, and it has to keep working on the two-row pane somebody
    split off to look at it.
    """
    height, width = stdscr.getmaxyx()
    if not 0 <= row < height or column >= width - 1:
        return
    try:
        stdscr.addnstr(row, column, text, max(0, width - column - 1), attr)
    except curses.error:
        pass


def _marker(item: Field | Action, values: dict) -> str:
    if isinstance(item, Action):
        return "[>]"
    if item.kind == TOGGLE:
        return "[x]" if values[item.key] else "[ ]"
    return f"[{str(values[item.key]):^9}]"


def _status_lines(status: Status,
                  last_error: str) -> list[tuple[str, str, bool]]:
    """Return the status block, most urgent first.

    A window too short for all of it keeps the head of this list, so the thing
    that just went wrong is the line that survives.
    """
    lines = [("Daemon", status.daemon_detail, status.daemon_ok),
             ("Engine", status.engine_detail, status.engine_ok),
             ("Output", status.output_detail, status.output_ok)]
    if last_error:
        lines.insert(0, ("Error", last_error, False))
    return lines


def _draw(stdscr, values: dict, dirty: int, status: Status, last_error: str,
          section_index: int, selected: int, message: str) -> None:
    stdscr.erase()
    height, width = stdscr.getmaxyx()
    section = SECTIONS[section_index]
    body_height = max(0, height - 5)
    lines = _status_lines(status, last_error)[:max(0, body_height - 2)]
    gap = 1 if lines and body_height > len(lines) else 0
    available = max(0, body_height - len(lines) - gap)
    items = section.items
    scroll = min(max(0, selected - available + 1),
                 max(0, len(items) - available)) if available else 0

    summary = message or section.summary(values)
    if dirty:
        summary += f" · {dirty} unsaved"
    more = []
    if scroll:
        more.append("↑ more")
    if scroll + available < len(items):
        more.append("↓ more")
    help_text = ("←/→ section · ↑/↓ move · Enter run · s save · r refresh · "
                 "q quit" if section_index == TEST_SECTION_INDEX else
                 "←/→ section · ↑/↓ move · Space change · ⌫ back · e type · "
                 "d defaults · s save · q quit")
    footer = " · ".join((*more, help_text))
    body = tui_shell.draw(
        stdscr,
        title="Kilix Voice · Read Aloud",
        sections=[item.name for item in SECTIONS],
        active=section_index,
        summary=summary,
        footer=footer,
        summary_role="accent" if message or dirty else "muted",
    )

    for offset, item in enumerate(items[scroll:scroll + available]):
        index = scroll + offset
        marker = "▶" if index == selected else " "
        text = f"{marker} {_marker(item, values)} {item.label}"
        _put(
            stdscr,
            body.top + offset,
            body.left,
            text.ljust(body.width),
            tui_shell.attr("selected")
            if index == selected else curses.A_NORMAL,
        )

    first = body.bottom - len(lines)
    for offset, (label, detail, healthy) in enumerate(lines):
        _put(
            stdscr,
            first + offset,
            body.left,
            f"{label:<8} {detail}",
            tui_shell.attr("muted" if healthy else "alert"),
        )
    stdscr.refresh()


def _edit(stdscr, field: Field, current: str) -> str | None:
    """Type a value for a free-form field; None when it was cancelled.

    Only characters the shared settings file accepts in a name are taken, so a
    slip of the keyboard is refused as it happens rather than at save time.
    """
    text = current
    prompt = _short_name(field.key)
    try:
        curses.curs_set(1)
    except curses.error:
        pass
    try:
        while True:
            height, width = stdscr.getmaxyx()
            line = f"{prompt} = {text}_   (Enter accepts · Esc cancels)"
            _put(stdscr, height - 1, 1, line.ljust(max(0, width - 2)),
                 curses.A_BOLD)
            stdscr.refresh()
            key = stdscr.getch()
            if key in (curses.KEY_ENTER, 10, 13):
                return text.strip()
            if key == 27:
                return None
            if key in (curses.KEY_BACKSPACE, 127, 8):
                text = text[:-1]
            elif (32 <= key < 127 and len(text) < field.limit
                    and chr(key) in _TOKEN_CHARS):
                text += chr(key)
    finally:
        try:
            curses.curs_set(0)
        except curses.error:
            pass


