def _print_models() -> None:
    """List safe request-selectable synthesis families without networking."""
    synthesizer = tts_lib.espeak_binary()
    mbrola = util.which("mbrola")
    voice_count = len(discover_voices()) if synthesizer else 0
    selected = settings.tts_engine()
    for spec in models.TTS_MODELS:
        if spec.engine == models.TTS_ENGINE_ESPEAK:
            available = synthesizer is not None
            detail = (f"{voice_count} installed eSpeak voice names"
                      if available else "install espeak-ng")
        elif spec.engine == models.TTS_ENGINE_MBROLA:
            available = synthesizer is not None and mbrola is not None
            detail = ("MBROLA runtime found; each requested voice must also "
                      "be installed" if available else
                      "install espeak-ng, mbrola, and an MBROLA voice package")
        elif spec.engine == models.TTS_ENGINE_PIPER:
            available, detail = tts_lib.piper_status()
        else:
            from voicelib.qwen_provider import QwenProviderTts
            try:
                QwenProviderTts().check_available()
            except tts_lib.TtsError as error:
                available, detail = False, str(error)
            else:
                available, detail = True, "receipt-backed local provider ready"
        print(
            f"model={spec.catalog_id} engine={spec.engine} "
            f"available={'yes' if available else 'no'} "
            f"selected={'yes' if selected == spec.engine else 'no'}")
        print(f"  {spec.summary}; {detail}")


def _check_licence(catalog_id: str) -> None:
    """Answer whether a receipt covers this voice's weights, and fetch nothing.

    The same probe kilix-stt offers for the dictation models, for the one
    downloadable model this command owns. It exists so the refusal's second
    line names a command that actually runs for every gated id: a fetcher
    outside this tree cannot import voicelib, but it can run this and stop on
    its status. Exit 0 when a receipt covers the voice, exit 3
    (LICENCE_REFUSED_EXIT) with the same refusal on stderr when none does. It
    starts no provider and writes nothing under the model store either way.
    """
    licensing.require_covering_receipt(catalog_id)
    print(f"{catalog_id}: a licence receipt in "
          f"{licensing.receipt_store_root()} covers these weights.")


def _install_model(catalog_id: str) -> str:
    """Run the fixed provider's explicit, checksum-pinned install action.

    The Piper voice is model weights, so a covering licence receipt is the
    precondition (OS-V-VERIFY F2, OD-S, OD-BB). Two statements precede the
    gate, and neither can fetch: the catalog lookup that turns the id into a
    spec, and the check that refuses an operating-system synthesis family
    (eSpeak, MBROLA are distribution packages, not weights this tree fetches,
    so they are refused for a different reason and never reach the gate).
    Everything that could start a process is after it -- the provider is
    located below, so a refusal starts no process and fetches nothing, which
    ``LicenceOrderingTests`` pins by running with no provider installed.
    Raises licensing.LicenseRefused when no receipt covers it.
    """
    try:
        spec = models.TTS_MODEL_BY_ID[catalog_id]
    except KeyError as error:
        raise VoiceToolError(
            f"unknown TTS model {catalog_id!r}; choose one of: "
            f"{', '.join(models.TTS_MODEL_IDS)}"
        ) from error
    if spec.engine != models.TTS_ENGINE_PIPER:
        raise VoiceToolError(
            f"{catalog_id} is supplied by the operating system, not a "
            "downloadable Kilix model. Install its distribution package."
        )
    licensing.require_covering_receipt(catalog_id)
    binary = tts_lib.piper_binary()
    if binary is None:
        raise VoiceToolError(
            "kilix-piper-tts is not installed. Install that public Kilix "
            "module first, then repeat this command."
        )
    try:
        result = subprocess.run(
            [binary, "install", catalog_id], capture_output=True, check=False,
            timeout=MODEL_INSTALL_TIMEOUT_S, text=True, errors="replace")
    except (OSError, subprocess.TimeoutExpired) as error:
        raise VoiceToolError(f"cannot install {catalog_id} with {binary}: {error}") from error
    if result.returncode != 0:
        detail = _one_line(result.stderr or result.stdout or "no detail")
        raise VoiceToolError(
            f"{binary} could not install {catalog_id}: {detail}")
    return _one_line(result.stdout) or f"Installed {catalog_id}."


def _stdin_speech_text() -> str:
    """Read one bounded, strict-UTF-8 speech request from standard input."""
    stream = getattr(sys.stdin, "buffer", sys.stdin)
    raw = stream.read(protocol.MAX_REQUEST_BYTES + 1)
    if isinstance(raw, str):
        try:
            encoded = raw.encode("utf-8")
        except UnicodeEncodeError as error:
            raise VoiceToolError(
                f"standard input is not valid UTF-8 text ({error})") from error
        text = raw
    else:
        encoded = bytes(raw)
        try:
            text = encoded.decode("utf-8")
        except UnicodeDecodeError as error:
            raise VoiceToolError(
                f"standard input is not valid UTF-8 ({error})") from error
    if len(encoded) > protocol.MAX_REQUEST_BYTES:
        raise VoiceToolError(
            f"standard input is larger than the "
            f"{protocol.MAX_REQUEST_BYTES}-byte local request limit. Split it "
            "into several speak requests.")
    return text


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="kilix-tts",
        description="Configure Kilix read-aloud, speak supplied text through "
                    "kilix-voiced, or save it as WAV/MP3.")
    parser.add_argument("--print", action="store_true", dest="show",
                        help="print the effective read-aloud settings")
    parser.add_argument("--status", action="store_true",
                        help="print what kilix-voiced and this machine can do")
    parser.add_argument("--models", action="store_true",
                        help="list request-selectable local TTS model families")
    parser.add_argument(
        "--install", choices=(models.PIPER_KRISTIN_MODEL,), metavar="MODEL",
        help="explicitly install a checksum-pinned neural TTS model")
    from voicelib import qwen_setup
    parser.add_argument("--download-qwen", choices=(*qwen_setup.MODEL_IDS, "all"),
                        metavar="MODEL", help="first-use download of a catalogued Qwen model; "
                        "combine with --interactive for one Base/CustomVoice model; "
                        "all downloads the three catalogued models only")
    parser.add_argument(
        "--check-licence", choices=(models.PIPER_KRISTIN_MODEL,),
        dest="check_licence", metavar="MODEL",
        help="exit 0 if a licence receipt covers this voice's weights, 3 if "
             "none does; fetches nothing either way, so a fetcher outside "
             "this tree can gate itself on it")
    parser.add_argument("--speak", metavar="TEXT",
                        help="speak arbitrary text; use - to read UTF-8 stdin")
    parser.add_argument("--interactive", action="store_true",
                        help="foreground prompt/play/replay/save session; --speak is an optional first line")
    from voicelib import tts_tiers
    parser.add_argument("--tiers", action="store_true",
                        help="show hardware-aware TTS audition tiers without loading weights")
    parser.add_argument("--json", action="store_true", help="machine-readable --tiers report")
    parser.add_argument("--tier", choices=tts_tiers.TIER_IDS,
                        help="interactive only: select an installed, estimated-fit audition tier")
    parser.add_argument("--qwen-model-dir", metavar="DIR",
                        help="interactive only: audition existing local Qwen weights offline")
    parser.add_argument("--pocket-model-dir", metavar="DIR",
                        help="interactive only: audition pinned local Pocket CPU weights and Alba preset offline")
    parser.add_argument("--download-pocket", action="store_true",
                        help="interactive only: accept the Pocket CPU/Alba terms and download pinned weights")
    parser.add_argument("--device", choices=("cpu", "cuda:0"), default="cpu",
                        help="resident Qwen device (default: cpu; never auto-selects GPU)")
    parser.add_argument("--attention", choices=("sdpa", "flash_attention_2"), default="sdpa",
                        help="Qwen attention backend; FlashAttention 2 requires CUDA and flash-attn")
    parser.add_argument("--threads", type=int, default=4, help="Qwen CPU threads (1–32)")
    parser.add_argument("--seed", type=int, default=0, help="Qwen sampling seed")
    parser.add_argument("--language", help="interactive Qwen language (default: English)")
    parser.add_argument("--synthetic-reference", action="store_true",
                        help="audition a Qwen Base model using a generated eSpeak reference")
    parser.add_argument(
        "--output", "--save", dest="output", metavar="FILE",
        help="save --speak text to a new .wav or .mp3 file instead of playing")
    parser.add_argument("--model", choices=models.TTS_MODEL_IDS,
                        help="model family for this speech request")
    parser.add_argument("--voice", metavar="NAME",
                        help="voice for this speech request, such as en-us")
    parser.add_argument("--rate", type=int, choices=protocol.TTS_RATE_CHOICES,
                        metavar="WPM", help="rate for this speech request")
    parser.add_argument("--set", action="append", default=[],
                        type=_parse_assignment, metavar="NAME=VALUE",
                        help="set one setting, for example wpm=200, "
                             "voice=en-gb, engine=off")
    parser.add_argument("--section", type=_parse_section,
                        metavar="|".join(section.name.lower()
                                         for section in SECTIONS),
                        help="open the interactive screen on this section")
    parser.add_argument("--version", action="version",
                        version=f"kilix-tts {__version__}")
    args = parser.parse_args(argv)

    if args.json and not args.tiers:
        parser.error("--json requires --tiers")
    if args.tiers:
        if any(value != parser.get_default(key) for key, value in vars(args).items()
               if key not in {"tiers", "json"}):
            parser.error("--tiers is standalone; optionally add --json")
        try:
            tts_tiers.print_report(tts_tiers.report(), args.json)
        except tts_tiers.sizing.SizerError as error:
            parser.exit(1, f"kilix-tts: {error}\n")
        return 0
    if args.tier:
        if (not args.interactive or args.model or args.qwen_model_dir or args.pocket_model_dir or args.download_qwen or args.download_pocket
                or args.synthetic_reference or args.device != "cpu" or args.attention != "sdpa"
                or args.set or args.show or args.status or args.models or args.install
                or args.check_licence or args.section is not None or args.output):
            parser.error("--tier requires standalone --interactive; do not combine engine/device selectors")
        try:
            tier_report = tts_tiers.report()
            tts_tiers.select(args, tier_report)
        except tts_tiers.sizing.SizerError as error:
            parser.exit(1, f"kilix-tts: {error}\n")
        selected_row = next(row for row in tier_report["candidates"]
                            if row["tier"] == args.tier)
        if selected_row["installable"]:
            if not sys.stdin.isatty() or not sys.stdout.isatty():
                parser.error("TTS first-use installation requires a terminal")
            try:
                if args.tier == "neural":
                    qwen_setup.install(qwen_setup.PIPER_ID)
                    print(_install_model(qwen_setup.PIPER_ID), flush=True)
                elif args.tier == "pocket-cpu":
                    print(f"Installed {qwen_setup.POCKET_ID}: "
                          f"{qwen_setup.install(qwen_setup.POCKET_ID)}", flush=True)
                else:
                    qwen_id = (tts_tiers.QWEN_BASE_ID if args.tier == "qwen-base-gpu"
                               else tts_tiers.QWEN_ID)
                    print(f"Installed {qwen_id}: "
                          f"{qwen_setup.install(qwen_id)}", flush=True)
                tts_tiers.select(args, tts_tiers.report())
            except qwen_setup.Declined as error:
                print(error)
                return 0
            except licensing.LicenseRefused as error:
                parser.exit(licensing.LICENCE_REFUSED_EXIT, f"kilix-tts: {error}\n")
            except (VoiceToolError, OSError, RuntimeError, ValueError) as error:
                parser.exit(1, f"kilix-tts: {error}\n")

    if args.download_qwen and not args.interactive:
        if (args.qwen_model_dir or args.pocket_model_dir or args.download_pocket or args.synthetic_reference
                or args.speak is not None or args.model or args.voice or args.rate
                or args.output or args.set or args.show or args.status or args.models
                or args.install or args.check_licence or args.section is not None
                or args.language or args.device != "cpu" or args.attention != "sdpa"
                or args.threads != 4 or args.seed != 0):
            parser.error("speech options with --download-qwen require --interactive")
        selected = qwen_setup.MODEL_IDS if args.download_qwen == "all" else (args.download_qwen,)
        try:
            for model_id in selected:
                print(f"Installed {model_id}: {qwen_setup.install(model_id)}", flush=True)
        except qwen_setup.Declined as error:
            print(error)
            return 0
        except Exception as error:
            # Content and License define their own domain exception families.
            # Keep first-use failures concise without importing either optional
            # dependency into every ordinary CLI invocation.
            parser.exit(1, f"kilix-tts: {error}\n")
        except (KeyboardInterrupt, EOFError):
            return 130
        return 0

    qwen_options = (args.qwen_model_dir or args.synthetic_reference or args.language
                    or args.device != "cpu" or args.attention != "sdpa"
                    or args.threads != 4 or args.seed != 0)
    if (args.pocket_model_dir or args.download_pocket) and not args.interactive:
        parser.error("Pocket CPU options require --interactive")
    if qwen_options and not (args.interactive and (args.qwen_model_dir or args.download_qwen
                                                  or args.pocket_model_dir or args.download_pocket)):
        parser.error("Qwen session options require --interactive with --qwen-model-dir or --download-qwen")
    if args.interactive:
        if (args.set or args.show or args.status or args.models or args.install
                or args.check_licence or args.section is not None or args.output):
            parser.error("--interactive is standalone; use /save FILE.wav in the session")
        if args.pocket_model_dir or args.download_pocket:
            if (args.pocket_model_dir and args.download_pocket
                    or args.qwen_model_dir or args.download_qwen or args.model or args.rate
                    or args.synthetic_reference or args.language or args.device != "cpu"
                    or args.attention != "sdpa"):
                parser.error("Pocket CPU cannot be combined with another engine or Qwen options")
        if (args.qwen_model_dir or args.download_qwen) and (args.model or args.rate):
            parser.error("resident Qwen cannot be combined with --model or --rate")
        if args.attention == "flash_attention_2" and args.device == "cpu":
            parser.error("--attention flash_attention_2 requires --device cuda:0")
        if args.download_qwen:
            if args.qwen_model_dir:
                parser.error("choose --download-qwen or --qwen-model-dir, not both")
            if args.download_qwen not in qwen_setup.MODEL_IDS[:2]:
                parser.error("--interactive --download-qwen requires one Base or CustomVoice model")
            base = args.download_qwen.endswith("-base")
            if base != args.synthetic_reference or (base and args.voice):
                parser.error("Base requires --synthetic-reference and no --voice; CustomVoice does not")
        if not 1 <= args.threads <= 32 or not 0 <= args.seed <= 2**32 - 1:
            parser.error("--threads must be 1–32 and --seed must be 0–4294967295")
        if args.speak == "-":
            parser.error("--interactive reads prompts itself; --speak must be literal text")
        if not sys.stdin.isatty() or not sys.stdout.isatty():
            parser.error("--interactive needs a terminal")
        from voicelib import interactive
        try:
            if args.download_pocket:
                print("Pocket CPU setup — the session starts after first-use installation.", flush=True)
                args.pocket_model_dir = qwen_setup.install(qwen_setup.POCKET_ID)
            if args.download_qwen:
                print("Qwen setup — the session starts here after the download completes.", flush=True)
                args.qwen_model_dir = qwen_setup.install(args.download_qwen)
            return interactive.run(args)
        except qwen_setup.Declined as error:
            print(error)
            return 0
        except KeyboardInterrupt:
            return 130
        except EOFError:
            return 0
        except Exception as error:
            parser.exit(1, f"kilix-tts: {error}\n")

    changes = dict(args.set)
    speech_overrides = (args.model, args.voice, args.rate, args.output)
    if args.speak is None and any(value is not None
                                  for value in speech_overrides):
        parser.error(
            "--model, --voice, --rate and --output require --speak TEXT")
    if args.speak is not None and (changes or args.show or args.status
                                   or args.models or args.install
                                   or args.check_licence
                                   or args.section is not None):
        parser.error("--speak is a standalone action; do not combine it with "
                     "--set, --print, --status, --models, --install, "
                     "--check-licence or --section")
    if args.models and (changes or args.show or args.status
                        or args.install or args.check_licence
                        or args.section is not None):
        parser.error("--models is a standalone action")
    if args.install and (changes or args.show or args.status
                         or args.check_licence or args.section is not None):
        parser.error("--install is a standalone action")
    if args.check_licence and (changes or args.show or args.status
                               or args.section is not None):
        parser.error("--check-licence is a standalone action")

    if args.speak is not None:
        try:
            text = (_stdin_speech_text() if args.speak == "-"
                    else args.speak)
            if args.output:
                print(save_text(text, args.output, model=args.model,
                                voice=args.voice, rate=args.rate))
            else:
                print(speak_text(text, model=args.model, voice=args.voice,
                                 rate=args.rate))
        except VoiceToolError as error:
            parser.exit(1, f"kilix-tts: {error}\n")
        return 0
    if args.models:
        _print_models()
        return 0
    if args.check_licence:
        try:
            _check_licence(args.check_licence)
        except licensing.LicenseRefused as error:
            parser.exit(licensing.LICENCE_REFUSED_EXIT, f"kilix-tts: {error}\n")
        return 0
    if args.install:
        try:
            print(_install_model(args.install))
        except licensing.LicenseRefused as error:
            # Its own status: an unattended caller has to be able to tell "a
            # human must accept a licence" from "the installer broke" (exit 1).
            parser.exit(licensing.LICENCE_REFUSED_EXIT, f"kilix-tts: {error}\n")
        except VoiceToolError as error:
            parser.exit(1, f"kilix-tts: {error}\n")
        return 0

    if changes:
        try:
            settings.update(changes)
        except settings.SettingsError as error:
            parser.exit(1, f"kilix-tts: {error}\n")
        _notify_running_kilix()
    if args.show:
        _print_settings()
    if args.status:
        _print_status()
    if changes or args.show or args.status:
        return 0

    if not sys.stdin.isatty() or not sys.stdout.isatty():
        parser.error("the interactive screen needs a terminal; use --print, "
                     "--status, --models, --install MODEL, --speak TEXT, or "
                     "--set NAME=VALUE")
    try:
        return curses.wrapper(_run_tui, args.section)
    except curses.error as error:
        parser.exit(1, f"kilix-tts: this terminal will not run a curses "
                       f"screen ({error}). Use --print, --status, --models, "
                       f"--speak or --set instead.\n")
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
