def _load_values() -> dict[str, object]:
    """Return the validated settings this screen edits."""
    return {field.key: (settings.enabled(field.key) if field.kind == TOGGLE
                        else settings.value(field.key))
            for field in FIELDS}


def _notify_running_kilix() -> None:
    """Tell the terminal that owns this pane to re-read the shared settings.

    Kilix redraws its chrome on SIGUSR1, which is how the speaking-head button
    appears or disappears without restarting the terminal.
    """
    raw_pid = os.environ.get("KITTY_PID", "")
    if raw_pid.isdigit():
        try:
            os.kill(int(raw_pid), signal.SIGUSR1)
        except OSError:
            pass


def _run_action(action: Action, dirty: int) -> tuple[str, str]:
    """Run one Test-section action; return (message, error)."""
    if action.key == "refresh":
        return "Re-checked the daemon, the engine and the sink.", ""
    if action.key == "speak" and dirty:
        # Stopping is always allowed: it takes no settings with it, and a test
        # somebody wants silenced must not wait for a save.
        return ("Save first (s): kilix-voiced reads the settings file, not "
                "this list."), ""
    try:
        return (speak_test() if action.key == "speak" else stop_speech()), ""
    except VoiceToolError as error:
        return "That did not work — see the Error line.", _one_line(error)


def _run_tui(stdscr, initial_section: int | None = None) -> int:
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    stdscr.keypad(True)
    values = _load_values()
    original = dict(values)
    discovered = {settings.KEY_TTS_VOICE: discover_voices(),
                  settings.KEY_DEVICE_OUT: discover_sinks()}
    status = probe()
    section_index = initial_section or 0
    selected = [0] * len(SECTIONS)
    message = ""
    last_error = ""
    discard_armed = False

    while True:
        section = SECTIONS[section_index]
        items = section.items
        testing = section_index == TEST_SECTION_INDEX
        item_index = min(selected[section_index], len(items) - 1)
        selected[section_index] = item_index
        item = items[item_index]
        dirty = sum(values[key] != original[key] for key in values)
        _draw(stdscr, values, dirty, status, last_error, section_index,
              item_index, message)
        message = ""
        key = stdscr.getch()
        if key not in (ord("q"), ord("Q"), 27):
            discard_armed = False

        if key in (curses.KEY_UP, ord("k"), ord("K")):
            selected[section_index] = (item_index - 1) % len(items)
        elif key in (curses.KEY_DOWN, ord("j"), ord("J")):
            selected[section_index] = (item_index + 1) % len(items)
        elif key in (curses.KEY_LEFT, ord("h"), ord("H"),
                     getattr(curses, "KEY_BTAB", -1)):
            section_index = (section_index - 1) % len(SECTIONS)
        elif key in (curses.KEY_RIGHT, ord("l"), ord("L"), ord("\t")):
            section_index = (section_index + 1) % len(SECTIONS)
        elif ord("1") <= key <= ord(str(len(SECTIONS))):
            section_index = key - ord("1")
        elif key == curses.KEY_HOME:
            selected[section_index] = 0
        elif key == curses.KEY_END:
            selected[section_index] = len(items) - 1
        elif key in (ord(" "), curses.KEY_ENTER, 10, 13):
            if testing:
                message, last_error = _run_action(item, dirty)
                status = probe()
            elif item.kind == TOGGLE:
                values[item.key] = not values[item.key]
            else:
                values[item.key] = _cycled(
                    _choices(item, discovered, str(values[item.key])),
                    str(values[item.key]), 1)
        elif key in (curses.KEY_BACKSPACE, 127, 8):
            if not testing and item.kind != TOGGLE:
                values[item.key] = _cycled(
                    _choices(item, discovered, str(values[item.key])),
                    str(values[item.key]), -1)
        elif key in (ord("e"), ord("E")):
            if testing or item.kind != TOKEN:
                message = "That setting has fixed values; Space changes it."
            else:
                typed = _edit(stdscr, item, str(values[item.key]))
                if typed is None:
                    message = "Left unchanged."
                elif not typed:
                    message = (f"{_short_name(item.key)} cannot be empty; use "
                               "'default' for the system default.")
                else:
                    values[item.key] = typed
        elif key in (ord("d"), ord("D")):
            if testing:
                message = "Tests have nothing to reset."
            else:
                for field in items:
                    values[field.key] = _default_value(field)
                message = f"{section.name} reset to defaults — s saves."
        elif key in (ord("r"), ord("R")):
            status = probe()
            message = "Re-checked the daemon, the engine and the sink."
        elif key in (ord("s"), ord("S")):
            changes = {name: staged for name, staged in values.items()
                       if original[name] != staged}
            if not changes:
                message = "No changes to save."
            else:
                try:
                    path = settings.update(changes)
                except settings.SettingsError as error:
                    message = "Could not save — see the Error line."
                    last_error = _one_line(error)
                else:
                    original = dict(values)
                    _notify_running_kilix()
                    last_error = ""
                    status = probe()
                    message = (f"Saved to {path}. kilix-voiced re-reads it "
                               "before the next read.")
        elif key in (ord("q"), ord("Q"), 27):
            if values != original and not discard_armed:
                message = "Unsaved changes: s saves; q again discards."
                discard_armed = True
                continue
            return 0


