class DaemonError(RuntimeError):
    """The daemon cannot serve a request; the message says what to do.

    R6 finding 3: every refusal a handler raised reached the caller as
    ERR_INTERNAL -- "the daemon has a bug" -- because the control path called
    reply_error with no code, while the dictation worker already coded the
    same exceptions `unavailable`. The code now travels with the exception, so
    both paths read it from one place. The base keeps `unavailable`, the code
    R4 confirmed for this family; a refusal with a more precise cause is a
    subclass below.
    """

    code = protocol.ERR_UNAVAILABLE


class DaemonBusy(DaemonError):
    """Refused because a turn already owns the device this request needs."""

    code = protocol.ERR_BUSY


class DaemonNotFound(DaemonError):
    """Refused because a socket the request names is not there to deliver to."""

    code = protocol.ERR_NOT_FOUND


class DaemonRefusedReceiver(DaemonError):
    """Refused because the named receiver is the daemon's own control socket.

    Containment admits any path inside the session directory, and control.sock
    is inside it. A dictate or speak naming it connected the worker to this
    daemon's own listener, which then read transcripts and chunk descriptors
    as requests. Like a path outside the session, that is a value no caller
    should send: malformed.
    """

    code = protocol.ERR_MALFORMED


class DaemonUnavailable(DaemonError):
    """Refused because a capability is switched off or cannot be started."""

    code = protocol.ERR_UNAVAILABLE


class ConsentDenied(DaemonError):
    """Capture refused because no grant covers this configuration.

    R4 finding 3: the consent refusal reached the caller as ERR_UNAVAILABLE,
    the same code as a missing microphone, while the purpose-built ERR_DENIED
    was dead code. "You have not consented" and "there is no device" call for
    different things from a caller, and this is the most important refusal in
    the system to be able to name.
    """

    code = protocol.ERR_DENIED


def _carried_code(error: BaseException, default: str) -> str:
    """Return the closed code ``error`` carries, or ``default`` when it has none.

    The one adapter both the control path and the dictation worker use, so an
    exception family cannot be coded one way on one path and another way on
    the other -- the R5 finding A shape, where two engines disagreed. The code
    is validated here (R5 finding B): an attribute that is not in the closed
    vocabulary would make reply_error or dictation_error raise, and the caller
    would then get no reply at all.
    """
    code = getattr(error, "code", None)
    return code if code in protocol.ERROR_CODES else default


def _reply_voice(engine: object) -> str:
    """The voice a speak reply names: for the mbrola tier, the voice it runs.

    The request's en-us is a language, not an MBROLA voice, so naming it
    would not say what speaks. Only a real eSpeak engine is asked; any other
    engine names its own voice.
    """
    if isinstance(engine, tts_lib.EspeakTts):
        return engine.selected_voice
    return engine.voice


def clean_for_injection(text: str) -> str:
    """Return recognised text that is safe to type into a terminal."""
    return " ".join(_UNSAFE_FOR_PTY.sub(" ", str(text)).split())


def _stamp() -> str:
    return time.strftime("%H:%M:%S")


# The size of one descriptor in an SCM_RIGHTS array.
_FD_SIZE = struct.calcsize("i")


# -- the send side (SEND-01) ------------------------------------------------
#
# The closed error vocabulary used to be enforced only by the constructors that
# build a refusal: reply_error, dictation_error and job_terminal. A reply or
# datagram a handler or worker built by hand -- an unknown code, no code at
# all, no ok -- crossed the wire exactly as it was built. The guard sits where
# every frame leaves the daemon, _transmit, on both kinds of endpoint: the
# control connection, and a receiver socket, which carries dictation datagrams
# and speech chunk messages alike. A refusal, an error, or a terminal that did
# not complete, whose code is missing or not in ERROR_CODES, goes out coded
# `internal`: never dropped, and never raised out of the send path. A
# well-formed frame goes out byte for byte as it was built.
#
# The job ledger must agree with what crossed (P11). A terminal is therefore
# guarded BEFORE its job settles, by the same functions, and the job settles
# with the code the guarded terminal carries; _transmit then has nothing left
# to change.

_CHANNEL_REPLY = "reply"
_CHANNEL_MESSAGE = "message"
_UNSTATED_REFUSAL = ("kilix-voiced sent a refusal that gave no reason. This is a "
                     "bug; the daemon is still running.")
_UNSTATED_ERROR = ("kilix-voiced sent an error that gave no reason. This is a "
                   "bug; the daemon is still running.")
_NOT_A_TERMINAL = ("kilix-voiced ended this dictation with a message that is "
                   "neither its transcript nor an error. This is a bug; the "
                   "daemon is still running.")
_UNSENDABLE = ("kilix-voiced built a message it could not send. This is a bug; "
               "the daemon is still running.")
_UNBUILDABLE_TERMINAL = ("kilix-voiced could not build this job's terminal "
                         "message. This is a bug; the daemon is still running.")
# What makes a message a result, or names attached audio. A message recoded as
# an error keeps none of them: an error is never also a transcript, and no
# descriptor field is sent without its descriptor.
_RESULT_KEYS = frozenset({"final", "partial", "stable", "words", "speaker",
                          "audio_fd", "media_type", "byte_length", "sha256"})
_FIXED_OUTCOME_CODES = {jobs.OUTCOME_CANCELLED: protocol.ERR_CANCELLED,
                        jobs.OUTCOME_DEADLINE: protocol.ERR_DEADLINE}


def _closed_code(code: object) -> bool:
    """True when ``code`` is a member of the closed error vocabulary."""
    return isinstance(code, str) and code in protocol.ERROR_CODES


def _guard_reply(reply: object) -> dict:
    """Return ``reply`` as it may cross the control wire.

    A success -- ok exactly true, with neither error nor code -- and a
    well-formed refusal -- ok false, str prose, a closed code, no descriptors
    -- are returned as they are, the same object. Anything else is a refusal:
    ok false, its prose kept when it has some, its code kept only when it is
    closed and `internal` otherwise, and its other fields kept. Its
    descriptors are not: a refusal carries no data.
    """
    if not isinstance(reply, dict):
        return {"ok": False, "error": _UNSTATED_REFUSAL, "code": protocol.ERR_INTERNAL}
    ok, error, code = reply.get("ok"), reply.get("error"), reply.get("code")
    if ok is True and "error" not in reply and "code" not in reply:
        return reply
    if (ok is False and isinstance(error, str) and _closed_code(code)
            and not getattr(reply, "fds", ())):
        return reply
    guarded = {"ok": False,
               "error": error if isinstance(error, str) else _UNSTATED_REFUSAL,
               "code": code if _closed_code(code) else protocol.ERR_INTERNAL}
    for key, value in reply.items():
        if key not in guarded:
            guarded[key] = value
    return guarded


def _guard_terminal(message: dict) -> dict:
    """Return a protocol-1.2 chunk terminal as it may cross.

    completed with neither error nor code, cancelled or deadline with that
    same code, and failed with any other closed code are the only endings the
    vocabulary states. One of those with str prose wherever it carries a code
    is returned as it is. Any other ending goes out failed, coded internal,
    and a code without prose gets some.
    """
    outcome, code, error = message.get("outcome"), message.get("code"), message.get("error")
    if outcome == jobs.OUTCOME_COMPLETED and "code" not in message and "error" not in message:
        return message
    stated = ((outcome in _FIXED_OUTCOME_CODES and code == _FIXED_OUTCOME_CODES[outcome])
              or (outcome == jobs.OUTCOME_FAILED and _closed_code(code)
                  and code not in _FIXED_OUTCOME_CODES.values()))
    if stated and isinstance(error, str) and not getattr(message, "fds", ()):
        return message
    guarded = dict(message)
    if not stated:
        guarded["outcome"], guarded["code"] = jobs.OUTCOME_FAILED, protocol.ERR_INTERNAL
    if not isinstance(error, str):
        guarded["error"] = f"the job ended: {guarded['outcome']}"
    return guarded


def _guard_message(message: object) -> dict:
    """Return ``message`` as it may cross a receiver socket.

    A chunk terminal is guarded by _guard_terminal. Any other message carrying
    neither error nor code -- a partial, a final, a chunk descriptor -- is
    returned as it is, and so is a well-formed error: str prose, a closed code,
    and no result or descriptor field. Anything else that carries error or
    code is an error: its prose kept when it has some, its code kept only when
    closed and `internal` otherwise, every result and descriptor field dropped.
    """
    if not isinstance(message, dict):
        return {"error": _UNSTATED_ERROR, "code": protocol.ERR_INTERNAL}
    if message.get("terminal") is True:
        return _guard_terminal(message)
    if "error" not in message and "code" not in message:
        return message
    error, code = message.get("error"), message.get("code")
    if (isinstance(error, str) and _closed_code(code)
            and not _RESULT_KEYS & message.keys() and not getattr(message, "fds", ())):
        return message
    guarded = {"error": error if isinstance(error, str) else _UNSTATED_ERROR,
               "code": code if _closed_code(code) else protocol.ERR_INTERNAL}
    for key, value in message.items():
        if key not in guarded and key not in _RESULT_KEYS:
            guarded[key] = value
    return guarded


def _joinable(value: object) -> bool:
    """True for an id a constant fallback message can carry as it is."""
    return (isinstance(value, str) and 0 < len(value) <= protocol.MAX_ID_CHARS
            and value.isascii() and value.isprintable())


def _message_frame(message: dict) -> bytes:
    """Return the frame for a guarded receiver message.

    A transcript or chunk descriptor that is too large or will not encode
    raises, as it always has: its caller refuses it with a terminal of its
    own. An error or terminal that carries prose always has a frame: failing
    as built, with its prose escaped and cut; failing that, as a constant
    internal message that keeps only the ids joining it to its job.
    """
    try:
        return protocol.encode(message, limit=protocol.MAX_REPLY_BYTES)
    except protocol.ProtocolError:
        if not isinstance(message, dict) or "error" not in message:
            raise
    shorter = dict(message)
    shorter["error"] = protocol._cut_prose(
        str(message["error"]), protocol.MAX_ERROR_PROSE_CHARS // 2)
    try:
        return protocol.encode(shorter, limit=protocol.MAX_REPLY_BYTES)
    except protocol.ProtocolError:
        pass
    if message.get("terminal") is True:
        fallback: dict = {"terminal": True}
        for key in ("job", "kind"):
            if _joinable(message.get(key)):
                fallback[key] = message[key]
        chunks = message.get("chunks")
        fallback.update(
            outcome=jobs.OUTCOME_FAILED,
            chunks=chunks if isinstance(chunks, int) and not isinstance(chunks, bool)
            and 0 <= chunks < 1 << 31 else 0)
        fallback.update(code=protocol.ERR_INTERNAL, error=_UNSENDABLE)
    else:
        fallback = {"error": _UNSENDABLE, "code": protocol.ERR_INTERNAL}
        if _joinable(message.get("segment")):
            fallback["segment"] = message["segment"]
    return protocol.encode(fallback, limit=protocol.MAX_REPLY_BYTES)


def _outcome_as_sent(outcome: jobs.JobOutcome, terminal: dict) -> jobs.JobOutcome:
    """``outcome`` as the guarded terminal sent for it states it (P11)."""
    if (terminal.get("outcome"), terminal.get("code")) == (outcome.outcome, outcome.code):
        return outcome
    return jobs.JobOutcome(
        job=outcome.job, kind=outcome.kind, outcome=terminal["outcome"],
        code=terminal.get("code"),
        message=outcome.message or str(terminal.get("error", "")),
        chunks_published=outcome.chunks_published,
        subscriber_lost=outcome.subscriber_lost)


def _guarded_frame(frame: bytes, fds: tuple[int, ...],
                   channel: str) -> tuple[bytes, tuple[int, ...]]:
    """Return ``frame`` and ``fds`` as they may leave on ``channel``."""
    try:
        decoded = json.loads(frame)
    except (ValueError, RecursionError):
        decoded = None
    if channel == _CHANNEL_REPLY:
        guarded = _guard_reply(decoded)
        if guarded is decoded:
            return frame, (tuple(fds) if guarded.get("ok") is True else ())
        return protocol.encode_reply(guarded), ()
    guarded = _guard_message(decoded)
    if guarded is decoded:
        return frame, (() if "error" in guarded else tuple(fds))
    return _message_frame(guarded), ()


def _transmit(endpoint: socket.socket, frame: bytes,
              fds: tuple[int, ...] = (), *, channel: str) -> None:
    """Send one frame, attaching ``fds`` by SCM_RIGHTS when there are any.

    The final wire boundary. Every frame the daemon sends passes here, and is
    guarded here whatever built it: ``channel`` is _CHANNEL_REPLY for the
    control connection and _CHANNEL_MESSAGE for a receiver socket. A frame the
    guard leaves as it is goes out byte for byte.
    """
    frame, fds = _guarded_frame(frame, fds, channel)
    if fds:
        endpoint.sendmsg([frame], [(socket.SOL_SOCKET, socket.SCM_RIGHTS,
                                    struct.pack(f"{len(fds)}i", *fds))])
    else:
        endpoint.send(frame)


def _reply_frame(reply: dict) -> tuple[bytes, tuple[int, ...]]:
    """Return the frame for a control reply and the descriptors that go with it.

    Descriptors travel only with the reply they belong to. A reply carrying
    descriptors that will not encode is replaced by encode_reply's bounded
    refusal, which goes out alone. What the frame may carry is decided where
    it is sent, by _transmit's guard.
    """
    reply = _escaped(reply)
    fds = tuple(getattr(reply, "fds", ()))
    if fds:
        try:
            return protocol.encode(reply, limit=protocol.MAX_REPLY_BYTES), fds
        except protocol.ProtocolError:
            pass
    return protocol.encode_reply(reply), ()


def _escaped(value: object) -> object:
    """``value`` with each lone surrogate in its text written as its backslash escape.

    UTF8-S. A success reply quotes what the daemon took from its environment
    and configuration: the session directory, a model or library path, a
    capture command, a failure's prose kept in the job ledger. A Linux name is
    bytes, and one that is not UTF-8 decodes to lone surrogates, which no
    UTF-8 frame can carry, so such a status went out as `internal` in place of
    the answer. Refusal prose already got this escape (protocol._cut_prose);
    every string in a reply, keys included, now gets the same one. Text that
    encodes is returned as the same object, and a reply's descriptors stay
    with it.
    """
    if isinstance(value, str):
        try:
            value.encode("utf-8")
        except UnicodeEncodeError:
            return value.encode("utf-8", "backslashreplace").decode("utf-8")
        return value
    if isinstance(value, dict):
        escaped = {_escaped(key): _escaped(item) for key, item in value.items()}
        if isinstance(value, _Outbound):
            return _Outbound(escaped, fds=value.fds, nonblocking=value.nonblocking,
                             droppable=value.droppable)
        return escaped
    if isinstance(value, (list, tuple)):
        return [_escaped(item) for item in value]
    return value


class _Outbound(dict):
    """A message plus how to send it: descriptors to attach, and whether to wait.

    A dict subclass rather than a keyword on _send, because shipped and
    independent-review tests replace _send with a two-argument stub
    (receiver, msg), and a new parameter would break every one. It still
    compares equal to the plain dict it carries, so a stub that records what
    was sent sees exactly what it saw before.
    """

    def __init__(self, message: dict, *, fds: tuple[int, ...] = (),
                 nonblocking: bool = False, droppable: bool = False) -> None:
        super().__init__(message)
        self.fds = tuple(fds)
        # A droppable message is progress: when the receiver is not keeping up
        # it is dropped and the receiver still counts as alive. Dropping only
        # makes sense without waiting, so it implies nonblocking.
        self.droppable = bool(droppable)
        self.nonblocking = bool(nonblocking) or self.droppable


class _Deferred:
    """A reply that is computed off the accept loop, on its own thread.

    ING-02: every ingest-audio request read its caller's descriptor on the
    accept loop, which could take about a second each, so six queued hostile
    requests held a following stop-speech for almost six seconds. _dispatch
    returns one of these for ingest-audio, and _accept_one hands the
    connection to a thread that calls it and sends what it returns. Every
    other op is still answered on the loop, and so never waits for an ingest.
    """

    def __init__(self, compute: Callable[[], dict]) -> None:
        self._compute = compute

    def __call__(self) -> dict:
        return self._compute()


class _ReceivingConnection:
    """A control connection whose recv also takes the request's descriptors.

    A plain recv discards any SCM_RIGHTS descriptors sent with the request.
    _answer reads with conn.recv, and so do the test doubles that stand in
    for it; this wrapper keeps that seam. The read underneath is a recvmsg
    that moves up to ``max_fds`` descriptors into ``fds``, close-on-exec, for
    _accept_one to own and close. Everything else is the connection's own.
    """

    def __init__(self, conn: socket.socket, max_fds: int) -> None:
        self._conn = conn
        self._max_fds = max_fds
        self.fds: list[int] = []
        self.truncated = False

    def recv(self, size: int, flags: int = 0) -> bytes:
        if not isinstance(self._conn, socket.socket):
            # Not a kernel socket -- an observing wrapper, say. Ancillary data
            # cannot be relied on through it, so it is read plainly: no
            # descriptor is taken, and the wrapper still sees the one recv.
            return self._conn.recv(size, flags)
        data, ancillary, msg_flags, _address = self._conn.recvmsg(
            size, socket.CMSG_SPACE(self._max_fds * _FD_SIZE),
            flags | socket.MSG_CMSG_CLOEXEC)
        for level, kind, blob in ancillary:
            if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
                self.fds.extend(struct.unpack(f"{len(blob) // _FD_SIZE}i", blob))
        # More descriptors than fit: the kernel closed the rest and says so.
        self.truncated = bool(msg_flags & socket.MSG_CTRUNC)
        return data

    def close_descriptors(self) -> None:
        fds, self.fds = self.fds, []
        for fd in fds:
            try:
                os.close(fd)
            except OSError:
                pass

    def __getattr__(self, name: str):
        return getattr(self._conn, name)


class _Clip(tuple):
    """One synthesised clip, (pcm, rate), carrying the provenance that made it.

    Still a two-tuple: it unpacks to two names and compares equal to (pcm,
    rate) wherever a caller already expects that. The provenance is read on
    the worker thread straight after synth and travels with the clip, so the
    descriptor published when the clip is queued describes THIS clip, not
    whichever synth the engine ran last.
    """

    provenance: tts_lib.SynthesisProvenance | None

    def __new__(cls, pcm: bytes, rate: int,
                provenance: tts_lib.SynthesisProvenance | None = None) -> "_Clip":
        clip = super().__new__(cls, (pcm, rate))
        clip.provenance = provenance
        return clip


class _JobTurn:
    """What every job's turn shares: its one terminal outcome.

    settle() is first-writer-wins. The first outcome sticks; every later
    attempt changes nothing and returns False. Exactly-once is enforced HERE,
    on the turn, so a daemon built without __init__ -- with no ledger at all --
    still cannot end a job twice. on_settle is the ledger's record, when the
    daemon has a ledger.

    Everything is a class-level default, so a turn built and adjusted by hand,
    as the tests build them, has all of it.
    """

    outcome: jobs.JobOutcome | None = None
    on_settle: Callable[[jobs.JobOutcome], object] | None = None
    # Set for a caller that declared protocol minor 2 or later: its chunk
    # stream ends with one terminal message after the last descriptor.
    terminal_events = False
    chunks_published = 0
    subscriber_lost = False
    # A15: the closed code for why a chunk subscription ended, or None.
    delivery_error: str | None = None
    # One lock for every turn's settle. It is held only to compare-and-set
    # one attribute and hand the outcome to the ledger, so sharing it costs
    # nothing measurable and needs no per-turn setup.
    _settle_lock = threading.Lock()

    def settle(self, outcome: jobs.JobOutcome,
               precondition: Callable[[], None] | None = None) -> bool:
        with self._settle_lock:
            if self.outcome is not None:
                return False
            if precondition is not None:
                # Refuses by raising, under the lock stop-dictation decides
                # under, so what it checks cannot change before the outcome
                # is set.
                precondition()
            self.outcome = outcome
            hook = self.on_settle
            if hook is not None:
                hook(outcome)
            return True


class _SpeechTurn(_JobTurn):
    """One read-aloud turn: its clips, its thread, and its cancel flag."""

    def __init__(self, turn_id: str, chunks: list[str],
                 engine: TtsEngine, deadline: float | None = None,
                 clock=time.monotonic) -> None:
        self.id = turn_id
        self.chunks = chunks
        self.engine = engine
        # ONE token carries both the stop flag and the budget. R3 F01 was two
        # notions of "should I stop" that could disagree; there is now one.
        self.cancel = Cancellation(deadline, clock)
        self.thread: threading.Thread | None = None
        # A12-A15: where streamed chunk descriptors go, and the sequence they
        # carry. None means the caller did not ask for the stream, which stays
        # the default so an ordinary speak is unchanged.
        self.receiver: socket.socket | None = None
        self.sequence = 0

    @property
    def deadline(self) -> float | None:
        """The token's deadline. A property so no copy can go stale."""
        return self.cancel.deadline

    @deadline.setter
    def deadline(self, value: float | None) -> None:
        self.cancel.deadline = value

    def expired(self) -> bool:
        """True once the caller's budget has run out."""
        return self.cancel.expired()


class _DictationTurn(_JobTurn):
    """One dictation turn: the socket it delivers to, and its stop token."""

    # P09: set by stop-dictation mode=abort, always BEFORE the stop token, so
    # anything that sees the stop has already seen the abort.
    abort = False

    def __init__(self, turn_id: str, receiver: socket.socket,
                 deadline: float | None = None,
                 clock=time.monotonic) -> None:
        self.id = turn_id
        self.receiver = receiver
        # F02: dictation accepted a caller deadline and then read it nowhere.
        # It is the same token type speech uses, so the budget reaches
        # preparation, recogniser construction and recording alike.
        self.stop = Cancellation(deadline, clock)
        self.thread: threading.Thread | None = None
        # TERM-04: held while a frame is fed and its partial sent, and taken
        # by stop-dictation before it replies, so a stop that has replied is
        # never followed by either.
        self.progress_lock = threading.Lock()

    @property
    def deadline(self) -> float | None:
        return self.stop.deadline

    @deadline.setter
    def deadline(self, value: float | None) -> None:
        self.stop.deadline = value

    def expired(self) -> bool:
        """True once the caller's budget has run out."""
        return self.stop.expired()


def _connect_dictation(path: str) -> socket.socket:
    """Connect to the dictation socket the kitty fork created for a pane."""
    try:
        info = os.lstat(path)
    except OSError as error:
        raise DaemonNotFound(
            f"the dictation socket {path} is not there: {error}. It is created "
            "by the kitty fork as <session>/dictate-<pane>.sock before it asks "
            "for dictation; start dictation from the terminal rather than by "
            "hand.") from error
    if not stat.S_ISSOCK(info.st_mode):
        raise DaemonNotFound(
            f"{path} is not a socket. Dictation is delivered to the socket the "
            "kitty fork creates for the pane; remove whatever is at that path "
            "and start dictation again.")
    failures = []
    for kind in _DICTATION_TYPES:
        endpoint = socket.socket(socket.AF_UNIX, kind)
        try:
            endpoint.settimeout(DATAGRAM_TIMEOUT_S)
            endpoint.connect(path)
            return endpoint
        except OSError as error:
            failures.append(f"{kind.name}: {error}")
            endpoint.close()
    raise DaemonNotFound(
        f"cannot connect to the dictation socket {path} "
        f"({'; '.join(failures)}). The pane that asked for dictation has "
        "probably gone away — start dictation again from a live pane.")


class Daemon:
    """The control socket, the request dispatch, and the two kinds of turn."""

    # File identity (st_dev, st_ino) of the bound control socket, recorded by
    # _bind. Class-level None: a daemon built without __init__ or never bound
    # has no control socket for a receiver to collide with.
    _socket_dev: int | None = None
    _socket_ino: int | None = None
    # P07/P11: settled job outcomes, and the turn the latest speech_error
    # belongs to. Class-level defaults: a daemon built without __init__ has no
    # ledger, and its turns still settle exactly once on their own.
    _jobs: jobs.JobLedger | None = None
    _speech_error_turn = ""
    # ING-02: the slots ingest-audio requests are read in, and how many are
    # in flight. Class-level None: a daemon built without __init__ answers
    # ingest-audio on the calling thread, as the unit tests' daemons do.
    _ingest_slots: threading.BoundedSemaphore | None = None
    _ingest_in_flight = 0

    def __init__(self, *, config_path: str | None = None,
                 idle_seconds: float | None = None,
                 verbose: bool = False) -> None:
        try:
            self._overrides = (daemon_config.load_overrides(config_path)
                               if config_path else {})
        except daemon_config.ConfigError as error:
            # Still a DaemonError to main() and to every existing caller.
            raise DaemonError(str(error)) from error
        self._verbose = verbose
        # One config object for the whole process, refreshed in place before
        # each turn: a Player built at the first speak request then reads the
        # device the settings name now rather than the one they named then.
        self._cfg: dict = {}
        self._refresh_config()
        if idle_seconds is None:
            idle_seconds = float(
                util.cfg_get(self._cfg, "daemon.idle_seconds", IDLE_SECONDS))
        self._idle_seconds = idle_seconds
        self._session_dir = paths.session_dir()
        self._socket_path = paths.control_socket()
        # Lock ordering: this lock is always taken before the arbiter's and
        # before the Player's, never the other way round. The barge-in hook
        # runs inside the arbiter's lock on a thread that already holds this
        # one, which is why it is an RLock.
        self._lock = threading.RLock()
        self._arbiter = Arbiter(self._session_dir,
                                cancel_speech=self._cancel_speech)
        self._player: audio.Player | None = None
        self._speech: _SpeechTurn | None = None
        self._dictation: _DictationTurn | None = None
        self._turns = 0
        self._socket: socket.socket | None = None
        self._socket_ino: int | None = None
        self._wake_r = -1
        self._wake_w = -1
        self._stopping = threading.Event()
        self._started_at = time.monotonic()
        self._last_activity = self._started_at
        # Speech is asynchronous: the request has already been acknowledged by
        # the time synthesis or playback can fail.  Keep the latest failure in
        # status so the Kilix chrome can surface it instead of leaving the only
        # explanation on this detached process's stderr.  The serial lets a
        # polling client show each failure exactly once.
        self._speech_error = ""
        self._speech_error_serial = 0
        self._ingest_slots = threading.BoundedSemaphore(MAX_INGEST_IN_FLIGHT)
        self._ingest_in_flight = 0
        # P07/P11: every accepted job's single terminal outcome, by job id.
        self._jobs = jobs.JobLedger()
        self._speech_error_turn = ""

    # -- logging ------------------------------------------------------------

    def _warn(self, message: str) -> None:
        """Report a failure on stderr. Never carries spoken or heard text."""
        print(f"kilix-voiced {_stamp()}: {message}", file=sys.stderr,
              flush=True)

    def _debug(self, message: str) -> None:
        if self._verbose:
            self._warn(message)

    def _report_speech_failure(self, turn: _SpeechTurn, message: str) -> None:
        """Publish one current-turn failure without retaining spoken text."""
        with self._lock:
            # A cancelled/replaced turn must not turn the new request red when
            # its worker finally unwinds.
            if self._speech is not turn or turn.cancel.is_set():
                return
            self._speech_error = message
            self._speech_error_serial += 1
            # P11: the failure is joinable to its job; the prose alone was not.
            self._speech_error_turn = turn.id
        self._warn(message)

    # -- configuration ------------------------------------------------------

    def _refresh_config(self) -> None:
        """Re-read the shared settings into the live config object."""
        # Built by daemon_config, which kilix-stt --grant-consent uses too:
        # the model directory consent is granted for must be the directory
        # this daemon's gate hashes, under every override (R6 finding 7).
        fresh = daemon_config.effective_config(self._overrides)
        # Replaced in place rather than rebound: the engines hold a reference
        # to this dict and read it per clip.
        self._cfg.clear()
        self._cfg.update(fresh)

    # -- lifecycle ----------------------------------------------------------

    def run(self) -> int:
        """Own the session, serve until idle or signalled, then clean up."""
        # Before the socket: a second daemon must never unlink the control
        # socket a live one is serving.
        self._arbiter.acquire_session()
        try:
            self._bind()
            self._install_signals()
            self._debug(f"listening on {self._socket_path}")
            self._serve()
        finally:
            self._shutdown()
        return 0

    def _bind(self) -> None:
        """Create the control socket, private to this user."""
        if not hasattr(socket, "SO_PEERCRED"):
            raise DaemonError(
                "this platform has no SO_PEERCRED, so the daemon cannot prove "
                "who is on the other end of a connection. kilix-voiced runs on "
                "Linux; there is no safe way to serve voice here.")
        self._clear_stale_socket()
        endpoint = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
        # bind() applies the umask and there is no way to fix the mode up on
        # the descriptor afterwards, so the mode is narrowed for the call
        # itself. No worker threads exist yet, which is what makes touching a
        # process-wide umask safe here.
        previous = os.umask(0o177)
        try:
            endpoint.bind(self._socket_path)
        except OSError as error:
            endpoint.close()
            raise DaemonError(
                f"cannot bind the control socket {self._socket_path}: "
                f"{error}. Check that {self._session_dir} exists and is "
                "writable, or point KILIX_SESSION_HOME at a directory that is."
            ) from error
        finally:
            os.umask(previous)
        try:
            os.chmod(self._socket_path, paths.SOCKET_MODE)
            bound = os.stat(self._socket_path)
            self._socket_ino = bound.st_ino
            self._socket_dev = bound.st_dev
            endpoint.listen(LISTEN_BACKLOG)
            endpoint.setblocking(False)
        except OSError as error:
            endpoint.close()
            raise DaemonError(
                f"cannot prepare the control socket {self._socket_path}: "
                f"{error}. Remove that file and start kilix-voiced again."
            ) from error
        self._socket = endpoint

    def _clear_stale_socket(self) -> None:
        """Remove a socket a killed daemon left behind, or explain what is."""
        try:
            info = os.lstat(self._socket_path)
        except FileNotFoundError:
            return
        except OSError as error:
            raise DaemonError(
                f"cannot inspect {self._socket_path}: {error}. Check the "
                "permissions on the session directory.") from error
        if not stat.S_ISSOCK(info.st_mode):
            raise DaemonError(
                f"{self._socket_path} exists and is not a socket. Remove it "
                "and start kilix-voiced again; that path belongs to the "
                "daemon's control socket.")
        # We hold the session lock, so nothing live is serving this one.
        try:
            os.unlink(self._socket_path)
        except OSError as error:
            raise DaemonError(
                f"cannot remove the stale control socket {self._socket_path}: "
                f"{error}. Delete it by hand and start kilix-voiced again."
            ) from error

    def _install_signals(self) -> None:
        """Ask for a clean shutdown on the usual stop signals."""
        self._wake_r, self._wake_w = os.pipe()
        os.set_blocking(self._wake_r, False)
        os.set_blocking(self._wake_w, False)
        # The handler only sets a flag — it must not write to stderr, which the
        # main thread may be holding the lock for — and the byte the interpreter
        # writes to the wakeup pipe is what gets select() out of its timeout.
        # Cleanup therefore runs on the accept loop, not in a signal handler.
        signal.set_wakeup_fd(self._wake_w)
        for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(number, self._on_signal)

    def _on_signal(self, _signum: int, _frame: object) -> None:
        self._stopping.set()

    def _serve(self) -> None:
        with selectors.DefaultSelector() as selector:
            selector.register(self._socket, selectors.EVENT_READ)
            selector.register(self._wake_r, selectors.EVENT_READ)
            while not self._stopping.is_set():
                # select() itself stays unguarded on purpose: a listening
                # socket that has died should end the daemon.
                for key, _mask in selector.select(timeout=ACCEPT_POLL_S):
                    try:
                        if key.fileobj is self._socket:
                            self._accept_one()
                        else:
                            self._drain_wakeups()
                    except Exception as error:
                        # The last net. No bytes a peer sends may end this
                        # loop, and a failure reaching here has already
                        # escaped every narrower guard. Only the type is
                        # logged: a message can carry request content.
                        self._warn(f"a connection failed unexpectedly "
                                   f"({type(error).__name__}); still serving")
                self._check_idle()

    def _drain_wakeups(self) -> None:
        try:
            os.read(self._wake_r, 4096)
        except OSError:
            pass  # nothing buffered, or the pipe is closing under us

    def _check_idle(self) -> None:
        if self._idle_seconds <= 0:
            return
        if self._busy():
            self._last_activity = time.monotonic()
            return
        if time.monotonic() - self._last_activity >= self._idle_seconds:
            self._debug(f"idle for {self._idle_seconds:.0f}s: exiting")
            self._stopping.set()

    def _busy(self) -> bool:
        with self._lock:
            for turn in (self._speech, self._dictation):
                if turn is not None and turn.thread is not None \
                        and turn.thread.is_alive():
                    return True
            if self._ingest_in_flight > 0:
                # An ingest request still being read is still owed its reply.
                return True
            return self._arbiter.speaking or self._arbiter.listening

    def _touch(self) -> None:
        with self._lock:
            self._last_activity = time.monotonic()

    def _shutdown(self) -> None:
        """Stop every turn, close the socket, and give up the session."""
        self._stopping.set()
        with self._lock:
            speech, dictation = self._speech, self._dictation
            player = self._player
        if dictation is not None:
            dictation.stop.set()
        if speech is not None:
            speech.cancel.set()
        if player is not None:
            player.close()
        for turn in (speech, dictation):
            if turn is not None and turn.thread is not None:
                turn.thread.join(timeout=JOIN_TIMEOUT_S)
        if self._socket is not None:
            self._socket.close()
            self._socket = None
        try:
            # Only our own socket: a successor that has already bound this path
            # must keep its own.
            if self._socket_ino is not None and \
                    os.stat(self._socket_path).st_ino == self._socket_ino:
                os.unlink(self._socket_path)
        except OSError:
            pass
        if self._wake_w >= 0:
            signal.set_wakeup_fd(-1)
            os.close(self._wake_w)
            os.close(self._wake_r)
            self._wake_w = self._wake_r = -1
        self._arbiter.release()

    # -- connections --------------------------------------------------------

    def _peer_uid(self, conn: socket.socket) -> int:
        """Return the uid of the process on the other end of ``conn``."""
        try:
            raw = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                  _UCRED.size)
        except OSError as error:
            raise DaemonError(
                f"cannot read the peer's credentials: {error}. Refusing the "
                "connection; kilix-voiced only serves connections it can "
                "attribute to a user.") from error
        _pid, uid, _gid = _UCRED.unpack(raw)
        return uid

    def _accept_one(self) -> None:
        try:
            conn, _address = self._socket.accept()
        except (BlockingIOError, InterruptedError):
            return
        except OSError as error:
            if not self._stopping.is_set():
                self._warn(f"cannot accept a connection: {error}")
            return
        # Owns every descriptor that arrives with the request, from the read
        # until this connection is done, on every path: an op that takes none
        # ignores them, and none outlives the reply.
        inbound = _ReceivingConnection(conn, audiofd.MAX_INBOUND_FDS)
        reply = None
        try:
            conn.settimeout(REQUEST_TIMEOUT_S)
            reply = self._answer(inbound)
        except Exception as error:
            # BaseException still propagates: a signal or SystemExit keeps its
            # meaning. Only the type is logged, never the message, which can
            # carry what the request said.
            self._warn(f"a connection failed unexpectedly "
                       f"({type(error).__name__}); still serving")
            reply = None
        if isinstance(reply, _Deferred):
            refusal = self._hand_off(conn, inbound, reply)
            if refusal is None:
                return                  # the ingest thread owns the connection
            reply = refusal
        self._finish(conn, inbound, reply)

    def _hand_off(self, conn: socket.socket, inbound: _ReceivingConnection,
                  deferred: _Deferred) -> dict | None:
        """Answer ``deferred`` on a thread of its own; a refusal if it cannot be.

        ING-02. The thread owns the connection and the request's descriptors
        from here on, and _finish closes both. When MAX_INGEST_IN_FLIGHT
        requests are already being read, or no thread will start, the refusal
        is returned for the accept loop to send at once.
        """
        slots = self._ingest_slots
        if not slots.acquire(blocking=False):
            return protocol.reply_error(
                f"kilix-voiced is already reading {MAX_INGEST_IN_FLIGHT} "
                "ingest-audio requests, so this one was not read. Send it again "
                "once one of those has been answered.", protocol.ERR_BUSY)

        def answer() -> None:
            try:
                try:
                    reply = deferred()
                except Exception as error:
                    self._warn(f"unhandled failure in {protocol.OP_INGEST_AUDIO} "
                               f"({type(error).__name__})")
                    reply = protocol.reply_error(
                        f"kilix-voiced could not handle {protocol.OP_INGEST_AUDIO}. "
                        "This is a bug; the daemon is still running.")
                self._finish(conn, inbound, reply)
            finally:
                with self._lock:
                    self._ingest_in_flight -= 1
                slots.release()

        with self._lock:
            self._ingest_in_flight += 1
        try:
            threading.Thread(target=answer, name="kilix-voice-ingest",
                             daemon=True).start()
        except RuntimeError as error:
            with self._lock:
                self._ingest_in_flight -= 1
            slots.release()
            return protocol.reply_error(
                f"cannot start a thread to read the audio: {error}. This machine "
                "is out of threads or memory; try again later.",
                protocol.ERR_UNAVAILABLE)
        return None

    def _finish(self, conn: socket.socket, inbound: _ReceivingConnection,
                reply: dict | None) -> None:
        """Send ``reply`` on ``conn``, then close it and every descriptor it held."""
        with conn:
            try:
                if reply is None:
                    return
                # Bounded before it is sent. Four same-user requests below
                # MAX_REQUEST_BYTES built refusals too large to encode, and the
                # MessageTooLarge that raised here ended the serve loop -- one
                # request, and the voice session was gone.
                frame, fds = _reply_frame(reply)
                try:
                    _transmit(conn, frame, fds, channel=_CHANNEL_REPLY)
                except OSError as error:
                    self._debug(f"client left before the reply: {error}")
                    return
                self._linger_for_peer(conn)
            except Exception as error:
                # Only the type is logged, as in _accept_one.
                self._warn(f"a connection failed unexpectedly "
                           f"({type(error).__name__}); still serving")
            finally:
                inbound.close_descriptors()
                # A reply's descriptors were duplicated into the peer by
                # sendmsg, or never sent; either way this copy is ours.
                for fd in getattr(reply, "fds", ()):
                    try:
                        os.close(fd)
                    except OSError:
                        pass

    def _linger_for_peer(self, conn: socket.socket) -> None:
        """Let a peer that sent more than was read see the reply before close.

        Closing an AF_UNIX SEQPACKET connection with a record still unread
        makes the peer's NEXT recv fail with ECONNRESET, ahead of the reply
        already queued for it; the reply is readable only on a second recv.
        That hits exactly the peers a refusal is for: a client that split one
        frame across two records, and a non-owner whose request is never read
        at all. kilix_voice.py logs the OSError and gives up, and speech.c
        counts it a bad reply, so neither ever saw the refusal.

        So when FIONREAD says a record is still queued, wait -- up to
        REFUSAL_LINGER_S -- for the peer to hang up, without reading what it
        sent: the daemon must still never read a non-owner's request. POLLHUP
        and POLLERR are always reported, so the wait ends the moment the peer
        closes. A connection with nothing unread returns at once.
        """
        try:
            unread = struct.unpack("i", fcntl.ioctl(
                conn.fileno(), termios.FIONREAD, b"\0\0\0\0"))[0]
        except (OSError, ValueError):
            return
        if unread <= 0:
            return
        poller = select.poll()
        poller.register(conn.fileno(), select.POLLRDHUP)
        try:
            poller.poll(int(REFUSAL_LINGER_S * 1000))
        except OSError:
            pass

    def _answer(self, conn: socket.socket) -> dict | None:
        """Return the reply for one connection, or None to just hang up."""
        # The session directory is 0700, so the kernel already refuses a
        # connect() from another user — but a mode that slips, a directory
        # restored from a backup, or a session home pointed somewhere shared
        # would silently turn this daemon into a service that reads other
        # people's text aloud and hands them the microphone. The uid is the
        # only fact that ties a request to a person, so it is checked on every
        # connection rather than assumed from the filesystem.
        try:
            uid = self._peer_uid(conn)
        except DaemonError as error:
            self._warn(str(error))
            return None
        if uid != os.geteuid():
            self._warn(f"refused a connection from uid {uid}")
            return protocol.reply_error(
                f"this kilix-voiced serves uid {os.geteuid()} only, and you "
                f"are uid {uid}. Start your own daemon: voice sessions are per "
                "user and are never shared.", protocol.ERR_DENIED)
        try:
            raw = conn.recv(MAX_REQUEST_BYTES + 1)
        except socket.timeout:
            self._debug("a client connected and sent nothing")
            return None
        except OSError as error:
            self._debug(f"client vanished before sending: {error}")
            return None
        if not raw:
            return None
        if len(raw) > MAX_REQUEST_BYTES:
            return protocol.reply_error(
                f"the request is larger than {MAX_REQUEST_BYTES} bytes. Read a "
                f"smaller extent by lowering {settings.KEY_TTS_MAX_CHARS}, or "
                "send the text as several speak requests.",
                protocol.ERR_TOO_LARGE)
        if isinstance(conn, _ReceivingConnection) and (conn.fds or conn.truncated):
            return self._dispatch(raw, tuple(conn.fds), conn.truncated)
        return self._dispatch(raw)

    def _dispatch(self, raw: bytes, fds: tuple[int, ...] = (),
                  truncated: bool = False) -> dict:
        """Answer one request frame.

        ``fds`` are the SCM_RIGHTS descriptors that arrived with it. They are
        still owned by _accept_one, which closes them. ``truncated`` says the
        caller sent more than audiofd.MAX_INBOUND_FDS. Only an op that takes a
        descriptor reads either; every other op is served as if none had been
        sent.
        """
        try:
            request = protocol.validate_request(protocol.decode(raw),
                                                self._session_dir)
        except protocol.ProtocolError as error:
            # MALFORMED-GAP: this arm coded every caller mistake `internal`,
            # telling a client with a typo that the daemon had a bug. A frame
            # the validator refuses is malformed unless the refusal says more
            # precisely what it is: too-large, or unsupported for an unknown
            # op or an incompatible protocol major.
            return protocol.reply_error(
                str(error), _carried_code(error, protocol.ERR_MALFORMED),
                **(getattr(error, "fields", None) or {}))
        except Exception as error:
            # decode and validate_request are meant to raise only
            # ProtocolError for anything a caller sends. Three payloads proved
            # otherwise -- a 5000-digit integer, a lone surrogate in a path,
            # nesting past the recursion limit -- and each escaped this arm.
            # Those are fixed at their source; this is the net for the next.
            self._warn(f"could not read a request ({type(error).__name__})")
            return protocol.reply_error(
                "kilix-voiced could not read that request. This is a bug -- "
                "the daemon is still running, and its stderr names the "
                "failure.", protocol.ERR_INTERNAL)
        self._touch()
        handlers: dict[str, Callable[[dict], dict]] = {
            protocol.OP_SPEAK: self._op_speak,
            protocol.OP_STOP_SPEECH: self._op_stop_speech,
            protocol.OP_DICTATE: self._op_dictate,
            protocol.OP_STOP_DICTATION: self._op_stop_dictation,
            protocol.OP_STATUS: self._op_status,
            # The one op that reads the descriptors its request arrived with.
            protocol.OP_INGEST_AUDIO: lambda request: self._op_ingest_audio(
                request, fds, truncated),
        }
        handler = handlers[request["op"]]
        if request["op"] == protocol.OP_INGEST_AUDIO and self._ingest_slots is not None:
            # ING-02: read off the accept loop; see _Deferred.
            return _Deferred(lambda: self._run_handler(request, handler))
        return self._run_handler(request, handler)

    def _run_handler(self, request: dict,
                     handler: Callable[[dict], dict]) -> dict:
        """Return ``handler``'s reply to ``request``, a failure coded as a refusal."""
        try:
            return handler(request)
        except (DaemonError, ArbiterError, audio.AudioError, tts_lib.TtsError,
                stt_lib.SttError, settings.SettingsError,
                paths.PathError) as error:
            # These are refusals, not faults: a turn already running, a
            # capability switched off, a socket that is not there. Each carries
            # its own code; a family member without one is `unavailable`,
            # which is what the dictation worker codes the same family.
            # ERR_INTERNAL is left to the arm below, which is where a genuine
            # handler bug lands.
            return protocol.reply_error(
                str(error), _carried_code(error, protocol.ERR_UNAVAILABLE))
        except Exception as error:  # a handler bug must not take the daemon
            self._warn(f"unhandled failure in {request['op']}: {error!r}")
            return protocol.reply_error(
                f"kilix-voiced could not handle {request['op']}: {error}. "
                "This is a bug — the daemon is still running, and its stderr "
                "has the details.")

    def _op_ingest_audio(self, request: dict, fds: tuple[int, ...] = (),
                         truncated: bool = False) -> dict:
        """A01/A08: normalise audio a caller handed over by descriptor.

        The reply carries a canonical s16le mono WAV as a sealed, read-only
        descriptor (audio_fd 0), with metadata that matches its bytes. It is
        answered on the control connection, from a thread of its own on a
        daemon that serves (ING-02; see _Deferred). No turn, microphone,
        arbiter claim, consent gate or model is involved, since nothing is
        captured or recognised, and the read is bounded in bytes and time.
        A refusal is not a job; its reply is its only outcome.
        """
        # The budget starts HERE, as every other handler's does.
        deadline_ms = request.get("deadline_ms")
        deadline = (time.monotonic() + deadline_ms / 1000.0
                    if deadline_ms is not None else None)
        if deadline is not None and time.monotonic() >= deadline:
            return protocol.reply_error(
                f"the request deadline of {deadline_ms} ms elapsed before the "
                "audio could be read; nothing was read.", protocol.ERR_DEADLINE)
        if truncated or len(fds) != 1:
            carried = f"more than {len(fds)}" if truncated else str(len(fds))
            return protocol.reply_error(
                f"ingest-audio takes exactly one audio descriptor, attached by "
                f"SCM_RIGHTS, and this request carried {carried}. Attach the "
                "read end of a pipe, a regular file or a memfd.",
                protocol.ERR_MALFORMED)
        try:
            data = audiofd.read_descriptor(
                fds[0], byte_limit=request.get("byte_limit", protocol.MAX_AUDIO_BYTES),
                deadline=deadline)
            audio = audio_input.normalize(data, request)
            wav = util.write_wav(audio.pcm, audio.sample_rate)
            if deadline is not None and time.monotonic() >= deadline:
                # The delivery boundary, as dictation has one: a result the
                # caller has given up on is not handed back as a success.
                return protocol.reply_error(
                    f"the request deadline of {deadline_ms} ms elapsed while the "
                    "audio was normalised; nothing is returned.",
                    protocol.ERR_DEADLINE)
            fd = audiofd.sealed_readonly(wav)
        except (audiofd.DescriptorError, audio_input.AudioInputError) as error:
            return protocol.reply_error(str(error), error.code)
        try:
            job = self._next_turn_id("ingest")
            if self._jobs is not None:
                self._jobs.record(jobs.JobOutcome(
                    job=job, kind=jobs.KIND_INGEST,
                    outcome=jobs.OUTCOME_COMPLETED, code=None))
            self._touch()
            return _Outbound(protocol.reply_ok(
                request["id"], job=job, media_type=protocol.AUDIO_MEDIA_TYPE,
                sample_format=protocol.SAMPLE_FORMATS[0], channels=1,
                sample_rate=audio.sample_rate, pcm_bytes=len(audio.pcm),
                byte_length=len(wav), duration_ms=audio.duration_ms,
                sha256=hashlib.sha256(wav).hexdigest(), audio_fd=0), fds=(fd,))
        except BaseException:
            # Handed to _accept_one only inside a reply; anything short of
            # that must not leave the sealed copy open.
            os.close(fd)
            raise

    def _refuse_own_control_socket(self, path: str, field: str) -> None:
        """Refuse a receiver that is this daemon's own control socket.

        Compared by file identity, not by name: a hard link to control.sock, or
        a symlink inside the session resolved to it, reaches the same listener
        under another path. A path that cannot be stat'ed is left to
        _connect_dictation, which says what is missing.
        """
        if self._socket_ino is None or self._socket_dev is None:
            return
        try:
            info = os.stat(path)
        except OSError:
            return
        if (info.st_dev, info.st_ino) == (self._socket_dev, self._socket_ino):
            raise DaemonRefusedReceiver(
                f"'{field}' names {path}, which is kilix-voiced's own control "
                "socket, not a receiver. Name a socket your client bound to "
                "receive datagrams, such as the kitty fork's "
                "<session>/dictate-<pane>.sock.")

    def _next_turn_id(self, kind: str) -> str:
        with self._lock:
            self._turns += 1
            return f"{kind}-{self._turns}"

    # -- speak --------------------------------------------------------------

    def _op_speak(self, request: dict) -> dict:
        # The budget starts HERE, before configuration refresh, engine
        # construction and text splitting. Computing it after preparation gave
        # every request a fresh full budget no matter how long preparation
        # took -- an independent review measured a 1 s preparation still
        # handing out a full 20 ms budget.
        deadline_ms = request.get("deadline_ms")
        deadline = (time.monotonic() + deadline_ms / 1000.0
                    if deadline_ms is not None else None)
        self._refresh_config()
        engine = tts_lib.make_tts(
            self._cfg, model=request.get("model"), voice=request.get("voice"),
            rate=request.get("rate"))
        if isinstance(engine, tts_lib.EspeakTts):
            # A PATH lookup that launches nothing: better to answer "no
            # synthesiser, install this" now than to accept the request and
            # fail where only the daemon's stderr can see it.
            tts_lib.build_synth_cmd(self._cfg, voice=engine.voice,
                                    rate=engine.rate)
        elif isinstance(engine, tts_lib.PiperTts):
            # The provider status contract loads no model and starts no
            # service, but confirms both the isolated runtime and pinned
            # Kristin artifacts before this request is acknowledged.
            # R4 finding 2: this probe has its own 5 s ceiling, which could
            # outlive a sub-second request. It runs before the turn exists, so
            # the budget is computed from the deadline taken at entry.
            probe_budget = (None if deadline is None
                            else max(0.0, deadline - time.monotonic()))
            # R5 finding A: a Piper request whose budget died in the probe was
            # reported as an internal daemon bug, while the identical request
            # on espeak correctly said ERR_DEADLINE. A spent budget refuses
            # here, before any probe process is started for it.
            if probe_budget is not None and probe_budget <= 0:
                return protocol.reply_error(
                    f"the request deadline of {deadline_ms} ms elapsed before "
                    "the speech provider could be checked; nothing was spoken.",
                    protocol.ERR_DEADLINE)
            try:
                engine.check_available(budget=probe_budget)
            except tts_lib.TtsDeadlineExceeded:
                # R6 finding 1: the fix for R5 finding A attributed ANY probe
                # failure to the deadline whenever the budget was under the
                # probe's 5 s ceiling, so "not installed, run X" became "the
                # deadline elapsed". The probe itself now says, as a type,
                # when the caller's budget is what cut it short. Every other
                # TtsError propagates with the provider's own diagnosis and its
                # own code.
                return protocol.reply_error(
                    f"the request deadline of {deadline_ms} ms elapsed "
                    "while checking the speech provider; nothing was "
                    "spoken.", protocol.ERR_DEADLINE)
        chunks = self._speech_chunks(request["text"])
        if not chunks:
            # A pane of nothing but box drawing conditions down to nothing;
            # silence is the right rendering of that, not a failure.
            return protocol.reply_ok(
                request["id"], chunks=0, model=engine.model,
                voice=_reply_voice(engine), rate=engine.rate)
        turn = _SpeechTurn(self._next_turn_id("speak"), chunks, engine, deadline)
        if request.get("chunk_sock"):
            self._refuse_own_control_socket(request["chunk_sock"], "chunk_sock")
            turn.receiver = _connect_dictation(request["chunk_sock"])
        # F07: the chunk receiver is connected before the expiry check, the
        # arbiter claim and the worker start, but only _run_speech ever closed
        # it. Every path that fails before the worker owns the turn -- an
        # expired budget, an arbiter refusal, a thread the OS will not start --
        # left the descriptor to reference counting or, once the Thread and
        # the turn referenced each other, to cyclic collection. Ownership now
        # transfers exactly once, and until it does this frame owns it.
        handed_off = False
        try:
            if turn.expired():
                # Refuse before any work starts. A budget that has already run
                # out by the time we get here must not produce audio nobody is
                # waiting for -- P08 is about not starting, not only stopping.
                return protocol.reply_error(
                    f"the request deadline of {deadline_ms} ms elapsed before "
                    "synthesis could start; nothing was spoken.",
                    protocol.ERR_DEADLINE)
            turn.thread = threading.Thread(
                target=self._run_speech, args=(turn,),
                name=f"kilix-voice-{turn.id}", daemon=True)
            # P11: a subscriber that declared minor 2 or later opted in to
            # the terminal message after its last descriptor.
            minor = protocol.declared_minor(request)
            turn.terminal_events = minor is not None and minor >= 2
            ledger = self._jobs
            if ledger is not None:
                # Hooked BEFORE the worker starts: a worker can settle the job
                # before _start even returns, and that outcome must still be
                # recorded.
                turn.on_settle = ledger.record
            with self._lock:
                self._cancel_speech()      # a new read replaces the old one
                self._speech_error = ""
                self._speech_error_turn = ""
                self._arbiter.begin_speech(turn.id)
                self._speech = turn
                self._start(turn.thread, self._cancel_speech)
                # Set INSIDE the lock and only after _start returned: the
                # worker is running and its `finally` is now guaranteed to run.
                handed_off = True
                if ledger is not None:
                    # After _start, so a worker the OS refused never becomes a
                    # job. A no-op when the worker has already settled, so a
                    # finished job is never put back to running.
                    ledger.begin(turn.id, jobs.KIND_SPEECH)
            return protocol.reply_ok(
                request["id"], turn=turn.id, chunks=len(chunks),
                model=engine.model, voice=_reply_voice(engine), rate=engine.rate)
        finally:
            if not handed_off and turn.receiver is not None:
                try:
                    turn.receiver.close()
                finally:
                    turn.receiver = None

    def _speech_chunks(self, text: str) -> list[str]:
        """Condition pane text and split it into clips worth synthesising."""
        return tts_lib.speech_chunks(
            text, max_chars=settings.tts_max_chars())

    def _op_stop_speech(self, request: dict) -> dict:
        with self._lock:
            stopped = self._speech is not None
            self._cancel_speech()
        return protocol.reply_ok(request["id"], stopped=stopped)

    def _cancel_speech(self) -> None:
        """Silence the speakers now. Also the arbiter's barge-in hook."""
        with self._lock:
            turn, self._speech = self._speech, None
            player = self._player
        if turn is not None:
            turn.cancel.set()
            turn.engine.cancel()
            self._arbiter.end_speech(turn.id)
        if player is not None:
            # Kills the sink outright rather than draining it: barge-in has to
            # land inside ~100 ms, not at the end of the current sentence.
            player.stop()

    def _get_player(self) -> audio.Player:
        with self._lock:
            if self._player is None:
                self._player = audio.Player(self._cfg)
            return self._player

    def _run_speech(self, turn: _SpeechTurn) -> None:
        """Synthesise and play one turn, one clip ahead of the speakers."""
        player: audio.Player | None = None
        try:
            player = self._get_player()
            # The next clip is synthesised while the current one plays: enough
            # to hide synthesis latency between sentences, and never more than
            # two clips of audio held for what could be a whole scrollback.
            pending = self._synth(turn, turn.chunks[0])
            index = 1
            while pending is not None and not turn.cancel.is_set():
                pcm, rate = pending
                # The provenance _synth read for THIS clip. The next clip is
                # synthesised before this one finishes playing, so reading the
                # engine at publish time would be right only by ordering luck.
                provenance = getattr(pending, "provenance", None)
                pending = None
                if not self._play_if_current(turn, player, pcm, rate,
                                             provenance):
                    break
                if index < len(turn.chunks):
                    pending = self._synth(turn, turn.chunks[index])
                    index += 1
                if not self._await_clip(turn, player):
                    break
            if turn.cancel.reason() == "deadline":
                self._report_speech_failure(
                    turn, "read-aloud stopped: the request deadline elapsed.")
            elif player.error:
                self._report_speech_failure(turn, player.error)
        # Each arm also records WHY the job failed, for the one outcome the
        # finally below settles. The status prose is exactly what it was.
        except tts_lib.TtsDeadlineExceeded:
            # The same words the expiry check above uses: a synthesis the
            # budget cut is the deadline, however the engine phrased it.
            message = "read-aloud stopped: the request deadline elapsed."
            turn.failure = (jobs.OUTCOME_DEADLINE, protocol.ERR_DEADLINE, message)
            self._report_speech_failure(turn, message)
        except tts_lib.TtsError as error:
            message = f"read-aloud stopped: {error}"
            turn.failure = (jobs.OUTCOME_FAILED,
                            _carried_code(error, protocol.ERR_UNAVAILABLE), message)
            self._report_speech_failure(turn, message)
        except Exception as error:  # a worker thread must not die silently
            message = f"read-aloud failed: {error!r}"
            # A device, settings or path failure is `unavailable`, as the
            # control path codes it; an over-size clip carries too-large on
            # its class; anything else is a bug.
            refusal = isinstance(error, (audio.AudioError, settings.SettingsError,
                                         paths.PathError, OSError))
            turn.failure = (jobs.OUTCOME_FAILED, _carried_code(
                error, protocol.ERR_UNAVAILABLE if refusal else protocol.ERR_INTERNAL),
                message)
            self._report_speech_failure(turn, message)
        finally:
            with self._lock:
                mine = self._speech is turn
                if mine:
                    self._speech = None
            # F01: releasing ownership never stopped the audio. The Player is a
            # separate worker draining its own queue, so an expired turn kept
            # speaking after the daemon had reported it stopped -- the commit
            # titled "stop playback on expiry" did not do so.
            #
            # The identity guard is the whole subtlety: `mine` was read under
            # the lock, so a worker whose turn has already been REPLACED will
            # not silence its successor's audio. Only a turn that still owned
            # the player when it finished may stop it.
            if mine and player is not None and turn.cancel.done():
                try:
                    player.stop()
                except Exception as error:      # never mask the real failure
                    self._warn(
                        f"could not stop playback for turn {turn.id}: {error!r}")
            # P11: this job's one terminal outcome, decided HERE and nowhere
            # else, the first cause first, and settled before the receiver
            # closes so a 1.2 subscriber's stream can end with it. Cancel and
            # deadline come from the token's reason(): whichever came first.
            try:
                failure = getattr(turn, "failure", None)
                why = turn.cancel.reason()
                if failure is not None:
                    outcome, code, message = failure
                elif why == "cancelled":
                    outcome, code, message = (jobs.OUTCOME_CANCELLED,
                                              protocol.ERR_CANCELLED,
                                              "read-aloud was stopped.")
                elif why == "deadline":
                    outcome, code, message = (
                        jobs.OUTCOME_DEADLINE, protocol.ERR_DEADLINE,
                        "read-aloud stopped: the request deadline elapsed.")
                elif player is not None and player.error:
                    outcome, code, message = (jobs.OUTCOME_FAILED,
                                              protocol.ERR_UNAVAILABLE,
                                              str(player.error))
                else:
                    outcome, code, message = jobs.OUTCOME_COMPLETED, None, ""
                if outcome == jobs.OUTCOME_FAILED and code in (
                        protocol.ERR_CANCELLED, protocol.ERR_DEADLINE):
                    code = protocol.ERR_INTERNAL      # never a failure in disguise
                settled = jobs.JobOutcome(
                    job=turn.id, kind=jobs.KIND_SPEECH, outcome=outcome,
                    code=code, message=message,
                    chunks_published=turn.chunks_published,
                    subscriber_lost=turn.subscriber_lost)
                terminal = None
                if (turn.terminal_events and turn.receiver is not None
                        and not turn.subscriber_lost):
                    # SEND-01 and P11: built and guarded before the job
                    # settles, and the job settles as the terminal states it,
                    # so what the subscriber receives and what status reports
                    # cannot disagree.
                    terminal = self._speech_terminal(settled)
                    settled = _outcome_as_sent(settled, terminal)
                if turn.settle(settled) and terminal is not None:
                    self._send(turn.receiver, terminal)
            except Exception as error:
                # The device is still released below, whatever went wrong.
                self._warn(f"could not settle turn {turn.id} "
                           f"({type(error).__name__})")
            if turn.receiver is not None:
                try:
                    turn.receiver.close()
                finally:
                    turn.receiver = None
            self._arbiter.end_speech(turn.id)
            self._touch()

    def _speech_terminal(self, outcome: jobs.JobOutcome) -> dict:
        """Return the one terminal a protocol-1.2 subscriber is sent for ``outcome``.

        Built by protocol.job_terminal and guarded as _transmit guards it,
        before the job settles. A terminal that does not state this outcome --
        its code missing or not closed, or the job ending some other way --
        and one that cannot be built or encoded at all, becomes the job's
        failed, internal terminal, and _outcome_as_sent settles the job the
        same way.
        """
        try:
            built = protocol.job_terminal(outcome)
        except Exception as error:
            self._warn(f"could not build the terminal of turn {outcome.job} "
                       f"({type(error).__name__})")
            built = None
        terminal = None
        if isinstance(built, dict) and built.get("terminal") is True:
            terminal = _guard_message(built)
            if ((terminal.get("outcome"), terminal.get("code"))
                    != (outcome.outcome, outcome.code)):
                terminal = _guard_message(dict(
                    terminal, outcome=jobs.OUTCOME_FAILED, code=protocol.ERR_INTERNAL))
            try:
                _message_frame(terminal)
            except protocol.ProtocolError:
                terminal = None
        if terminal is None:
            terminal = {"terminal": True, "job": outcome.job, "kind": outcome.kind,
                        "outcome": jobs.OUTCOME_FAILED,
                        "chunks": outcome.chunks_published,
                        "code": protocol.ERR_INTERNAL, "error": _UNBUILDABLE_TERMINAL}
        return terminal

    def _synth(self, turn: _SpeechTurn,
               chunk: str) -> tuple[bytes, int] | None:
        """Synthesise one clip, unless cancelled or out of budget."""
        if turn.cancel.done():
            return None
        # F01: the engine used its OWN timeout -- about 20 s plus text cost for
        # eSpeak, 210 s for Piper -- no matter how little caller budget was
        # left, and no deadline poll can run while that synchronous call is in
        # progress. Hand it the remaining budget so a 210 s engine ceiling
        # cannot outlive a 2 s request.
        pcm, rate = turn.engine.synth(chunk, budget=turn.cancel.remaining())
        # A13: read HERE, on the worker thread, straight after the synth that
        # produced this clip. The engine is the turn's own and only this
        # worker calls synth, so nothing can overwrite it in between.
        provenance = tts_lib.clip_provenance(turn.engine)
        # A06 reaches real output here, not only the helper's unit tests. An
        # engine that returns an absurd clip is refused rather than queued:
        # playing a truncated prefix would be a wrong answer wearing a success.
        protocol.check_audio_bytes(len(pcm))
        return _Clip(pcm, rate, provenance)

    def _play_if_current(self, turn: _SpeechTurn, player: audio.Player,
                         pcm: bytes, rate: int,
                         provenance: tts_lib.SynthesisProvenance | None = None
                         ) -> bool:
        """Queue a clip unless this turn was cancelled or already replaced.

        ``provenance`` is what _synth recorded for this clip. A caller that
        has none gets the engine's own description at publish time.
        """
        with self._lock:
            if turn.cancel.is_set() or self._speech is not turn:
                return False
            if turn.expired():
                # Stop DELIVERY too, not just generation: a clip synthesised
                # just before the budget ran out must not still be played.
                return False
            player.play(pcm, rate)
            self._publish_chunk(turn, pcm, rate,
                                provenance or tts_lib.clip_provenance(turn.engine))
            return True

    def _publish_chunk(self, turn: _SpeechTurn, pcm: bytes, rate: int,
                       provenance: tts_lib.SynthesisProvenance | None = None
                       ) -> None:
        """Emit one A12-A15 chunk descriptor as the clip is queued.

        Queued, not finished: A15 asks for bounded playable audio to arrive
        BEFORE the whole utterance completes, so the descriptor is published at
        the moment the clip enters the player rather than after it drains.

        The samples never ride in the JSON -- only their length, which goes
        through the A06 check. A caller that did not name a socket gets nothing
        and pays nothing.
        """
        # The ordinal is the CLIP's, taken before anything can fail. Deriving it
        # from descriptor success made a failed build leave the counter behind
        # the real position, so later sequences lagged and the true last clip
        # could go unmarked -- R3 F05.
        ordinal = turn.sequence
        turn.sequence += 1
        if turn.receiver is None or turn.subscriber_lost:
            # Nobody asked, or the subscriber has gone or fallen behind: its
            # stream already has a gap, and resuming would hand it clips out
            # of order. The clip still plays.
            return
        final = ordinal == len(turn.chunks) - 1
        # A13: the family and voice that ACTUALLY produced this clip, as the
        # engine recorded them and _synth carried them here. The old read of
        # engine.effective_model was true only of a Mock -- no real engine had
        # that attribute -- so the mbrola fallback was reported as mbrola. A
        # caller with no carried provenance gets the engine's own description.
        prov = provenance or tts_lib.clip_provenance(turn.engine)
        # A15: the bytes the local player plays -- it drops a trailing half
        # sample -- so the subscriber's copy is identical to the queued clip.
        data = pcm[:len(pcm) - len(pcm) % 2]
        try:
            wav = util.write_wav(data, rate)
            chunk = protocol.synthesis_chunk(
                ordinal, pcm_bytes=len(data), sample_rate=rate,
                voice=prov.voice,
                model=prov.model,
                # A14: the seed and settings the engine was actually given, from
                # its own record. A clip with no seed to report -- Piper's, whose
                # noise is unseeded -- carries none; seed_consumed and
                # reproducible say whether a seed that is there means anything.
                seed=prov.seed,
                final=final, audio_fd=0, media_type=protocol.AUDIO_MEDIA_TYPE,
                byte_length=len(wav), sha256=hashlib.sha256(wav).hexdigest(),
                turn=turn.id,
                rate_wpm=prov.rate_wpm,
                seed_consumed=prov.seed_consumed,
                reproducible=prov.reproducible)
        except ValueError as error:
            # A malformed descriptor must not take the audio down with it.
            # The ordinal, not turn.sequence: the counter has already moved on
            # to the next clip, so it named the wrong one.
            self._warn(f"synthesis chunk {ordinal} of turn {turn.id} not "
                       f"published: {error}")
            return
        try:
            fd = audiofd.sealed_readonly(wav)
        except audiofd.DescriptorError as error:
            # No descriptor is ever sent without its audio. The subscription
            # ends; the clip plays on.
            turn.subscriber_lost = True
            turn.delivery_error = error.code
            self._warn(f"synthesis chunk {ordinal} of turn {turn.id}: its audio "
                       f"could not be attached, so the subscription ends: {error}")
            return
        try:
            # Called with self._lock held, so it must not wait: MSG_DONTWAIT
            # returns at once whether the subscriber is not keeping up (EAGAIN)
            # or has gone (EPIPE, ECONNREFUSED, ETOOMANYREFS). A stop-speech or
            # barge-in waiting on this lock is never held up by a subscriber.
            delivered = self._send(turn.receiver,
                                   _Outbound(chunk, fds=(fd,), nonblocking=True))
        except protocol.ProtocolError as error:
            # _send refuses a datagram over MAX_REPLY_BYTES; a descriptor too
            # large to deliver is skipped like a malformed one.
            self._warn(f"synthesis chunk {ordinal} of turn {turn.id} not "
                       f"published: {error}")
            return
        finally:
            os.close(fd)
        if delivered:
            turn.chunks_published += 1
        else:
            # R3 F05: a subscriber that cannot take the descriptor is recorded
            # in the job's outcome instead of ignored, and is not sent to again.
            turn.subscriber_lost = True
            turn.delivery_error = protocol.ERR_UNAVAILABLE

    def _await_clip(self, turn: _SpeechTurn, player: audio.Player) -> bool:
        """Wait out the queued clip; False when the turn was cancelled."""
        while player.playing:
            # wait_done clips the wait to the remaining budget, so expiry wakes
            # the caller AT the deadline instead of up to one poll interval
            # past it -- the difference between honouring a deadline and
            # rounding it. It also covers the case the old code needed a
            # second explicit check for: cancel and expiry are one question.
            if turn.cancel.wait_done(SPEECH_POLL_S):
                return False
        return not turn.cancel.done()

    # -- dictate ------------------------------------------------------------

    def _op_dictate(self, request: dict) -> dict:
        # F02: protocol.validate_request preserved deadline_ms for every
        # operation and dictation read it nowhere, so a caller's budget was
        # accepted and silently ignored. Taken FIRST, like speak's, so
        # preparation is spent from the budget rather than before it starts.
        deadline_ms = request.get("deadline_ms")
        deadline = (time.monotonic() + deadline_ms / 1000.0
                    if deadline_ms is not None else None)
        self._refresh_config()
        engine = str(util.cfg_get(self._cfg, "stt.engine", "")).strip().lower()
        if engine == stt_lib.ENGINE_OFF:
            raise DaemonUnavailable(
                f"dictation is switched off ({settings.KEY_STT_ENGINE}=off), "
                "so the microphone is not opened. Set "
                f"{settings.KEY_STT_ENGINE}={stt_lib.ENGINE_VOSK} in the "
                "shared settings, or in kilix-stt, to enable it.")
        if self._arbiter.listening:
            raise DaemonBusy(
                "dictation is already running. Send stop-dictation first; one "
                "turn owns the microphone at a time.")
        # Connected here rather than in the worker so that an unreachable
        # socket is answered on this connection: the turn's own socket is the
        # only channel it has, and a caller told "ok" would wait for a
        # datagram that can never arrive. Nothing has been claimed yet, so a
        # failure leaves read-aloud playing.
        self._refuse_own_control_socket(request["sock"], "sock")
        receiver = _connect_dictation(request["sock"])
        turn = _DictationTurn(self._next_turn_id("listen"), receiver, deadline)
        if turn.expired():
            # Same rule speak already followed: a budget spent before the
            # microphone opens must not open it.
            receiver.close()
            return protocol.reply_error(
                f"the request deadline of {deadline_ms} ms elapsed before "
                "recording could start; the microphone was not opened.",
                protocol.ERR_DEADLINE)
        turn.thread = threading.Thread(
            target=self._run_dictation, args=(turn,),
            name=f"kilix-voice-{turn.id}", daemon=True)
        # P11, as speak does it: hooked before the worker can settle, and
        # recorded as begun only once the worker is really running.
        ledger = self._jobs
        if ledger is not None:
            turn.on_settle = ledger.record   # before the worker can settle
        try:
            with self._lock:
                # Taking the microphone cancels read-aloud on the way in.
                self._arbiter.begin_listen(turn.id)
                self._dictation = turn
                self._start(turn.thread, lambda: self._clear_dictation(turn))
                if ledger is not None:
                    ledger.begin(turn.id, jobs.KIND_DICTATION)
        except BaseException:
            receiver.close()
            raise
        return protocol.reply_ok(request["id"], turn=turn.id)

    def _start(self, thread: threading.Thread,
               undo: Callable[[], None]) -> None:
        """Start a turn's thread, giving the claim back if the OS refuses one.

        The claim is recorded before the thread runs, and only that thread's
        own exit path ever releases it — so a thread that never started would
        leave the session speaking or listening for ever, which also stops the
        idle timer from ever firing.
        """
        try:
            thread.start()
        except RuntimeError as error:
            undo()
            raise DaemonUnavailable(
                f"cannot start a voice worker thread: {error}. This machine "
                "is out of threads or memory; close some processes and try "
                "again.") from error

    def _clear_dictation(self, turn: _DictationTurn) -> None:
        """Give the microphone back if ``turn`` still holds it."""
        with self._lock:
            if self._dictation is turn:
                self._dictation = None
        self._arbiter.end_listen(turn.id)

    def _op_stop_dictation(self, request: dict) -> dict:
        # P09: `finish` (the default) ends recording and delivers the words so
        # far; `abort` ends it and discards them. The mode is echoed, so a
        # client can tell a daemon that honoured it from one that ignored it.
        mode = request.get("mode", protocol.STOP_MODE_FINISH)
        with self._lock:
            turn = self._dictation
        if turn is None:
            return protocol.reply_ok(request["id"], stopped=False, mode=mode)
        # TERM-04: wait -- bounded, and NOT holding self._lock -- for a feed
        # already in progress, so that once this replies quiesced no feed
        # begins and no partial is sent for the turn. quiesced false means a
        # feed was still running; _record suppresses its partial because the
        # stop is set before that feed's result is looked at.
        acquired = turn.progress_lock.acquire(timeout=STOP_QUIESCE_TIMEOUT_S)
        try:
            # Decided once, under the settle lock. Either this job's one
            # terminal was already decided -- its final delivered, say, while
            # the turn still tears down its recorder and recogniser -- and the
            # stop changes nothing, so the reply says it stopped nothing (V15
            # arm C's late stop, and an abort after the final). Or the stop and
            # the abort are in place before any final can settle, and that
            # final then refuses itself.
            with turn._settle_lock:
                if turn.outcome is not None:
                    return protocol.reply_ok(request["id"], stopped=False, mode=mode)
                if mode == protocol.STOP_MODE_ABORT:
                    # Before the stop: whatever sees the stop sees the abort too.
                    turn.abort = True
                turn.stop.set()
        finally:
            if acquired:
                turn.progress_lock.release()
        return protocol.reply_ok(request["id"], stopped=True,
                                 quiesced=acquired, mode=mode)

    def _run_dictation(self, turn: _DictationTurn) -> None:
        """Record one turn, stream partials, and deliver the final text."""
        try:
            self._dictate(turn)
        # F08: these arms exist because the broad one below flattened every
        # distinguishable failure into `unavailable`. A caller could not tell a
        # payload too large from a missing microphone, and the vocabulary
        # already had the codes. Order matters: MessageTooLarge is a
        # ProtocolError and therefore a ValueError, so it must be caught before
        # the tuple that contains ValueError, or it never reaches here.
        except protocol.MessageTooLarge as error:
            self._deliver_terminal(turn, protocol.dictation_error(
                str(error), protocol.ERR_TOO_LARGE))
        except DeadlineExceeded as error:
            self._deliver_terminal(turn, protocol.dictation_error(
                f"dictation stopped: {error}.", protocol.ERR_DEADLINE))
        except Cancelled as error:
            self._deliver_terminal(turn, protocol.dictation_error(
                f"dictation stopped: {error}.", protocol.ERR_CANCELLED))
        except (DaemonError, audio.AudioError, stt_lib.SttError,
                settings.SettingsError, paths.PathError, OSError,
                ValueError, accelerator.AcceleratorRefused) as error:
            # A refusal that knows its own code keeps it. Everything else is
            # still `unavailable`, which R4 confirmed is the right default.
            #
            # SettingsError joined this tuple with R6 finding 3: the control
            # path codes an unreadable settings file `unavailable`, and _record
            # reads settings on every turn, so leaving it out here coded the
            # same condition `internal` on this path.
            #
            # R5 finding B: the carried code MUST be validated here. This arm
            # catches OSError and ValueError -- large families -- and
            # dictation_error refuses a code outside the closed vocabulary by
            # raising ProtocolError. Raised inside this except arm, that is not
            # caught by the sibling `except Exception`, so the caller would
            # receive NO datagram at all: strictly worse than the flattening
            # this replaced. _carried_code is that validation, shared with the
            # control path so the two cannot code one family differently.
            self._deliver_terminal(turn, protocol.dictation_error(
                str(error), _carried_code(error, protocol.ERR_UNAVAILABLE)))
        except Exception as error:  # a worker thread must not die silently
            self._warn(f"dictation failed: {error!r}")
            # F08: this arm called dictation_error with NO code at all, so an
            # unexpected worker failure was indistinguishable from a
            # well-understood one at the protocol level.
            self._deliver_terminal(turn, protocol.dictation_error(
                f"dictation failed unexpectedly: {error}. Try again; the "
                "daemon's stderr has the details.", protocol.ERR_INTERNAL))
        finally:
            if turn.outcome is None:
                # No terminal was delivered: a worker that returned without
                # one, or a delivery that itself raised. The job still ends,
                # recorded failed, and nothing is sent -- a datagram now could
                # follow one already on its way.
                try:
                    turn.settle(jobs.JobOutcome(
                        job=turn.id, kind=jobs.KIND_DICTATION,
                        outcome=jobs.OUTCOME_FAILED, code=protocol.ERR_INTERNAL,
                        message="dictation ended without a terminal result."))
                except Exception as error:
                    self._warn(f"could not settle turn {turn.id} "
                               f"({type(error).__name__})")
            turn.receiver.close()
            self._clear_dictation(turn)
            self._touch()

    def _deliver_terminal(self, turn: _DictationTurn, message: dict) -> bool:
        """Send a dictation job's one terminal datagram and settle its outcome.

        The only way a dictation terminal leaves the daemon. The outcome is
        settled FIRST, first-writer-wins, so a second terminal is refused by
        structure -- not, as before, by there happening to be no code that can
        raise after the final. The job id rides as `segment` on every
        terminal, error included: a SOCK_DGRAM receiver has no end of stream
        to join a failure on. The frame is encoded before anything is
        settled, so a final too large to send is refused by its own too-large
        terminal instead of being settled undelivered. Recognised text never
        enters the ledger: a final settles with no message.
        """
        if not isinstance(message, dict) or not (
                "final" in message or "error" in message or "code" in message):
            message = {"error": _NOT_A_TERMINAL, "code": protocol.ERR_INTERNAL}
        # SEND-01: guarded before it settles, by the function _transmit uses,
        # so the job settles with the code that crosses the wire.
        message = _guard_message(message)
        if "error" in message and "segment" not in message:
            message = dict(message, segment=turn.id)
        if "final" in message:
            # Only a transcript is refused for its size here. An error always
            # has a frame (_message_frame), so it is never refused after it
            # settles.
            protocol.encode(message, limit=protocol.MAX_REPLY_BYTES)
        code = message.get("code")
        if "final" in message:
            outcome, code, prose = jobs.OUTCOME_COMPLETED, None, ""
        elif code == protocol.ERR_CANCELLED:
            outcome, prose = jobs.OUTCOME_CANCELLED, message["error"]
        elif code == protocol.ERR_DEADLINE:
            outcome, prose = jobs.OUTCOME_DEADLINE, message["error"]
        else:
            outcome, prose = jobs.OUTCOME_FAILED, message["error"]
        # A final settles only if, at that instant and under the lock
        # stop-dictation decides under, no abort has won and the budget is not
        # spent. The boundary checks before this leave a gap an abort can land
        # in; this closes it, and the refusal becomes the job's terminal.
        precondition = ((lambda: self._check_delivery(
            turn, "before the transcript was delivered"))
            if "final" in message else None)
        if not turn.settle(jobs.JobOutcome(job=turn.id, kind=jobs.KIND_DICTATION,
                                           outcome=outcome, code=code,
                                           message=prose), precondition):
            self._warn(f"dictation {turn.id}: a second terminal was suppressed")
            return False
        delivered = self._send(turn.receiver, message)
        if self._jobs is not None:
            self._jobs.mark_delivered(turn.id, delivered)
        return delivered

    def _dictate(self, turn: _DictationTurn) -> None:
        """Run one whole turn: capture, recognise, deliver."""
        # F03: ONE resolved identity for this turn. The consent check and the
        # recogniser are handed the same frozen object, so the configuration
        # the user consented to is provably the configuration that opens the
        # microphone. Previously each resolved its own and nothing compared
        # them.
        resolved = stt_lib.resolve_stt(self._cfg)
        # F02: preparation used to run with no reference to the caller's
        # budget or to stop-dictation at all, so a stop arriving during
        # preparation did not prevent the microphone opening.
        turn.stop.check()
        self._require_capture_consent(resolved)
        turn.stop.check()
        # S04 (LEASE-02): an engine on an accelerator runs only under a grant
        # from the one lease home, waited for here, before the engine is
        # built, with this turn's id, budget and stop. A CPU engine -- every
        # engine shipped today -- acquires nothing. A refusal carries its
        # closed code to the dictation-error arm like any other.
        with accelerator.execution(
                device_class=resolved.device_class, task=resolved.task,
                job_id=turn.id, deadline_monotonic=turn.deadline, token=turn.stop,
                peer_gone=self._stopping.is_set,
                progress=lambda state: self._debug(
                    f"{turn.id}: waiting for the accelerator ({state['state']}, "
                    f"position {state['position']})"),
                device_label=str(util.cfg_get(self._cfg, accelerator.DEVICE_KEY, "") or "")
                ) as grant:
            self._record_turn(turn, resolved, grant)

    def _record_turn(self, turn: _DictationTurn, resolved: stt_lib.ResolvedStt,
                     grant: accelerator.ExecutionGrant | None) -> None:
        """Capture, recognise and deliver one turn, with the engine ``resolved`` names.

        ``grant`` is held around all of it for an accelerator engine, and is
        marked reaped only once the engine has closed.
        """
        capture = audio.MicCapture(self._cfg)
        engine = stt_lib.make_stt(self._cfg, capture.rate, resolved=resolved)
        try:
            # The last boundary before the device is opened. Everything above
            # can take real time -- a payload hash and a model load -- and a
            # stop or an expiry during it must still mean the mic stays shut.
            turn.stop.check()
            capture.start()
            engine.start_utterance()
            heard = self._record(turn, capture, engine)
            # Recording stopping because the budget ran out is not a completed
            # turn. Without this the caller gets a `final` transcript, or the
            # misleading "no audio arrived from the microphone", for a request
            # it had already given up on.
            self._check_delivery(turn, "while recording")
            # The microphone closes the moment the turn ends, before anything
            # is recognised or delivered: click-to-talk means the recorder is
            # not still running while the last words are being turned into
            # text. stop() is idempotent, so the guard below repeats it.
            capture.stop()
            # R6 finding 2: stopping the recorder is terminate plus join and
            # can take seconds. Checked BEFORE the overruns refusal, so a turn
            # whose budget ran out here says deadline rather than unavailable.
            self._check_delivery(turn, "while the recorder shut down")
            if capture.overruns:
                # A transcript assembled from audio the queue threw away is a
                # partial answer wearing a success reply -- the same thing A06
                # refuses rather than truncating. Say so instead of delivering
                # it silently.
                raise DaemonError(
                    f"dictation dropped {capture.overruns} frame(s) of audio "
                    "because the recogniser fell behind, so the transcript "
                    "would be missing words. Nothing was delivered. Try a "
                    "shorter turn, or a lighter model "
                    f"({settings.KEY_STT_MODEL}).")
            text = clean_for_injection(engine.end_utterance())
            # The delivery boundary: final decoding can outlast the budget
            # too. Checked BEFORE the no-audio refusal, so an expired turn that
            # heard nothing says deadline rather than "no audio arrived". What
            # remains between here and the send is in-process work measured
            # in microseconds, which is the accepted tolerance.
            self._check_delivery(turn, "before the transcript was ready")
            if not heard and not text:
                raise DaemonError(
                    "no audio arrived from the microphone. Check that one is "
                    "connected and that PulseAudio or PipeWire is running "
                    "(`pactl info`), or set KILIX_VOICE_DEVICE_IN to a source "
                    "listed by `pactl list sources short`.")
            # No trailing newline is added here or anywhere downstream:
            # dictation never presses Enter (DESIGN.md safety rule 2).
            # Same segment id as this turn's partials, marked stable: the
            # consumer replaces the running text rather than appending to it.
            self._deliver_terminal(turn, protocol.dictation_final(text, turn.id))
        finally:
            capture.stop()
            engine.close()
            if grant is not None:
                # Only after a close that did not raise: an engine whose
                # teardown failed leaves the accelerator quarantined.
                grant.reaped()

    @staticmethod
    def _check_delivery(turn: _DictationTurn, where: str) -> None:
        """Refuse delivery once the turn was aborted, or its budget ran out.

        P09: an abort discards the words, so no final may follow it. This runs
        at every step after recording, including straight after final
        decoding, so an abort that lands while the recorder shuts down or
        while the words are being decoded still delivers nothing.

        An abort counts only when its stop came before the deadline, which is
        what reason() == "cancelled" says. An abort pressed after the budget
        had already run out is still the deadline: the first-cause rule the
        stop token applies everywhere else. A staticmethod, as the budget
        check is, so a daemon built without __init__ can run it.
        """
        if turn.abort and turn.stop.reason() == "cancelled":
            raise Cancelled("the turn was aborted; nothing was transcribed")
        Daemon._raise_if_budget_spent(turn, where)

    @staticmethod
    def _raise_if_budget_spent(turn: _DictationTurn, where: str) -> None:
        """Refuse delivery once the caller's budget has run out, wherever.

        The question at every step after recording is "has the caller given
        up?", which is expired() -- not reason(): a stop pressed in time does
        not make a budget that has since run out any less spent, and nobody is
        waiting for the transcript any more.

        A staticmethod that reads only the turn, so a daemon built without
        __init__ can still run it.
        """
        if turn.stop.expired():
            raise DeadlineExceeded(f"the request deadline elapsed {where}")

    def _require_capture_consent(
            self, resolved: stt_lib.ResolvedStt | None = None) -> None:
        """Refuse to open the microphone without a matching consent record.

        S02/S03 reach production here. The digest binds the model and engine
        being used, so a changed model -- or a changed payload under the same
        model -- invalidates the grant instead of carrying it silently. The
        record is per-user and lives in the private XDG layout.

        Enforcement is opt-in via KILIX_VOICE_REQUIRE_CONSENT so that upgrading
        does not silently break every existing dictation caller. That default is
        a DEPLOYMENT decision and not a statement that the gate is optional:
        with it set, capture does not start without a grant.
        """
        # Default ON. Set KILIX_VOICE_REQUIRE_CONSENT=0 to disable, which is a
        # deliberate deployment choice rather than the absence of one.
        if os.environ.get("KILIX_VOICE_REQUIRE_CONSENT", "1") == "0":
            return
        # F03: this used to call settings.stt_model()/stt_engine() with no
        # settings path, while make_stt read stt.engine, stt.model,
        # stt.model_path and settings_path from the daemon's effective config.
        # Two independent resolutions meant the identity checked here need not
        # be the identity opened. The caller now resolves once and passes it.
        if resolved is None:
            resolved = stt_lib.resolve_stt(self._cfg)
        # The installed bytes, not just the model NAME: S03 is about the same
        # name over different bytes -- and the bytes in the directory the
        # recogniser will actually open, not the catalogue's guess at it.
        # stt_lib.consent_identity is the one function kilix-stt's grant also
        # uses, so grant and gate cannot hash different directories.
        try:
            identity = stt_lib.consent_identity(resolved)
            allowed = consent.granted("dictation", identity.digest)
        except consent.ConsentError as error:
            # R6 finding 6: R4 finding 3 was closed for ONE refusal this gate
            # makes, the absent grant. A record that cannot be read or does not
            # verify raises ConsentError, a ValueError, which the worker's
            # broad arm coded `unavailable` -- the "no microphone" code R4
            # finding 3 was about. Every refusal the gate produces is a consent
            # refusal, and the record's own remedy text is kept.
            raise ConsentDenied(
                f"dictation consent could not be verified: {error} The "
                "microphone was not opened.") from error
        if not allowed:
            # No silent auto-grant. A grant recorded without the user being
            # asked is not consent, whatever the file says afterwards. The
            # daemon has no terminal, so it refuses and names the command that
            # does ask.
            raise ConsentDenied(
                "dictation has no recorded consent for this configuration "
                f"(model {identity.model_id!r}, engine {identity.engine!r}, "
                f"directory {identity.model_dir!r}). The microphone was not "
                "opened. Grant it once with `kilix-stt --grant-consent`, run "
                f"with the same {stt_lib.ENV_MODEL} and {ENV_CONFIG} as the "
                "daemon; a change of model or of the installed payload asks "
                "again.")

    def _record(self, turn: _DictationTurn, capture: audio.MicCapture,
                engine: SttEngine) -> bool:
        """Feed the recogniser until the turn ends; True if audio arrived."""
        detector = Vad(self._cfg)
        max_seconds = float(util.cfg_get(self._cfg, "stt.max_seconds",
                                         settings.stt_max_seconds()))
        silence_s = float(util.cfg_get(self._cfg, "vad.silence_ms", 900)) / 1000
        # MicCapture.read() reports a timeout and an ended stream the same way,
        # so a stream that stops arriving for longer than the silence window
        # ends the turn: a recorder that exited, a fixture that ran out and a
        # device that wedged all mean the same thing to a listener.
        stall_s = silence_s + 1.0
        partials = engine.supports_partials
        # The max_seconds instant is the recording CEILING. It is not the
        # caller's deadline, which lives on turn.stop; calling both "deadline"
        # in one loop left them a single misreading away from being swapped.
        ceiling = time.monotonic() + max_seconds
        last_audio = time.monotonic()
        heard = False
        speaking = False
        # A06 on the CAPTURE side. The time limit above bounds a WELL-BEHAVED
        # stream; it does not bound bytes, and a device reporting an absurd
        # rate or width delivers far more than max_seconds implies. R2: "Capture
        # has no corresponding total byte counter/refusal; its queue can discard
        # old frames." Discarding old frames silently truncates what the user
        # said, which is the same wrong-answer-wearing-a-success this contract
        # refuses elsewhere -- so this counts and REFUSES rather than trimming.
        captured_bytes = 0
        dropped_frames = 0
        # R4 finding 1: this read is_set() only, so an accepted deadline_ms
        # bounded nothing here -- recording ran to max_seconds, VAD silence or
        # an explicit stop while the caller's budget had long since elapsed.
        # done() is "stopped OR expired".
        while not turn.stop.done() and not self._stopping.is_set():
            if time.monotonic() >= ceiling:
                self._debug(f"{turn.id}: hit the {max_seconds:.0f}s ceiling")
                break
            asked = time.monotonic()
            # R6 finding 5: the loop honoured the budget by rounding it. A
            # blocking read on a quiet microphone waited its full poll
            # interval past the deadline, so a 30 ms budget ended recording
            # after 200 ms. The read is clipped to the budget that is left.
            # Not budget(): that raises Cancelled on an explicit stop, and a
            # stop during recording means "finish now and deliver".
            left = turn.stop.remaining()
            read_timeout = (CAPTURE_POLL_S if left is None
                            else max(0.0, min(CAPTURE_POLL_S, left)))
            frame = capture.read(timeout=read_timeout)
            if frame is None:
                if capture.error:
                    raise DaemonError(capture.error)
                if time.monotonic() - last_audio > stall_s:
                    break
                # A read that returned no frame *and* took no time is an ended
                # stream rather than a timeout, and asking again immediately
                # would spin a core until the stall window closes. The wait
                # ends on a stop OR at the deadline: the deadline-blind
                # wait() slept a whole poll interval past an expiry.
                turn.stop.wait_done(max(0.0, CAPTURE_POLL_S
                                        - (time.monotonic() - asked)))
                continue
            last_audio = time.monotonic()
            heard = True
            # R3 F04: the counter sat DOWNSTREAM of a bounded queue that drops
            # the oldest frame when the consumer falls behind, so audio
            # discarded upstream was never counted at all. Account for it at the
            # producer by adding what the queue threw away.
            captured_bytes += len(frame) + (
                capture.overruns - dropped_frames) * capture.frame_bytes
            dropped_frames = capture.overruns
            protocol.check_audio_bytes(captured_bytes)
            # TERM-04: the stop check, the feed and the partial are one step
            # under the turn's progress lock, which stop-dictation takes before
            # it replies. A loop iteration already past its check used to feed
            # one more frame and deliver one more partial after the stop had
            # been answered. The read above stays outside the lock, so a stop
            # never waits on a quiet microphone.
            with turn.progress_lock:
                if turn.stop.done() or self._stopping.is_set():
                    break
                event = detector.feed(frame)
                text = engine.feed(frame)
                if turn.stop.done():
                    # A stop that gave up waiting landed during this feed: its
                    # partial is not delivered, and nothing more is fed.
                    break
                if partials and text is not None:
                    # Droppable: a receiver that is not reading loses progress,
                    # not the turn. One that has gone still ends it.
                    if not self._send(turn.receiver, _Outbound(protocol.dictation_partial(
                            clean_for_injection(text), turn.id), droppable=True)):
                        break
            if event == events.VAD_SPEECH_START:
                speaking = True
            elif event == events.VAD_SPEECH_END and speaking:
                break
        return heard

    def _send(self, receiver: socket.socket, message: dict) -> bool:
        """Send one datagram; False when the receiver has gone or cannot take it.

        Encoded against MAX_REPLY_BYTES, the size the kitty fork's receiver
        reads: a larger datagram would arrive truncated and fail to decode.
        MessageTooLarge propagates, so an over-size transcript is REFUSED with
        a too-large datagram by _run_dictation rather than cut short.
        Returning False instead would leave that caller with no terminal
        datagram at all. An error or terminal never raises here: it is guarded
        (SEND-01) and always has a frame.

        An _Outbound message may attach descriptors by SCM_RIGHTS, and may
        decline to wait. A non-blocking send to a receiver whose queue is full
        returns at once: False, or True for a droppable message, whose loss
        costs only progress. Descriptors are never closed here: the kernel
        holds its own reference once sendmsg returns, and the caller closes
        its copy.
        """
        guarded = _guard_message(message)
        frame = _message_frame(guarded)
        fds = tuple(getattr(guarded, "fds", ()))
        try:
            if not getattr(message, "nonblocking", False):
                _transmit(receiver, frame, fds, channel=_CHANNEL_MESSAGE)
                return True
            # MSG_DONTWAIT alone would not stop Python waiting: a socket with a
            # timeout polls for writability for that long before it sends. A
            # zero timeout makes the call itself non-blocking, and the
            # receiver's own timeout is restored straight after.
            previous = receiver.gettimeout()
            receiver.settimeout(0.0)
            try:
                _transmit(receiver, frame, fds, channel=_CHANNEL_MESSAGE)
            finally:
                receiver.settimeout(previous)
            return True
        except BlockingIOError:
            if getattr(message, "droppable", False):
                return True
            self._warn("a receiver is not reading; the message was not delivered")
            return False
        except OSError as error:
            # The message itself is never logged: it is what the user said.
            self._warn(f"the receiver stopped listening: {error}")
            return False

    # -- status -------------------------------------------------------------

    def _op_status(self, request: dict) -> dict:
        # R6 finding 4: validate_request keeps deadline_ms for every op, and
        # status read it nowhere -- the Piper probe ran to its own 5 s ceiling
        # and a 150 ms status answered ok after 3 s. The budget is taken
        # FIRST, before the settings refresh, exactly as speak and dictate do.
        deadline_ms = request.get("deadline_ms")
        deadline = (time.monotonic() + deadline_ms / 1000.0
                    if deadline_ms is not None else None)
        # P07/P11: a question about one job the daemon does not hold is
        # refused before any provider is probed on its behalf.
        job = request.get("job")
        if job is not None and (self._jobs is None or self._jobs.get(job) is None):
            return protocol.reply_error(
                f"no job {job} is known to this kilix-voiced. It keeps the "
                f"most recent {jobs.MAX_ENTRIES} jobs; ask with the 'turn' "
                "the job's own reply carried.", protocol.ERR_NOT_FOUND)
        self._refresh_config()
        try:
            tts_status = self._tts_status(deadline)
        except tts_lib.TtsDeadlineExceeded:
            # Refused, not reported as `available: false`: the caller's own
            # budget cut the check, and saying the provider is unavailable
            # would be the misattribution R6 finding 1 was about.
            return protocol.reply_error(
                f"the request deadline of {deadline_ms} ms elapsed while "
                "checking the speech provider; status is incomplete.",
                protocol.ERR_DEADLINE)
        now = time.monotonic()
        with self._lock:
            idle = now - self._last_activity
            speech_error = self._speech_error
            speech_error_serial = self._speech_error_serial
            speech_error_turn = self._speech_error_turn
        payload = {
            # `version` is the PACKAGE release and stays for the chrome that
            # shows it; `protocol` is the wire contract a client checks.
            "version": __version__,
            "protocol": protocol.protocol_identity(),
            "pid": os.getpid(),
            "session": self._session_dir,
            "socket": self._socket_path,
            "uptime": round(now - self._started_at, 1),
            "idle": round(idle, 1),
            "idle_limit": self._idle_seconds,
            "speaking": self._arbiter.speaking,
            "listening": self._arbiter.listening,
            "speech_error": speech_error,
            "speech_error_serial": speech_error_serial,
            # P11: the job behind that error, so the failure can be joined to
            # the request that caused it.
            "speech_error_turn": speech_error_turn,
            # The ledger's view: the most recent jobs, and the one asked for,
            # read now so a job that settled during the probes says so.
            **({"jobs": self._jobs.recent()} if self._jobs is not None else {}),
            **({"job": self._jobs.get(job)} if job is not None else {}),
            "chrome_speak": settings.enabled(settings.KEY_SPEAK),
            "chrome_dictate": settings.enabled(settings.KEY_DICTATE),
            "tts": tts_status,
            "stt": self._stt_status(),
            "capture": self._tool_status(audio.build_capture_cmd),
            "playback": self._tool_status(
                lambda cfg: audio.build_play_cmd(
                    cfg, tts_lib.ESPEAK_SAMPLE_RATE)),
        }
        if deadline is not None and time.monotonic() >= deadline:
            # The same delivery-boundary rule dictation follows: a status the
            # caller has already given up on is not answered as a success,
            # however it came to be late.
            return protocol.reply_error(
                f"the request deadline of {deadline_ms} ms elapsed before "
                "status was complete.", protocol.ERR_DEADLINE)
        return protocol.reply_ok(request["id"], status=payload)

    def _tts_status(self, deadline: float | None = None) -> dict:
        """Report read-aloud without launching anything.

        The Piper probe is the one step here that runs a process, so it gets
        the caller's remaining budget and raises TtsDeadlineExceeded when that
        budget -- not the provider -- is what stopped it.
        """
        engine = settings.tts_engine()
        if engine == "off":
            return {"engine": engine, "model": engine,
                    "available": False, "detail": (
                "read-aloud is switched off. Set "
                f"{settings.KEY_TTS_ENGINE}=espeak to enable it.")}
        if engine == models.TTS_ENGINE_PIPER:
            budget = None if deadline is None else deadline - time.monotonic()
            available, detail = tts_lib.piper_probe(budget=budget)
            return {
                "engine": engine,
                "model": models.PIPER_KRISTIN_MODEL,
                "available": available,
                "voice": tts_lib.PIPER_VOICE,
                "detail": detail,
            }
        voice = settings.tts_voice()
        try:
            command = tts_lib.build_synth_cmd(self._cfg, voice=voice,
                                              rate=settings.tts_rate())
        except tts_lib.TtsError as error:
            return {"engine": engine, "model": engine,
                    "available": False, "voice": voice,
                    "detail": str(error)}
        detail = command[0]
        if engine == "mbrola":
            # The voice the tier really runs: en-us is a language, and there
            # is no mb-en-us.
            detail += f"; {tts_lib.mbrola_selection_detail(voice)}"
        return {"engine": engine, "model": engine, "available": True,
                "voice": voice, "detail": detail}

    def _stt_status(self) -> dict:
        """Report dictation without loading a model."""
        engine = settings.stt_engine()
        model_id = settings.stt_model()
        if engine == stt_lib.ENGINE_OFF:
            return {"engine": engine, "model": model_id, "available": False,
                    "detail": ("dictation is switched off. Set "
                               f"{settings.KEY_STT_ENGINE}="
                               f"{stt_lib.ENGINE_VOSK} to enable it.")}
        if engine == stt_lib.ENGINE_VIBEVOICE:
            return {"engine": engine, "model": model_id, "available": False,
                    "detail": (f"{settings.KEY_STT_ENGINE}="
                               f"{stt_lib.ENGINE_VIBEVOICE} is not implemented "
                               "in this release; it arrives in a later phase. "
                               f"Set it to {stt_lib.ENGINE_VOSK} for local "
                               "recognition now.")}
        library = os.environ.get(stt_lib.ENV_LIBRARY) or paths.libvosk_path()
        if os.path.isdir(library):
            library = os.path.join(library, stt_lib.LIBRARY_BASENAME)
        model = os.environ.get(stt_lib.ENV_MODEL)
        if not model:
            try:
                model = paths.model_dir(model_id)
            except paths.PathError as error:
                return {"engine": engine, "model": model_id,
                        "available": False, "detail": str(error)}
        missing = []
        if not os.path.isfile(library):
            missing.append(f"the vosk library is not at {library}")
        if not os.path.isdir(model):
            missing.append(f"the {model_id} model is not at {model}")
        status = {"engine": engine, "model": model_id, "library": library,
                  "model_path": model, "available": not missing}
        status["detail"] = (
            f"{'; '.join(missing)}. Install them with Kilix's pinned voice "
            f"installer, or set {stt_lib.ENV_LIBRARY} / {stt_lib.ENV_MODEL} to "
            "copies you already have. Read-aloud does not need them."
            if missing else "the library and the model are both present")
        return status

    def _tool_status(self, build: Callable[[dict], list[str]]) -> dict:
        """Report whether a capture or playback tool could be run."""
        try:
            command = build(self._cfg)
        except audio.AudioError as error:
            return {"available": False, "detail": str(error)}
        return {"available": True, "detail": " ".join(command)}


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="kilix-voiced",
        description="Own the microphone and the speakers for one Kilix voice "
                    "session.")
    parser.add_argument(
        "--config", metavar="PATH", default=os.environ.get(ENV_CONFIG) or None,
        help="JSON overrides layered over the shared Kilix settings "
             f"(default: ${ENV_CONFIG}).")
    parser.add_argument(
        "--idle-seconds", type=float, metavar="N", default=None,
        help=f"exit after N seconds with nothing in flight (default "
             f"{IDLE_SECONDS:.0f}; 0 keeps the daemon running).")
    parser.add_argument("--verbose", action="store_true",
                        help="log lifecycle events to stderr.")
    parser.add_argument("--version", action="version",
                        version=f"kilix-voiced {__version__}")
    args = parser.parse_args(argv)
    try:
        daemon = Daemon(config_path=args.config,
                        idle_seconds=args.idle_seconds, verbose=args.verbose)
        return daemon.run()
    except (DaemonError, ArbiterError, audio.AudioError,
            settings.SettingsError, paths.PathError) as error:
        print(f"kilix-voiced: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
