#!/usr/bin/make -f
# make install copies the three commands and voicelib under PREFIX.
# The package uses /usr. A developer install still defaults to a home directory.

%:
	dh $@

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_install:
	$(MAKE) install PREFIX=$(CURDIR)/debian/kilix-voice/usr
